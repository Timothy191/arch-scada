[Unit]
Description=Arch SCADA Desktop HMI (Avalonia Operator Workstation Shell)
Documentation=https://github.com/Timothy191/arch-scada
After=graphical.target network-online.target archscada-server.service
Wants=network-online.target archscada-server.service

[Service]
Type=simple
User=archscada-operator
Group=archscada
WorkingDirectory=/opt/archscada/ArchScada.Desktop
ExecStart=/usr/bin/dotnet /opt/archscada/ArchScada.Desktop/ArchScada.Desktop.dll
Restart=always
RestartSec=3
TimeoutStopSec=15
KillSignal=SIGTERM
SyslogIdentifier=archscada-desktop

# Graphical Session & Runtime Environment
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/archscada-operator/.Xauthority
Environment=XDG_RUNTIME_DIR=/run/user/1001
Environment=DOTNET_ENVIRONMENT=Production
Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1
Environment=ARCHSCADA_CONTROL_MODE=READ_ONLY
Environment=ARCHSCADA_CONFIG_DIR=/etc/archscada/desktop
Environment=ARCHSCADA_CACHE_DIR=/var/lib/archscada/cache
Environment=ARCHSCADA_LOG_DIR=/var/log/archscada

# Hardening & Safety Isolation
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
ReadWritePaths=/var/lib/archscada/cache /var/log/archscada
ReadOnlyPaths=/etc/archscada /opt/archscada

[Install]
WantedBy=graphical.target
