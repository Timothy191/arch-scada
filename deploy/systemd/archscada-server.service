[Unit]
Description=Arch SCADA Server (Core Archive, Alarm & Control Boundary Engine)
Documentation=https://github.com/Timothy191/arch-scada
After=network-online.target postgresql.service
Wants=network-online.target postgresql.service

[Service]
Type=simple
User=archscada
Group=archscada
WorkingDirectory=/opt/archscada/ScadaServer
ExecStart=/usr/bin/dotnet /opt/archscada/ScadaServer/ScadaServerWkr.dll
Restart=always
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGINT
SyslogIdentifier=archscada-server

# Environment
Environment=DOTNET_ENVIRONMENT=Production
Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1
Environment=ARCHSCADA_CONTROL_MODE=READ_ONLY
Environment=ARCHSCADA_CONFIG_DIR=/etc/archscada/server
Environment=ARCHSCADA_DATA_DIR=/var/lib/archscada
Environment=ARCHSCADA_LOG_DIR=/var/log/archscada

# Hardening & Safety Isolation
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
ReadWritePaths=/var/lib/archscada /var/log/archscada
ReadOnlyPaths=/etc/archscada /opt/archscada
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
