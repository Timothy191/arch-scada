[Unit]
Description=Arch SCADA Desktop HMI (User-Space Avalonia Operator Workstation)
Documentation=https://github.com/Timothy191/arch-scada
PartOf=graphical-session.target
After=graphical-session.target network-online.target archscada-plc-sim.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/archscada
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
KillSignal=SIGTERM
SyslogIdentifier=archscada-desktop
Environment=DOTNET_ENVIRONMENT=Production
Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1
Environment=ARCHSCADA_CONTROL_MODE=READ_ONLY

[Install]
WantedBy=graphical-session.target
