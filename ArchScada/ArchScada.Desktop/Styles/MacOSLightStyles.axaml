<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ISA-101 Industrial Control-Room Matte Black & Golden Theme Palette -->
    <!-- Surfaces: Shell #0A0A0B | Inset Panel #111113 | Card #16161A | Border #27272A -->
    <!-- Accents : Gold #F59E0B | Deep Gold #D97706 | Text #FAFAFA / #E4E4E7 / #A1A1AA -->

    <Style Selector="Window">
        <Setter Property="Background" Value="#0A0A0B" />
        <Setter Property="Foreground" Value="#FAFAFA" />
    </Style>

    <Style Selector="Border.scada-card">
        <Setter Property="Background" Value="#16161A" />
        <Setter Property="BorderBrush" Value="#27272A" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style Selector="Border.scada-panel">
        <Setter Property="Background" Value="#111113" />
        <Setter Property="BorderBrush" Value="#27272A" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12" />
    </Style>

    <Style Selector="Border.safety-pill">
        <Setter Property="Background" Value="#241C0B" />
        <Setter Property="BorderBrush" Value="#D97706" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="10,4" />
    </Style>

    <Style Selector="TextBlock.section-title">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="#FAFAFA" />
    </Style>

    <Style Selector="TextBlock.card-label">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="#A1A1AA" />
    </Style>

    <Style Selector="TextBlock.kpi-value">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="#FBBF24" />
    </Style>

    <Style Selector="Button.nav-item">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="#E4E4E7" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style Selector="Button.nav-item:pointerover">
        <Setter Property="Background" Value="#1F1C14" />
        <Setter Property="Foreground" Value="#FBBF24" />
    </Style>

    <Style Selector="Button.primary-action">
        <Setter Property="Background" Value="#D97706" />
        <Setter Property="BorderBrush" Value="#F59E0B" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="#0A0A0B" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Padding" Value="18,10" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <Style Selector="Button.primary-action:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#F59E0B" />
    </Style>

    <Style Selector="Button.secondary-action">
        <Setter Property="Background" Value="#1C1C21" />
        <Setter Property="BorderBrush" Value="#3F341D" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="#FBBF24" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <Style Selector="Button.secondary-action:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#292315" />
    </Style>

    <Style Selector="Separator">
        <Setter Property="Background" Value="#27272A" />
        <Setter Property="Height" Value="1" />
    </Style>

    <Style Selector="Border.divider">
        <Setter Property="Background" Value="#27272A" />
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="0,8" />
    </Style>

    <Style Selector="TextBox">
        <Setter Property="Background" Value="#111113" />
        <Setter Property="BorderBrush" Value="#3F341D" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="#FAFAFA" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style Selector="TextBox:focus">
        <Setter Property="BorderBrush" Value="#F59E0B" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>

    <Style Selector="ScrollViewer">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="ProgressBar">
        <Setter Property="Foreground" Value="#F59E0B" />
        <Setter Property="Background" Value="#27272A" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Height" Value="6" />
        <Setter Property="CornerRadius" Value="3" />
    </Style>

    <Style Selector="TabItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="#A1A1AA" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <Style Selector="TabItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#1C1C21" />
    </Style>

    <Style Selector="TabItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="#261E0D" />
        <Setter Property="Foreground" Value="#F59E0B" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="ListBoxItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="#E4E4E7" />
        <Setter Property="Padding" Value="10,6" />
    </Style>

    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#1C1C21" />
    </Style>

    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="#29200E" />
        <Setter Property="Foreground" Value="#FBBF24" />
    </Style>

    <Style Selector="ComboBox">
        <Setter Property="Background" Value="#111113" />
        <Setter Property="BorderBrush" Value="#3F341D" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="#FAFAFA" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>

    <!-- Matte Black & Gold splash window chrome -->
    <Style Selector="Border.splash-window-border">
        <Setter Property="Background" Value="#0A0A0B" />
        <Setter Property="BorderBrush" Value="#D97706" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="CornerRadius" Value="24" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style Selector="Border.splash-card">
        <Setter Property="Background" Value="#111113" />
        <Setter Property="BorderBrush" Value="#27272A" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="Padding" Value="36" />
    </Style>

    <!-- ================= Splash Screen Animations ================= -->

    <!-- Brand badge: gentle breathing pulse (scale 1.0 -> 1.08 -> 1.0) -->
    <Style Selector="Border.splash-brand-badge">
        <Setter Property="ClipToBounds" Value="False" />
        <Style.Animations>
            <Animation Duration="0:0:2.4" IterationCount="Infinite"
                       Easing="SineEaseInOut">
                <KeyFrame Cue="0.0">
                    <Setter Property="ScaleTransform.ScaleX" Value="1.0" />
                    <Setter Property="ScaleTransform.ScaleY" Value="1.0" />
                </KeyFrame>
                <KeyFrame Cue="0.5">
                    <Setter Property="ScaleTransform.ScaleX" Value="1.08" />
                    <Setter Property="ScaleTransform.ScaleY" Value="1.08" />
                </KeyFrame>
                <KeyFrame Cue="1.0">
                    <Setter Property="ScaleTransform.ScaleX" Value="1.0" />
                    <Setter Property="ScaleTransform.ScaleY" Value="1.0" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- Core glow dot: opacity shimmer while the gate is live -->
    <Style Selector="Ellipse.splash-core-dot">
        <Style.Animations>
            <Animation Duration="0:0:1.6" IterationCount="Infinite"
                       Easing="SineEaseInOut">
                <KeyFrame Cue="0.0">
                    <Setter Property="Opacity" Value="0.55" />
                </KeyFrame>
                <KeyFrame Cue="0.5">
                    <Setter Property="Opacity" Value="1.0" />
                </KeyFrame>
                <KeyFrame Cue="1.0">
                    <Setter Property="Opacity" Value="0.55" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- Indeterminate processing arc: continuous rotation, visible only while running -->
    <Style Selector="Arc.splash-processing-arc">
        <Setter Property="IsVisible" Value="False" />
        <Style.Animations>
            <Animation Duration="0:0:1.1" IterationCount="Infinite"
                       Easing="LinearEasing">
                <KeyFrame Cue="0.0">
                    <Setter Property="RotateTransform.Angle" Value="0" />
                </KeyFrame>
                <KeyFrame Cue="1.0">
                    <Setter Property="RotateTransform.Angle" Value="360" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- Slow ambient spin for the brand badge outer ring (hidden under reduced motion) -->
    <Style Selector="Arc.splash-brand-ring">
        <Style.Animations>
            <Animation Duration="0:0:9.0" IterationCount="Infinite"
                       Easing="LinearEasing">
                <KeyFrame Cue="0.0">
                    <Setter Property="RotateTransform.Angle" Value="0" />
                </KeyFrame>
                <KeyFrame Cue="1.0">
                    <Setter Property="RotateTransform.Angle" Value="360" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- Smoothly ease the progress fill width as checks complete -->
    <Style Selector="Border.splash-progress-fill">
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Width" Duration="0:0:0.45"
                                  Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
    </Style>

    <!-- Fade newly-revealed check rows in as they resolve -->
    <Style Selector="Border.splash-check-row">
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.35"
                                  Easing="SineEaseIn" />
            </Transitions>
        </Setter>
    </Style>

    <!-- Status dot: brief success pulse when the readiness gate resolves -->
    <Style Selector="Ellipse.splash-status-dot">
        <Style.Animations>
            <Animation Duration="0:0:0.6" IterationCount="1"
                       Easing="SineEaseOut">
                <KeyFrame Cue="0.0">
                    <Setter Property="ScaleTransform.ScaleX" Value="1.0" />
                    <Setter Property="ScaleTransform.ScaleY" Value="1.0" />
                </KeyFrame>
                <KeyFrame Cue="0.5">
                    <Setter Property="ScaleTransform.ScaleX" Value="1.6" />
                    <Setter Property="ScaleTransform.ScaleY" Value="1.6" />
                </KeyFrame>
                <KeyFrame Cue="1.0">
                    <Setter Property="ScaleTransform.ScaleX" Value="1.0" />
                    <Setter Property="ScaleTransform.ScaleY" Value="1.0" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- Launch button: subtle attention pulse once the gate is ready -->
    <Style Selector="Button.splash-launch-ready">
        <Style.Animations>
            <Animation Duration="0:0:1.8" IterationCount="Infinite"
                       Easing="SineEaseInOut">
                <KeyFrame Cue="0.0">
                    <Setter Property="Opacity" Value="1.0" />
                </KeyFrame>
                <KeyFrame Cue="0.5">
                    <Setter Property="Opacity" Value="0.78" />
                </KeyFrame>
                <KeyFrame Cue="1.0">
                    <Setter Property="Opacity" Value="1.0" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- Respect the OS reduced-motion preference: disable looping animations -->
    <Style Selector="Window.splash-reduced-motion Border.splash-brand-badge">
        <Style.Animations>
            <Animation Duration="0:0:0.01" IterationCount="1">
                <KeyFrame Cue="0.0">
                    <Setter Property="ScaleTransform.ScaleX" Value="1.0" />
                    <Setter Property="ScaleTransform.ScaleY" Value="1.0" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="Window.splash-reduced-motion Arc.splash-processing-arc, Window.splash-reduced-motion Arc.splash-brand-ring">
        <Style.Animations>
            <Animation Duration="0:0:0.01" IterationCount="1">
                <KeyFrame Cue="0.0">
                    <Setter Property="RotateTransform.Angle" Value="0" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="Window.splash-reduced-motion Ellipse.splash-core-dot, Window.splash-reduced-motion Ellipse.splash-status-dot, Window.splash-reduced-motion Button.splash-launch-ready">
        <Style.Animations>
            <Animation Duration="0:0:0.01" IterationCount="1">
                <KeyFrame Cue="0.0">
                    <Setter Property="Opacity" Value="1.0" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

</Styles>
