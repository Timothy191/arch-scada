<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ISA-101 Industrial Control-Room Dark Theme Palette -->
    <!-- Surfaces: Shell #080D18 | Inset Panel #0B1220 | Card #111A2E | Border #1E293B -->
    <!-- Accents : Cyan #38BDF8 | Cobalt #0284C7 | Text #F1F5F9 / #CBD5E1 / #94A3B8 -->

    <Style Selector="Window">
        <Setter Property="Background" Value="#080D18" />
        <Setter Property="Foreground" Value="#F1F5F9" />
    </Style>

    <Style Selector="Border.scada-card">
        <Setter Property="Background" Value="#111A2E" />
        <Setter Property="BorderBrush" Value="#1E293B" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style Selector="Border.scada-panel">
        <Setter Property="Background" Value="#0B1220" />
        <Setter Property="BorderBrush" Value="#1E293B" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12" />
    </Style>

    <Style Selector="Border.safety-pill">
        <Setter Property="Background" Value="#0C2540" />
        <Setter Property="BorderBrush" Value="#0284C7" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="10,4" />
    </Style>

    <Style Selector="TextBlock.section-title">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="#F1F5F9" />
    </Style>

    <Style Selector="TextBlock.card-label">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="#94A3B8" />
    </Style>

    <Style Selector="TextBlock.kpi-value">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="#F8FAFC" />
    </Style>

    <Style Selector="Button.nav-item">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="#CBD5E1" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style Selector="Button.nav-item:pointerover">
        <Setter Property="Background" Value="#152238" />
        <Setter Property="Foreground" Value="#F8FAFC" />
    </Style>

    <Style Selector="Button.primary-action">
        <Setter Property="Background" Value="#0284C7" />
        <Setter Property="BorderBrush" Value="#38BDF8" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="#F8FAFC" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="18,10" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <Style Selector="Button.primary-action:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#0369A1" />
    </Style>

    <Style Selector="Button.secondary-action">
        <Setter Property="Background" Value="#162238" />
        <Setter Property="BorderBrush" Value="#293B58" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="#E2E8F0" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <Style Selector="Button.secondary-action:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#1E2F4D" />
    </Style>

    <Style Selector="Separator">
        <Setter Property="Background" Value="#1E293B" />
        <Setter Property="Height" Value="1" />
    </Style>

    <Style Selector="Border.divider">
        <Setter Property="Background" Value="#1E293B" />
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="0,8" />
    </Style>

    <Style Selector="TextBox">
        <Setter Property="Background" Value="#0B1220" />
        <Setter Property="BorderBrush" Value="#263650" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="#F1F5F9" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style Selector="TextBox:focus">
        <Setter Property="BorderBrush" Value="#38BDF8" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>

    <Style Selector="ScrollViewer">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="ProgressBar">
        <Setter Property="Foreground" Value="#38BDF8" />
        <Setter Property="Background" Value="#1E293B" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Height" Value="6" />
        <Setter Property="CornerRadius" Value="3" />
    </Style>

    <Style Selector="TabItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="#94A3B8" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <Style Selector="TabItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#152238" />
    </Style>

    <Style Selector="TabItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="#1E293B" />
        <Setter Property="Foreground" Value="#38BDF8" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="ListBoxItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="#E2E8F0" />
        <Setter Property="Padding" Value="10,6" />
    </Style>

    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#152238" />
    </Style>

    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="#172A46" />
        <Setter Property="Foreground" Value="#38BDF8" />
    </Style>

    <Style Selector="ComboBox">
        <Setter Property="Background" Value="#0B1220" />
        <Setter Property="BorderBrush" Value="#263650" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="#F1F5F9" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>

    <!-- Dark control-room splash window chrome -->
    <Style Selector="Border.splash-window-border">
        <Setter Property="Background" Value="#080D18" />
        <Setter Property="BorderBrush" Value="#1E3A5F" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="CornerRadius" Value="24" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style Selector="Border.splash-card">
        <Setter Property="Background" Value="#0B1220" />
        <Setter Property="BorderBrush" Value="#1E293B" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="Padding" Value="36" />
    </Style>

</Styles>
