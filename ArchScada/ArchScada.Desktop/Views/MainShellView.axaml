<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ArchScada.Desktop.ViewModels"
             xmlns:models="using:ArchScada.Desktop.Models"
             xmlns:controls="using:ArchScada.Desktop.Controls"
             xmlns:threed="using:ArchScada.Desktop.Controls.ThreeD"
             xmlns:conv="using:ArchScada.Desktop.Converters"
             xmlns:scott="clr-namespace:ScottPlot.Avalonia;assembly=ScottPlot.Avalonia"
             x:Class="ArchScada.Desktop.Views.MainShellView"
             x:DataType="vm:MainShellViewModel">

    <Grid RowDefinitions="56,*,34" Background="#0A0A0B">

        <!-- TOP STATUS BAR (Matte Black & Golden Theme with Official Arch Linux Logo) -->
        <Border Grid.Row="0" Background="#111113" BorderBrush="#27272A" BorderThickness="0,0,0,1" Padding="16,0">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto" ColumnSpacing="14">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Image Source="avares://ArchScada.Desktop/Assets/archlinux-logo.png"
                           Width="28" Height="28" VerticalAlignment="Center" />
                    <Ellipse Width="9" Height="9" Fill="#22C55E" VerticalAlignment="Center" />
                    <TextBlock Text="ARCH SCADA" FontSize="14" FontWeight="Bold" Foreground="#F59E0B" LetterSpacing="1.5" VerticalAlignment="Center" />
                    <TextBlock Text="|" Foreground="#3F341D" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding CurrentSectionTitle}" FontSize="14" FontWeight="SemiBold" Foreground="#FAFAFA" VerticalAlignment="Center" />
                </StackPanel>

                <Border Grid.Column="2" Classes="safety-pill" VerticalAlignment="Center">
                    <TextBlock Text="READ-ONLY MODE (CONTROL DISABLED)" FontSize="11" FontWeight="Bold" Foreground="#FBBF24" />
                </Border>

                <Border Grid.Column="3" Classes="scada-panel" CornerRadius="6" Padding="10,4" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ConnectionStatusLabel}" FontSize="11" Foreground="#A1A1AA" />
                </Border>

                <Button Grid.Column="4"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="{x:Static models:PlantSection.AlarmsEvents}"
                        Background="#2A0F14"
                        BorderBrush="#EF4444"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="10,4"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse Width="8" Height="8" Fill="#EF4444" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding UnacknowledgedAlarmCount, StringFormat='Alarms: {0} Unack'}"
                                   FontSize="11" FontWeight="SemiBold" Foreground="#FCA5A5" />
                    </StackPanel>
                </Button>

                <TextBlock Grid.Column="5"
                           Text="{Binding CurrentTimeDisplay}"
                           FontSize="12"
                           Foreground="#A1A1AA"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- BODY: LEFT NAV + MAIN CONTENT -->
        <Grid Grid.Row="1" ColumnDefinitions="215,*">

            <!-- LEFT NAVIGATION RAIL -->
            <Border Grid.Column="0" Background="#111113" BorderBrush="#27272A" BorderThickness="0,0,1,0" Padding="8,10">
                <StackPanel Spacing="2">
                    <TextBlock Text="PLANT MONITORING" FontSize="10" FontWeight="Bold" Foreground="#71717A" Margin="10,2,0,4" />

                    <Button Content="Plant Overview" Classes="nav-item" Padding="12,8"
                            Background="{Binding IsOverview, Converter={x:Static conv:BoolToActiveNavBrushConverter.Instance}}"
                            Command="{Binding NavigateCommand}" CommandParameter="{x:Static models:PlantSection.Overview}" />

                    <Button Content="Crushing &amp; Conveyors" Classes="nav-item" Padding="12,8"
                            Background="{Binding IsCrushing, Converter={x:Static conv:BoolToActiveNavBrushConverter.Instance}}"
                            Command="{Binding NavigateCommand}" CommandParameter="{x:Static models:PlantSection.CrushingConveyors}" />

                    <Button Content="Thickener Circuit" Classes="nav-item" Padding="12,8"
                            Background="{Binding IsThickener, Converter={x:Static conv:BoolToActiveNavBrushConverter.Instance}}"
                            Command="{Binding NavigateCommand}" CommandParameter="{x:Static models:PlantSection.ThickenerCircuit}" />

                    <Button Content="Magnetite Preparation" Classes="nav-item" Padding="12,8"
                            Background="{Binding IsMagnetite, Converter={x:Static conv:BoolToActiveNavBrushConverter.Instance}}"
                            Command="{Binding NavigateCommand}" CommandParameter="{x:Static models:PlantSection.MagnetitePrep}" />

                    <Button Content="Fine Coal &amp; Flotation" Classes="nav-item" Padding="12,8"
                            Background="{Binding IsFineCoal, Converter={x:Static conv:BoolToActiveNavBrushConverter.Instance}}"
                            Command="{Binding NavigateCommand}" CommandParameter="{x:Static models:PlantSection.FineCoalFlotation}" />

                    <Button Content="Dewatering &amp; Tailings" Classes="nav-item" Padding="12,8"
                            Background="{Binding IsDewatering, Converter={x:Static conv:BoolToActiveNavBrushConverter.Instance}}"
                            Command="{Binding NavigateCommand}" CommandParameter="{x:Static models:PlantSection.DewateringTailings}" />

                    <Button Content="ROM, Loadout &amp; PGNAA" Classes="nav-item" Padding="12,8"
                            Background="{Binding IsRomLoadout, Converter={x:Static conv:BoolToActiveNavBrushConverter.Instance}}"
                            Command="{Binding NavigateCommand}" CommandParameter="{x:Static models:PlantSection.RomLoadoutQuality}" />

                    <TextBlock Text="3D &amp; VISUALS" FontSize="10" FontWeight="Bold" Foreground="#71717A" Margin="10,10,0,4" />

                    <Button Content="3D Digital Twin (Unity)" Classes="nav-item" Padding="12,8"
                            Background="{Binding IsDigitalTwin3D, Converter={x:Static conv:BoolToActiveNavBrushConverter.Instance}}"
                            Command="{Binding NavigateCommand}" CommandParameter="{x:Static models:PlantSection.DigitalTwin3D}" />

                    <TextBlock Text="OPERATIONS" FontSize="10" FontWeight="Bold" Foreground="#71717A" Margin="10,10,0,4" />

                    <Button Content="Equipment &amp; Assets" Classes="nav-item" Padding="12,8"
                            Background="{Binding IsEquipmentAssets, Converter={x:Static conv:BoolToActiveNavBrushConverter.Instance}}"
                            Command="{Binding NavigateCommand}" CommandParameter="{x:Static models:PlantSection.EquipmentAssets}" />

                    <Button Content="Trends &amp; Historian" Classes="nav-item" Padding="12,8"
                            Background="{Binding IsTrends, Converter={x:Static conv:BoolToActiveNavBrushConverter.Instance}}"
                            Command="{Binding NavigateCommand}" CommandParameter="{x:Static models:PlantSection.TrendsHistorian}" />

                    <Button Content="Alarms &amp; Events" Classes="nav-item" Padding="12,8"
                            Background="{Binding IsAlarms, Converter={x:Static conv:BoolToActiveNavBrushConverter.Instance}}"
                            Command="{Binding NavigateCommand}" CommandParameter="{x:Static models:PlantSection.AlarmsEvents}" />

                    <Button Content="System Diagnostics" Classes="nav-item" Padding="12,8"
                            Background="{Binding IsDiagnostics, Converter={x:Static conv:BoolToActiveNavBrushConverter.Instance}}"
                            Command="{Binding NavigateCommand}" CommandParameter="{x:Static models:PlantSection.Diagnostics}" />
                </StackPanel>
            </Border>

            <!-- MAIN CONTENT AREA (Scrollable Standard Views) -->
            <ScrollViewer Grid.Column="1" IsVisible="{Binding !IsDigitalTwin3D}" Padding="22">
                <Panel>

                    <!-- 1. PLANT OVERVIEW -->
                    <StackPanel IsVisible="{Binding IsOverview}" Spacing="18">
                        <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="14">
                            <Border Grid.Column="0" Classes="scada-card">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="PLANT FEED TONNAGE" Classes="card-label" />
                                    <TextBlock Text="{Binding TotalFeedTonnageTph, StringFormat='{}{0:0.0} t/h'}" Classes="kpi-value" />
                                    <TextBlock Text="CR-101 Primary Jaw Crusher" FontSize="11" Foreground="#22C55E" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Classes="scada-card">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="TOTAL POWER DRAW" Classes="card-label" />
                                    <TextBlock Text="{Binding TotalPowerDrawKw, StringFormat='{}{0:0.0} kW'}" Classes="kpi-value" />
                                    <TextBlock Text="Across 23 monitored assets" FontSize="11" Foreground="#A1A1AA" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Classes="scada-card">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="WATER RECOVERY" Classes="card-label" />
                                    <TextBlock Text="{Binding WaterRecoveryPercent, StringFormat='{}{0:0.0} %'}" Classes="kpi-value" />
                                    <TextBlock Text="TK-201 High-Rate Thickener" FontSize="11" Foreground="#F59E0B" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="3" Classes="scada-card">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="MEDIUM DENSITY" Classes="card-label" />
                                    <TextBlock Text="{Binding MediumSpecificGravity, StringFormat='{}{0:0.00} SG'}" Classes="kpi-value" />
                                    <TextBlock Text="TK-301 Magnetite Circuit" FontSize="11" Foreground="#F59E0B" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <TextBlock Text="Process Circuits (Live Telemetry-Driven Animated Schematics)" Classes="section-title" />
                        <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="14" RowSpacing="14">
                            <Border Grid.Row="0" Grid.Column="0" Classes="scada-card">
                                <StackPanel Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel>
                                            <TextBlock Text="Crushing &amp; Conveyors" FontSize="15" FontWeight="SemiBold" Foreground="#FAFAFA" />
                                            <TextBlock Text="BN-101, VF-101, CR-101, DRC-101, SC-102, DS-201, CV-101..302" FontSize="11" Foreground="#A1A1AA" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="3D ↗" Command="{Binding LocateIn3DCommand}" CommandParameter="JC-101" Classes="secondary-action" Padding="7,3" FontSize="10.5" VerticalAlignment="Top" />
                                    </Grid>
                                    <controls:ProcessCircuitIllustrationControl
                                        CircuitKind="{x:Static controls:ProcessCircuitKind.CrushingConveyors}"
                                        PrimaryValue="{Binding TotalFeedTonnageTph}"
                                        SecondaryValue="{Binding CrushingBeltSpeedMs}"
                                        TertiaryValue="{Binding CrushingLoadPercent}"
                                        CircuitStatus="{Binding CrushingCircuitStatus}"
                                        Height="116" />
                                    <Button Content="Open Circuit View (18 Assets &amp; 3D Previews)" Classes="secondary-action"
                                            Command="{Binding NavigateCommand}" CommandParameter="{x:Static models:PlantSection.CrushingConveyors}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="0" Grid.Column="1" Classes="scada-card">
                                <StackPanel Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel>
                                            <TextBlock Text="Thickener Circuit" FontSize="15" FontWeight="SemiBold" Foreground="#FAFAFA" />
                                            <TextBlock Text="TK-201, PP-201, PP-202, PP-203, PIPE-305..311" FontSize="11" Foreground="#A1A1AA" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="3D ↗" Command="{Binding LocateIn3DCommand}" CommandParameter="TK-201" Classes="secondary-action" Padding="7,3" FontSize="10.5" VerticalAlignment="Top" />
                                    </Grid>
                                    <controls:ProcessCircuitIllustrationControl
                                        CircuitKind="{x:Static controls:ProcessCircuitKind.ThickenerCircuit}"
                                        PrimaryValue="{Binding ThickenerBedLevelPercent}"
                                        SecondaryValue="{Binding WaterRecoveryPercent}"
                                        TertiaryValue="{Binding ThickenerUnderflowM3h}"
                                        CircuitStatus="{Binding ThickenerCircuitStatus}"
                                        Height="116" />
                                    <Button Content="Open Circuit View" Classes="secondary-action"
                                            Command="{Binding NavigateCommand}" CommandParameter="{x:Static models:PlantSection.ThickenerCircuit}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="0" Grid.Column="2" Classes="scada-card">
                                <StackPanel Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel>
                                            <TextBlock Text="Magnetite Preparation &amp; DMC-301" FontSize="15" FontWeight="SemiBold" Foreground="#FAFAFA" />
                                            <TextBlock Text="TK-301, MS-301, DM-301, DMC-301, PT-301, SC-301/302" FontSize="11" Foreground="#A1A1AA" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="3D ↗" Command="{Binding LocateIn3DCommand}" CommandParameter="DMC-301" Classes="secondary-action" Padding="7,3" FontSize="10.5" VerticalAlignment="Top" />
                                    </Grid>
                                    <controls:ProcessCircuitIllustrationControl
                                        CircuitKind="{x:Static controls:ProcessCircuitKind.MagnetitePrep}"
                                        PrimaryValue="{Binding MediumSpecificGravity}"
                                        SecondaryValue="{Binding DmcInletPressureKpa}"
                                        TertiaryValue="{Binding MacsepRecoveryPercent}"
                                        CircuitStatus="{Binding MagnetiteCircuitStatus}"
                                        Height="116" />
                                    <Button Content="Open Circuit View" Classes="secondary-action"
                                            Command="{Binding NavigateCommand}" CommandParameter="{x:Static models:PlantSection.MagnetitePrep}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="0" Classes="scada-card">
                                <StackPanel Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel>
                                            <TextBlock Text="Fine Coal &amp; Flotation" FontSize="15" FontWeight="SemiBold" Foreground="#FAFAFA" />
                                            <TextBlock Text="SP-401, FC-401, AB-401, PP-401, PP-402" FontSize="11" Foreground="#A1A1AA" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="3D ↗" Command="{Binding LocateIn3DCommand}" CommandParameter="WP-301" Classes="secondary-action" Padding="7,3" FontSize="10.5" VerticalAlignment="Top" />
                                    </Grid>
                                    <controls:ProcessCircuitIllustrationControl
                                        CircuitKind="{x:Static controls:ProcessCircuitKind.FineCoalFlotation}"
                                        PrimaryValue="{Binding FlotationPulpLevelPercent}"
                                        SecondaryValue="{Binding FlotationAirflowNm3h}"
                                        TertiaryValue="{Binding FlotationRecoveryPercent}"
                                        CircuitStatus="{Binding FlotationCircuitStatus}"
                                        Height="116" />
                                    <Button Content="Open Circuit View" Classes="secondary-action"
                                            Command="{Binding NavigateCommand}" CommandParameter="{x:Static models:PlantSection.FineCoalFlotation}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="1" Classes="scada-card">
                                <StackPanel Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel>
                                            <TextBlock Text="Dewatering &amp; Tailings" FontSize="15" FontWeight="SemiBold" Foreground="#FAFAFA" />
                                            <TextBlock Text="CF-501, FP-501, CV-501, SC-302, SP-302" FontSize="11" Foreground="#A1A1AA" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="3D ↗" Command="{Binding LocateIn3DCommand}" CommandParameter="SC-302" Classes="secondary-action" Padding="7,3" FontSize="10.5" VerticalAlignment="Top" />
                                    </Grid>
                                    <controls:ProcessCircuitIllustrationControl
                                        CircuitKind="{x:Static controls:ProcessCircuitKind.DewateringTailings}"
                                        PrimaryValue="{Binding CentrifugeMoisturePercent}"
                                        SecondaryValue="{Binding FilterPressPressureBar}"
                                        TertiaryValue="{Binding TailingsBeltSpeedMs}"
                                        CircuitStatus="{Binding DewateringCircuitStatus}"
                                        Height="116" />
                                    <Button Content="Open Circuit View" Classes="secondary-action"
                                            Command="{Binding NavigateCommand}" CommandParameter="{x:Static models:PlantSection.DewateringTailings}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="2" Classes="scada-card">
                                <StackPanel Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel>
                                            <TextBlock Text="ROM, Loadout &amp; PGNAA" FontSize="15" FontWeight="SemiBold" Foreground="#FAFAFA" />
                                            <TextBlock Text="SP-001, FEL-101, AF-001, SL-601, AN-601, LD-601" FontSize="11" Foreground="#A1A1AA" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="3D ↗" Command="{Binding LocateIn3DCommand}" CommandParameter="BN-101" Classes="secondary-action" Padding="7,3" FontSize="10.5" VerticalAlignment="Top" />
                                    </Grid>
                                    <controls:ProcessCircuitIllustrationControl
                                        CircuitKind="{x:Static controls:ProcessCircuitKind.RomLoadoutQuality}"
                                        PrimaryValue="{Binding ProductSiloLevelPercent}"
                                        SecondaryValue="{Binding PgnaaAshPercent}"
                                        TertiaryValue="{Binding TrainLoadoutRateTph}"
                                        CircuitStatus="{Binding RomLoadoutCircuitStatus}"
                                        Height="116" />
                                    <Button Content="Open Circuit View" Classes="secondary-action"
                                            Command="{Binding NavigateCommand}" CommandParameter="{x:Static models:PlantSection.RomLoadoutQuality}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- ACTIVE MICRO-OPTIMIZATION & EFFICIENCY -->
                        <Border Classes="scada-card">
                            <StackPanel Spacing="12">
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="14">
                                    <StackPanel>
                                        <TextBlock Text="Automated Closed-Loop Micro-Optimization (Read-Only / Simulated Trim)" FontSize="16" FontWeight="SemiBold" Foreground="#FAFAFA" />
                                        <TextBlock Text="Continuously monitors process setpoints (DMC SG, Thickener Turbidity, Flotation Dosing, Cake Moisture, Crusher Feed) and applies bounded micro-trims."
                                                   FontSize="12" Foreground="#A1A1AA" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" Content="Auto Micro-Trim Active" IsChecked="{Binding IsAutoOptimizationEnabled}" Foreground="#22C55E" VerticalAlignment="Center" />
                                    <Button Grid.Column="2" Content="Apply Trim Now" Command="{Binding StepMicroOptimizationCommand}" Classes="secondary-action" Padding="12,6" FontSize="11" VerticalAlignment="Center" />
                                </Grid>

                                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="12">
                                    <Border Grid.Column="0" Classes="scada-panel">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="PLANT EFFICIENCY SCORE" Classes="card-label" />
                                            <TextBlock Text="{Binding PlantEfficiencyScorePercent, StringFormat='{}{0:0.00} %'}" FontSize="20" FontWeight="Bold" Foreground="#22C55E" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Classes="scada-panel">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="CLEAN COAL YIELD" Classes="card-label" />
                                            <TextBlock Text="{Binding CleanCoalYieldPercent, StringFormat='{}{0:0.00} %'}" FontSize="20" FontWeight="Bold" Foreground="#F59E0B" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Classes="scada-panel">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="SPECIFIC ENERGY" Classes="card-label" />
                                            <TextBlock Text="{Binding SpecificEnergyKwhPerTon, StringFormat='{}{0:0.00} kWh/t'}" FontSize="20" FontWeight="Bold" Foreground="#FAFAFA" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="3" Classes="scada-panel">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="MICRO-TRIMS APPLIED" Classes="card-label" />
                                            <TextBlock Text="{Binding TotalMicroTrimsApplied}" FontSize="20" FontWeight="Bold" Foreground="#F59E0B" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <ItemsControl ItemsSource="{Binding OptimizationLog}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Classes="scada-panel" Margin="0,2">
                                                <Grid ColumnDefinitions="70,190,65,190,*,Auto" ColumnSpacing="10">
                                                    <TextBlock Grid.Column="0" Text="{Binding TimeDisplay}" FontSize="11" Foreground="#A1A1AA" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding LoopName}" FontSize="11" FontWeight="SemiBold" Foreground="#FAFAFA" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2" Text="{Binding EquipmentId}" FontSize="11" FontWeight="Bold" Foreground="#F59E0B" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="3" Text="{Binding ValueTransitionDisplay}" FontSize="11" Foreground="#A1A1AA" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="4" Text="{Binding EfficiencyGainSummary}" FontSize="11" Foreground="#22C55E" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="5" Text="{Binding AuditStatus}" FontSize="10" Foreground="#F59E0B" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Recent Alarms" Classes="section-title" />
                        <ItemsControl ItemsSource="{Binding Alarms}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Classes="scada-panel" Margin="0,3">
                                        <Grid ColumnDefinitions="12,80,75,140,*,Auto,Auto" ColumnSpacing="10">
                                            <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                                     Fill="{Binding Severity, Converter={x:Static conv:StatusToBrushConverter.Instance}}" />
                                            <TextBlock Grid.Column="1" Text="{Binding TimeDisplay}" FontSize="12" Foreground="#A1A1AA" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding EquipmentId}" FontSize="11" FontWeight="Bold" Foreground="#F59E0B" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="{Binding Area}" FontSize="12" Foreground="#A1A1AA" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="4" Text="{Binding Message}" FontSize="12" Foreground="#FAFAFA" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="5" Text="{Binding Severity}" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{Binding Severity, Converter={x:Static conv:StatusToBrushConverter.Instance}}" VerticalAlignment="Center" />
                                            <Button Grid.Column="6" Content="3D ↗"
                                                    Command="{Binding $parent[UserControl].((vm:MainShellViewModel)DataContext).LocateIn3DCommand}"
                                                    CommandParameter="{Binding EquipmentId}"
                                                    Classes="secondary-action" Padding="8,3" FontSize="10.5" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- 2. CRUSHING & CONVEYORS -->
                    <StackPanel IsVisible="{Binding IsCrushing}" Spacing="14">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <StackPanel>
                                <TextBlock Text="Crushing, Screening &amp; Conveyor Circuit (Stages 1–6 &amp; Wash Plant Conveyors)" Classes="section-title" />
                                <TextBlock Text="18 Monitored Assets (Crushers, Screens, Hoppers, Grizzly Feeder &amp; All 11 Conveyors) · Live Status Belt Animation &amp; 3D GLB Turntable Previews" FontSize="12" Foreground="#A1A1AA" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Open Full 3D Plant Twin ↗"
                                    Command="{Binding LocateIn3DCommand}" CommandParameter="JC-101"
                                    Classes="primary-action" Padding="12,6" FontSize="11" VerticalAlignment="Center" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding CrushingEquipment}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Classes="scada-card" Width="336" Margin="0,0,14,14">
                                        <StackPanel Spacing="8">
                                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Id}" FontSize="12" FontWeight="Bold" Foreground="#F59E0B" />
                                                    <TextBlock Text="{Binding Name}" FontSize="14.5" FontWeight="SemiBold" Foreground="#FAFAFA" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="3D ↗"
                                                        Command="{Binding $parent[UserControl].((vm:MainShellViewModel)DataContext).LocateIn3DCommand}"
                                                        CommandParameter="{Binding Id}"
                                                        Classes="secondary-action" Padding="7,3" FontSize="10.5" VerticalAlignment="Top" />
                                                <Border Grid.Column="2" Classes="scada-panel" CornerRadius="4" Padding="8,3" VerticalAlignment="Top">
                                                    <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="Bold"
                                                               Foreground="{Binding Status, Converter={x:Static conv:StatusToBrushConverter.Instance}}" />
                                                </Border>
                                            </Grid>
                                            <Grid ColumnDefinitions="*,*">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding PrimaryMetricLabel}" Classes="card-label" />
                                                    <TextBlock Text="{Binding PrimaryMetricDisplay}" FontSize="17" FontWeight="Bold" Foreground="#FAFAFA" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="Power Draw" Classes="card-label" />
                                                    <TextBlock Text="{Binding PowerKw, StringFormat='{}{0:0.0} kW'}" FontSize="17" FontWeight="Bold" Foreground="#A1A1AA" />
                                                </StackPanel>
                                            </Grid>
                                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding LoadPercent}" Height="6" Foreground="#F59E0B" />
                                            <TextBlock Text="{Binding LoadPercent, StringFormat='Load: {0:0.0}%'}" FontSize="11" Foreground="#A1A1AA" />

                                            <!-- Live Status-Driven Conveyor & Material Flow Animation -->
                                            <controls:ConveyorStatusAnimationControl
                                                EquipmentId="{Binding Id}"
                                                EquipmentType="{Binding Type}"
                                                Status="{Binding Status}"
                                                LoadPercent="{Binding LoadPercent}"
                                                BeltSpeed="{Binding PrimaryMetric}"
                                                PullCordOk="{Binding PullCordOk}"
                                                BeltAlignmentOk="{Binding BeltAlignmentOk}"
                                                BeltSlipOk="{Binding BeltSlipOk}"
                                                Height="48" />

                                            <controls:TrendChartControl Values="{Binding SparklineValues}" Height="38" />

                                            <Border IsVisible="{Binding HasConveyorSafety}" Classes="scada-panel" BorderBrush="#27272A" BorderThickness="1" CornerRadius="4" Padding="8,5">
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="CONVEYOR SAFETY &amp; TRIP CASCADE" FontSize="9.5" FontWeight="Bold" Foreground="#F59E0B" />
                                                    <TextBlock Text="{Binding ConveyorSafetySummary}" FontSize="10.5" Foreground="#A1A1AA" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>

                                            <!-- Live 3D GLB Model Turntable Preview Canvas under Each Equipment Card -->
                                            <controls:Equipment3DPreviewControl
                                                EquipmentId="{Binding Id}"
                                                Status="{Binding Status}"
                                                LoadPercent="{Binding LoadPercent}"
                                                Height="124" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- 3. THICKENER CIRCUIT -->
                    <StackPanel IsVisible="{Binding IsThickener}" Spacing="14">
                        <TextBlock Text="Thickener Circuit" Classes="section-title" />
                        <Border Classes="scada-card">
                            <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="24">
                                <controls:TankLevelControl Grid.Column="0"
                                                           Label="TK-201 Bed"
                                                           LevelPercent="{Binding ThickenerBedLevelPercent}"
                                                           HighHighLimit="92"
                                                           HighLimit="82"
                                                           LowLimit="20"
                                                           LowLowLimit="10"
                                                           Width="130" Height="160" />
                                <controls:ValveIndicatorControl Grid.Column="1"
                                                                Label="XV-201 Underflow"
                                                                State="{Binding ThickenerValveState}"
                                                                Width="110" Height="100"
                                                                VerticalAlignment="Center" />
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="6">
                                    <TextBlock Text="TK-201 High-Rate Thickener Instrumentation" FontSize="15" FontWeight="SemiBold" Foreground="#FAFAFA" />
                                    <TextBlock Text="{Binding ThickenerBedLevelPercent, StringFormat='Bed Level: {0:0.0} %'}" FontSize="13" Foreground="#F59E0B" />
                                    <TextBlock Text="{Binding WaterRecoveryPercent, StringFormat='Clarified Water Recovery: {0:0.0} %'}" FontSize="13" Foreground="#22C55E" />
                                </StackPanel>
                                <Button Grid.Column="3" Content="Locate TK-201 in 3D ↗"
                                        Command="{Binding LocateIn3DCommand}" CommandParameter="TK-201"
                                        Classes="secondary-action" Padding="10,6" FontSize="11" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ItemsControl ItemsSource="{Binding ThickenerEquipment}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Classes="scada-card" Width="320" Margin="0,0,14,14">
                                        <StackPanel Spacing="10">
                                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Id}" FontSize="12" FontWeight="Bold" Foreground="#F59E0B" />
                                                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Foreground="#FAFAFA" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="3D ↗"
                                                        Command="{Binding $parent[UserControl].((vm:MainShellViewModel)DataContext).LocateIn3DCommand}"
                                                        CommandParameter="{Binding Id}"
                                                        Classes="secondary-action" Padding="7,3" FontSize="10.5" VerticalAlignment="Top" />
                                                <Border Grid.Column="2" Classes="scada-panel" CornerRadius="4" Padding="8,3" VerticalAlignment="Top">
                                                    <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="Bold"
                                                               Foreground="{Binding Status, Converter={x:Static conv:StatusToBrushConverter.Instance}}" />
                                                </Border>
                                            </Grid>
                                            <Grid ColumnDefinitions="*,*">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding PrimaryMetricLabel}" Classes="card-label" />
                                                    <TextBlock Text="{Binding PrimaryMetricDisplay}" FontSize="18" FontWeight="Bold" Foreground="#FAFAFA" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="Power Draw" Classes="card-label" />
                                                    <TextBlock Text="{Binding PowerKw, StringFormat='{}{0:0.0} kW'}" FontSize="18" FontWeight="Bold" Foreground="#A1A1AA" />
                                                </StackPanel>
                                            </Grid>
                                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding LoadPercent}" Height="6" Foreground="#22C55E" />
                                            <TextBlock Text="{Binding LoadPercent, StringFormat='Load: {0:0.0}%'}" FontSize="11" Foreground="#A1A1AA" />
                                            <controls:TrendChartControl Values="{Binding SparklineValues}" Height="42" />
                                            <controls:Equipment3DPreviewControl EquipmentId="{Binding Id}" Status="{Binding Status}" LoadPercent="{Binding LoadPercent}" Height="116" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- 4. MAGNETITE PREPARATION -->
                    <StackPanel IsVisible="{Binding IsMagnetite}" Spacing="14">
                        <TextBlock Text="Magnetite Preparation &amp; Dense-Medium Cyclone Circuit" Classes="section-title" />
                        <Border Classes="scada-card">
                            <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="24">
                                <controls:TankLevelControl Grid.Column="0"
                                                           Label="TK-301 Medium"
                                                           LevelPercent="{Binding MagnetiteTankLevelPercent}"
                                                           HighHighLimit="90"
                                                           HighLimit="80"
                                                           LowLimit="22"
                                                           LowLowLimit="12"
                                                           Width="130" Height="160" />
                                <controls:ValveIndicatorControl Grid.Column="1"
                                                                Label="XV-301 DMC Feed"
                                                                State="{Binding MagnetiteValveState}"
                                                                Width="110" Height="100"
                                                                VerticalAlignment="Center" />
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="6">
                                    <TextBlock Text="TK-301 Magnetite Medium Sump &amp; DMC-301 Wide Diamond Cyclone" FontSize="15" FontWeight="SemiBold" Foreground="#FAFAFA" />
                                    <TextBlock Text="{Binding MagnetiteTankLevelPercent, StringFormat='Medium Tank Level: {0:0.0} %'}" FontSize="13" Foreground="#F59E0B" />
                                    <TextBlock Text="{Binding MediumSpecificGravity, StringFormat='Controlled Medium Density (DT-301): {0:0.00} SG'}" FontSize="13" Foreground="#F59E0B" />
                                </StackPanel>
                                <Button Grid.Column="3" Content="Locate DMC-301 in 3D ↗"
                                        Command="{Binding LocateIn3DCommand}" CommandParameter="DMC-301"
                                        Classes="primary-action" Padding="12,6" FontSize="11" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- DMC-301 Wide Diamond Cyclone & Macsep Split Instrumentation -->
                        <Border Classes="scada-card">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="DMC-301 Full-Length Wide Diamond Cyclone (4.30 m × 2.58 m) · West PIPE-304 Feed → East Screen Drops" FontSize="14" FontWeight="SemiBold" Foreground="#FAFAFA" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                        <Button Content="PT-301 3D ↗" Command="{Binding LocateIn3DCommand}" CommandParameter="PT-301" Classes="secondary-action" Padding="8,3" FontSize="10.5" />
                                        <Button Content="PIPE-304 3D ↗" Command="{Binding LocateIn3DCommand}" CommandParameter="PIPE-304" Classes="secondary-action" Padding="8,3" FontSize="10.5" />
                                        <Button Content="SC-301 / SC-302 3D ↗" Command="{Binding LocateIn3DCommand}" CommandParameter="SC-301" Classes="secondary-action" Padding="8,3" FontSize="10.5" />
                                    </StackPanel>
                                </Grid>
                                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="12">
                                    <Border Grid.Column="0" Classes="scada-panel">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="WEST INLET PRESSURE (PT-301)" Classes="card-label" />
                                            <TextBlock Text="{Binding DmcInletPressureKpa, StringFormat='{}{0:0.0} kPa'}" FontSize="18" FontWeight="Bold" Foreground="#10B981" />
                                            <TextBlock Text="Target 185.0 kPa · Sweeping PIPE-304" FontSize="10.5" Foreground="#A1A1AA" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Classes="scada-panel">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="EAST CLEAN OVERFLOW (VF-301)" Classes="card-label" />
                                            <TextBlock Text="{Binding DmcCleanOverflowTph, StringFormat='{}{0:0.0} t/h'}" FontSize="18" FontWeight="Bold" Foreground="#F59E0B" />
                                            <TextBlock Text="PIPE-312 → Product Screen SC-301" FontSize="10.5" Foreground="#A1A1AA" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Classes="scada-panel">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="EAST DISCARD APEX (APEX-301)" Classes="card-label" />
                                            <TextBlock Text="{Binding DmcDiscardApexTph, StringFormat='{}{0:0.0} t/h'}" FontSize="18" FontWeight="Bold" Foreground="#F59E0B" />
                                            <TextBlock Text="PIPE-313 → Discard Screen SC-302" FontSize="10.5" Foreground="#A1A1AA" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="3" Classes="scada-panel">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="MACSEP RECOVERY (MS-301)" Classes="card-label" />
                                            <TextBlock Text="{Binding MacsepRecoveryPercent, StringFormat='{}{0:0.1} %'}" FontSize="18" FontWeight="Bold" Foreground="#22C55E" />
                                            <TextBlock Text="BK-301 Drip Bucket → PIPE-301/302" FontSize="10.5" Foreground="#A1A1AA" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <ItemsControl ItemsSource="{Binding MagnetiteEquipment}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Classes="scada-card" Width="320" Margin="0,0,14,14">
                                        <StackPanel Spacing="10">
                                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Id}" FontSize="12" FontWeight="Bold" Foreground="#F59E0B" />
                                                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Foreground="#FAFAFA" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="3D ↗"
                                                        Command="{Binding $parent[UserControl].((vm:MainShellViewModel)DataContext).LocateIn3DCommand}"
                                                        CommandParameter="{Binding Id}"
                                                        Classes="secondary-action" Padding="7,3" FontSize="10.5" VerticalAlignment="Top" />
                                                <Border Grid.Column="2" Classes="scada-panel" CornerRadius="4" Padding="8,3" VerticalAlignment="Top">
                                                    <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="Bold"
                                                               Foreground="{Binding Status, Converter={x:Static conv:StatusToBrushConverter.Instance}}" />
                                                </Border>
                                            </Grid>
                                            <Grid ColumnDefinitions="*,*">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding PrimaryMetricLabel}" Classes="card-label" />
                                                    <TextBlock Text="{Binding PrimaryMetricDisplay}" FontSize="18" FontWeight="Bold" Foreground="#FAFAFA" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="Power Draw" Classes="card-label" />
                                                    <TextBlock Text="{Binding PowerKw, StringFormat='{}{0:0.0} kW'}" FontSize="18" FontWeight="Bold" Foreground="#A1A1AA" />
                                                </StackPanel>
                                            </Grid>
                                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding LoadPercent}" Height="6" Foreground="#F59E0B" />
                                            <TextBlock Text="{Binding LoadPercent, StringFormat='Load: {0:0.0}%'}" FontSize="11" Foreground="#A1A1AA" />
                                            <controls:TrendChartControl Values="{Binding SparklineValues}" Height="42" />
                                            <controls:Equipment3DPreviewControl EquipmentId="{Binding Id}" Status="{Binding Status}" LoadPercent="{Binding LoadPercent}" Height="116" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- 4B. FINE COAL & FROTH FLOTATION -->
                    <StackPanel IsVisible="{Binding IsFineCoal}" Spacing="14">
                        <TextBlock Text="Fine Coal &amp; Froth Flotation" Classes="section-title" />
                        <ItemsControl ItemsSource="{Binding FlotationEquipment}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Classes="scada-card" Width="320" Margin="0,0,14,14">
                                        <StackPanel Spacing="10">
                                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Id}" FontSize="12" FontWeight="Bold" Foreground="#F59E0B" />
                                                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Foreground="#FAFAFA" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="3D ↗"
                                                        Command="{Binding $parent[UserControl].((vm:MainShellViewModel)DataContext).LocateIn3DCommand}"
                                                        CommandParameter="{Binding Id}"
                                                        Classes="secondary-action" Padding="7,3" FontSize="10.5" VerticalAlignment="Top" />
                                                <Border Grid.Column="2" Classes="scada-panel" CornerRadius="4" Padding="8,3" VerticalAlignment="Top">
                                                    <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="Bold"
                                                               Foreground="{Binding Status, Converter={x:Static conv:StatusToBrushConverter.Instance}}" />
                                                </Border>
                                            </Grid>
                                            <Grid ColumnDefinitions="*,*">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding PrimaryMetricLabel}" Classes="card-label" />
                                                    <TextBlock Text="{Binding PrimaryMetricDisplay}" FontSize="18" FontWeight="Bold" Foreground="#FAFAFA" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="Power Draw" Classes="card-label" />
                                                    <TextBlock Text="{Binding PowerKw, StringFormat='{}{0:0.0} kW'}" FontSize="18" FontWeight="Bold" Foreground="#A1A1AA" />
                                                </StackPanel>
                                            </Grid>
                                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding LoadPercent}" Height="6" Foreground="#F59E0B" />
                                            <TextBlock Text="{Binding LoadPercent, StringFormat='Load: {0:0.0}%'}" FontSize="11" Foreground="#A1A1AA" />
                                            <controls:TrendChartControl Values="{Binding SparklineValues}" Height="42" />
                                            <controls:Equipment3DPreviewControl EquipmentId="{Binding Id}" Status="{Binding Status}" LoadPercent="{Binding LoadPercent}" Height="116" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- 4C. DEWATERING & TAILINGS -->
                    <StackPanel IsVisible="{Binding IsDewatering}" Spacing="14">
                        <TextBlock Text="Dewatering &amp; Tailings" Classes="section-title" />
                        <ItemsControl ItemsSource="{Binding DewateringEquipment}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Classes="scada-card" Width="320" Margin="0,0,14,14">
                                        <StackPanel Spacing="10">
                                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Id}" FontSize="12" FontWeight="Bold" Foreground="#F59E0B" />
                                                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Foreground="#FAFAFA" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="3D ↗"
                                                        Command="{Binding $parent[UserControl].((vm:MainShellViewModel)DataContext).LocateIn3DCommand}"
                                                        CommandParameter="{Binding Id}"
                                                        Classes="secondary-action" Padding="7,3" FontSize="10.5" VerticalAlignment="Top" />
                                                <Border Grid.Column="2" Classes="scada-panel" CornerRadius="4" Padding="8,3" VerticalAlignment="Top">
                                                    <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="Bold"
                                                               Foreground="{Binding Status, Converter={x:Static conv:StatusToBrushConverter.Instance}}" />
                                                </Border>
                                            </Grid>
                                            <Grid ColumnDefinitions="*,*">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding PrimaryMetricLabel}" Classes="card-label" />
                                                    <TextBlock Text="{Binding PrimaryMetricDisplay}" FontSize="18" FontWeight="Bold" Foreground="#FAFAFA" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="Power Draw" Classes="card-label" />
                                                    <TextBlock Text="{Binding PowerKw, StringFormat='{}{0:0.0} kW'}" FontSize="18" FontWeight="Bold" Foreground="#A1A1AA" />
                                                </StackPanel>
                                            </Grid>
                                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding LoadPercent}" Height="6" Foreground="#A855F7" />
                                            <TextBlock Text="{Binding LoadPercent, StringFormat='Load: {0:0.0}%'}" FontSize="11" Foreground="#A1A1AA" />
                                            <controls:ConveyorStatusAnimationControl
                                                IsVisible="{Binding HasConveyorSafety}"
                                                EquipmentId="{Binding Id}"
                                                EquipmentType="{Binding Type}"
                                                Status="{Binding Status}"
                                                LoadPercent="{Binding LoadPercent}"
                                                BeltSpeed="{Binding PrimaryMetric}"
                                                PullCordOk="{Binding PullCordOk}"
                                                BeltAlignmentOk="{Binding BeltAlignmentOk}"
                                                BeltSlipOk="{Binding BeltSlipOk}"
                                                Height="48" />
                                            <controls:TrendChartControl Values="{Binding SparklineValues}" Height="42" />
                                            <Border IsVisible="{Binding HasConveyorSafety}" Classes="scada-panel" BorderBrush="#27272A" BorderThickness="1" CornerRadius="4" Padding="8,6">
                                                <StackPanel Spacing="3">
                                                    <TextBlock Text="CONVEYOR SAFETY &amp; TRIP CASCADE" FontSize="10" FontWeight="Bold" Foreground="#F59E0B" />
                                                    <TextBlock Text="{Binding ConveyorSafetySummary}" FontSize="11" Foreground="#A1A1AA" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                            <controls:Equipment3DPreviewControl EquipmentId="{Binding Id}" Status="{Binding Status}" LoadPercent="{Binding LoadPercent}" Height="116" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- 4D. ROM, LOADOUT & PGNAA -->
                    <StackPanel IsVisible="{Binding IsRomLoadout}" Spacing="14">
                        <TextBlock Text="ROM, Loadout &amp; PGNAA Online Quality" Classes="section-title" />
                        <Border Classes="scada-card">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="24">
                                <controls:TankLevelControl Grid.Column="0"
                                                           Label="SL-601 Silo"
                                                           LevelPercent="{Binding ProductSiloLevelPercent}"
                                                           HighHighLimit="92"
                                                           HighLimit="82"
                                                           LowLimit="18"
                                                           LowLowLimit="8"
                                                           Width="130" Height="160" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="10">
                                    <TextBlock Text="SL-601 Clean Coal Silo &amp; AN-601 PGNAA Online Quality Analyzer" FontSize="15" FontWeight="SemiBold" Foreground="#FAFAFA" />
                                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="12">
                                        <Border Grid.Column="0" Classes="scada-panel">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="PRODUCT ASH (AN-601)" Classes="card-label" />
                                                <TextBlock Text="{Binding PgnaaAshPercent, StringFormat='{}{0:0.2} %'}" FontSize="18" FontWeight="Bold" Foreground="#22C55E" />
                                                <TextBlock Text="Spec &lt; 10.50 %" FontSize="10.5" Foreground="#A1A1AA" />
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="1" Classes="scada-panel">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="MOISTURE (AN-601)" Classes="card-label" />
                                                <TextBlock Text="{Binding PgnaaMoisturePercent, StringFormat='{}{0:0.2} %'}" FontSize="18" FontWeight="Bold" Foreground="#F59E0B" />
                                                <TextBlock Text="Spec &lt; 9.50 %" FontSize="10.5" Foreground="#A1A1AA" />
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="2" Classes="scada-panel">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="CALORIFIC VALUE" Classes="card-label" />
                                                <TextBlock Text="{Binding PgnaaCalorificValueMjKg, StringFormat='{}{0:0.2} MJ/kg'}" FontSize="18" FontWeight="Bold" Foreground="#F59E0B" />
                                                <TextBlock Text="Export Grade &gt; 26.5 MJ/kg" FontSize="10.5" Foreground="#A1A1AA" />
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="3" Classes="scada-panel">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="SILO INVENTORY" Classes="card-label" />
                                                <TextBlock Text="{Binding ProductSiloTons, StringFormat='{}{0:0} t'}" FontSize="18" FontWeight="Bold" Foreground="#FAFAFA" />
                                                <TextBlock Text="{Binding TrainLoadoutRateTph, StringFormat='Batch: {0:0} t/h'}" FontSize="10.5" Foreground="#A1A1AA" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="6" VerticalAlignment="Center">
                                    <Button Content="ROM Stage 1 3D ↗" Command="{Binding LocateIn3DCommand}" CommandParameter="BN-101" Classes="secondary-action" Padding="10,5" FontSize="11" />
                                    <Button Content="Product Pile 3D ↗" Command="{Binding LocateIn3DCommand}" CommandParameter="SP-301" Classes="secondary-action" Padding="10,5" FontSize="11" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ItemsControl ItemsSource="{Binding RomLoadoutEquipment}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Classes="scada-card" Width="320" Margin="0,0,14,14">
                                        <StackPanel Spacing="10">
                                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Id}" FontSize="12" FontWeight="Bold" Foreground="#F59E0B" />
                                                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Foreground="#FAFAFA" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="3D ↗"
                                                        Command="{Binding $parent[UserControl].((vm:MainShellViewModel)DataContext).LocateIn3DCommand}"
                                                        CommandParameter="{Binding Id}"
                                                        Classes="secondary-action" Padding="7,3" FontSize="10.5" VerticalAlignment="Top" />
                                                <Border Grid.Column="2" Classes="scada-panel" CornerRadius="4" Padding="8,3" VerticalAlignment="Top">
                                                    <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="Bold"
                                                               Foreground="{Binding Status, Converter={x:Static conv:StatusToBrushConverter.Instance}}" />
                                                </Border>
                                            </Grid>
                                            <Grid ColumnDefinitions="*,*">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding PrimaryMetricLabel}" Classes="card-label" />
                                                    <TextBlock Text="{Binding PrimaryMetricDisplay}" FontSize="18" FontWeight="Bold" Foreground="#FAFAFA" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="Power Draw" Classes="card-label" />
                                                    <TextBlock Text="{Binding PowerKw, StringFormat='{}{0:0.0} kW'}" FontSize="18" FontWeight="Bold" Foreground="#A1A1AA" />
                                                </StackPanel>
                                            </Grid>
                                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding LoadPercent}" Height="6" Foreground="#10B981" />
                                            <TextBlock Text="{Binding LoadPercent, StringFormat='Load: {0:0.0}%'}" FontSize="11" Foreground="#A1A1AA" />
                                            <controls:TrendChartControl Values="{Binding SparklineValues}" Height="42" />
                                            <controls:Equipment3DPreviewControl EquipmentId="{Binding Id}" Status="{Binding Status}" LoadPercent="{Binding LoadPercent}" Height="116" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- 6. EQUIPMENT & ASSETS INSPECTOR -->
                    <StackPanel IsVisible="{Binding IsEquipmentAssets}" Spacing="14">
                        <TextBlock Text="Equipment &amp; 104-Node 3D GA Assets Inspector" Classes="section-title" />
                        <Grid ColumnDefinitions="*,1.35*" ColumnSpacing="16">
                            <ListBox Grid.Column="0" ItemsSource="{Binding Equipment}" SelectedItem="{Binding SelectedEquipment}"
                                     Background="#111113" BorderBrush="#27272A" BorderThickness="1" CornerRadius="8" MaxHeight="520">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="12,80,*,Auto" ColumnSpacing="10" Margin="4">
                                            <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                                     Fill="{Binding Status, Converter={x:Static conv:StatusToBrushConverter.Instance}}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Id}" FontWeight="Bold" Foreground="#F59E0B" />
                                            <TextBlock Grid.Column="2" Text="{Binding Name}" Foreground="#FAFAFA" />
                                            <TextBlock Grid.Column="3" Text="{Binding PrimaryMetricDisplay}" Foreground="#A1A1AA" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Border Grid.Column="1" Classes="scada-card">
                                <StackPanel Spacing="12">
                                    <Grid ColumnDefinitions="*,Auto" DataContext="{Binding SelectedEquipment}">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="Bold" Foreground="#FAFAFA" />
                                            <TextBlock Text="{Binding Area, StringFormat='Area: {0}'}" FontSize="12" Foreground="#A1A1AA" />
                                            <TextBlock Text="{Binding InterlockSummary}" FontSize="12" Foreground="#F59E0B" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Locate in 3D Twin ↗"
                                                Command="{Binding $parent[UserControl].((vm:MainShellViewModel)DataContext).LocateIn3DCommand}"
                                                CommandParameter="{Binding Id}"
                                                Classes="primary-action" Padding="12,6" FontSize="11" VerticalAlignment="Top" />
                                    </Grid>

                                    <TextBlock Text="Live SCADA Telemetry Tags" FontSize="13" FontWeight="SemiBold" Foreground="#A1A1AA" />
                                    <ItemsControl ItemsSource="{Binding SelectedEquipment.Tags}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Classes="scada-panel" Margin="0,2">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock Text="{Binding Name}" Foreground="#A1A1AA" />
                                                        <TextBlock Grid.Column="1" Text="{Binding FormattedValue}" FontWeight="Bold" Foreground="#FAFAFA" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="Mapped 3D Digital Twin Nodes &amp; Sub-Equipment" FontSize="13" FontWeight="SemiBold" Foreground="#F59E0B" Margin="0,4,0,0" />
                                    <ItemsControl ItemsSource="{Binding SelectedEquipment3DChildren}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="threed:Plant3DNode">
                                                <Border Classes="scada-panel" Margin="0,2">
                                                    <Grid ColumnDefinitions="85,*,Auto" ColumnSpacing="8">
                                                        <TextBlock Grid.Column="0" Text="{Binding Id}" FontSize="11" FontWeight="Bold" Foreground="#F59E0B" VerticalAlignment="Center" />
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="{Binding GaLabel}" FontSize="11.5" FontWeight="SemiBold" Foreground="#FAFAFA" />
                                                            <TextBlock Text="{Binding DimensionsSpec}" FontSize="10" Foreground="#A1A1AA" />
                                                        </StackPanel>
                                                        <Button Grid.Column="2" Content="3D ↗"
                                                                Command="{Binding $parent[UserControl].((vm:MainShellViewModel)DataContext).LocateIn3DCommand}"
                                                                CommandParameter="{Binding Id}"
                                                                Classes="secondary-action" Padding="8,3" FontSize="10.5" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Full 104-Item Searchable 3D GA Asset Directory -->
                        <Border Classes="scada-card">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,220,240" ColumnSpacing="10">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="104-Node 3D GA Interactive Asset Directory (18 Machines · 11 Conveyors · 64 Sub-Equipment · 11 Pipes)" FontSize="14" FontWeight="SemiBold" Foreground="#FAFAFA" />
                                        <TextBlock Text="{Binding Filtered3DAssets.Count, StringFormat='Showing {0} matching 3D plant items — click 3D ↗ to inspect in hardware PBR viewport'}" FontSize="11" Foreground="#A1A1AA" />
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding AssetCategories}" SelectedItem="{Binding SelectedAssetCategory}" HorizontalAlignment="Stretch" />
                                    <TextBox Grid.Column="2" Text="{Binding AssetSearchQuery}" PlaceholderText="Filter by ID, GA label, type..." />
                                </Grid>
                                <ListBox ItemsSource="{Binding Filtered3DAssets}" MaxHeight="260" Background="#111113" BorderBrush="#27272A" BorderThickness="1" CornerRadius="6">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="threed:Plant3DNode">
                                            <Grid ColumnDefinitions="90,210,160,*,75,Auto" ColumnSpacing="10" Margin="4,2">
                                                <TextBlock Grid.Column="0" Text="{Binding Id}" FontWeight="Bold" Foreground="#F59E0B" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding GaLabel}" Foreground="#FAFAFA" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="{Binding EquipmentType}" FontSize="11" Foreground="#A1A1AA" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="3" Text="{Binding DimensionsSpec}" FontSize="11" Foreground="#71717A" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="4" Text="{Binding LinkedScadaId}" FontSize="11" FontWeight="SemiBold" Foreground="#22C55E" VerticalAlignment="Center" />
                                                <Button Grid.Column="5" Content="View in 3D ↗"
                                                        Command="{Binding $parent[UserControl].((vm:MainShellViewModel)DataContext).LocateIn3DCommand}"
                                                        CommandParameter="{Binding Id}"
                                                        Classes="secondary-action" Padding="8,3" FontSize="10.5" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 7. TRENDS & HISTORIAN -->
                    <StackPanel IsVisible="{Binding IsTrends}" Spacing="14">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <TextBlock Text="Live Trends &amp; Local Multi-Trace Historian (ScottPlot)" Classes="section-title" />
                            <TextBlock Grid.Column="1" Text="{Binding HistorianExportStatus}" FontSize="11" Foreground="#22C55E" VerticalAlignment="Center" />
                        </Grid>

                        <Border Classes="scada-card">
                            <Grid ColumnDefinitions="320,*,Auto,Auto" ColumnSpacing="12">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="PRIMARY TELEMETRY TAG" Classes="card-label" />
                                    <ComboBox ItemsSource="{Binding AllTags}" SelectedItem="{Binding SelectedTrendTag}" HorizontalAlignment="Stretch">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Text="PROCESS LOOP OVERLAY PRESET" Classes="card-label" />
                                    <ComboBox ItemsSource="{Binding HistorianPresets}" SelectedItem="{Binding SelectedHistorianPreset}" HorizontalAlignment="Stretch" />
                                </StackPanel>
                                <Button Grid.Column="2" Content="Export CSV" Command="{Binding ExportHistorianCsvCommand}" Classes="primary-action" Padding="14,8" VerticalAlignment="Bottom" />
                                <Button Grid.Column="3" Content="Locate in 3D ↗"
                                        Command="{Binding LocateIn3DCommand}"
                                        CommandParameter="{Binding SelectedEquipment.Id}"
                                        Classes="secondary-action" Padding="12,8" VerticalAlignment="Bottom" />
                            </Grid>
                        </Border>

                        <Grid ColumnDefinitions="*,*,*,*,*,*" ColumnSpacing="10">
                            <Border Grid.Column="0" Classes="scada-panel">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="CURRENT" Classes="card-label" />
                                    <TextBlock Text="{Binding SelectedTrendTag.FormattedValue}" FontSize="16" FontWeight="Bold" Foreground="#F59E0B" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Classes="scada-panel">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="MINIMUM" Classes="card-label" />
                                    <TextBlock Text="{Binding TrendStatMin, StringFormat='{}{0:0.##}'}" FontSize="16" FontWeight="Bold" Foreground="#FAFAFA" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Classes="scada-panel">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="MAXIMUM" Classes="card-label" />
                                    <TextBlock Text="{Binding TrendStatMax, StringFormat='{}{0:0.##}'}" FontSize="16" FontWeight="Bold" Foreground="#FAFAFA" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="3" Classes="scada-panel">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="MEAN (AVG)" Classes="card-label" />
                                    <TextBlock Text="{Binding TrendStatAvg, StringFormat='{}{0:0.##}'}" FontSize="16" FontWeight="Bold" Foreground="#22C55E" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="4" Classes="scada-panel">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="STD DEV (σ)" Classes="card-label" />
                                    <TextBlock Text="{Binding TrendStatStdDev, StringFormat='{}{0:0.###}'}" FontSize="16" FontWeight="Bold" Foreground="#F59E0B" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="5" Classes="scada-panel">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="ENG LIMITS" Classes="card-label" />
                                    <TextBlock Text="{Binding TrendLimitsSummary}" FontSize="14" FontWeight="SemiBold" Foreground="#A1A1AA" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Classes="scada-card">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="{Binding SelectedTrendTag.Name}" FontSize="15" FontWeight="SemiBold" Foreground="#FAFAFA" />
                                    <TextBlock Grid.Column="1" Text="{Binding TrendSampleCount, StringFormat='Historian Window: {0} samples (1 Hz)'}" FontSize="11" Foreground="#A1A1AA" VerticalAlignment="Center" />
                                </Grid>
                                <scott:AvaPlot x:Name="HistorianAvaPlot" Height="300" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 8. ALARMS & EVENTS -->
                    <StackPanel IsVisible="{Binding IsAlarms}" Spacing="14">
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10">
                            <TextBlock Text="Alarms &amp; Events (ISA-18.2 State Machine)" Classes="section-title" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding AlarmFilterModes}" SelectedItem="{Binding SelectedAlarmFilter}" Width="170" />
                            <Button Grid.Column="2" Content="Silence Horn" Command="{Binding SilenceHornCommand}" Classes="secondary-action" />
                            <Button Grid.Column="3" Content="Acknowledge All (Local)" Command="{Binding AcknowledgeAllAlarmsCommand}" Classes="secondary-action" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding FilteredAlarms}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Classes="scada-card" Margin="0,4">
                                        <Grid ColumnDefinitions="14,85,75,145,*,Auto,Auto,Auto,Auto" ColumnSpacing="10">
                                            <Ellipse Width="10" Height="10" VerticalAlignment="Center"
                                                     Fill="{Binding Severity, Converter={x:Static conv:StatusToBrushConverter.Instance}}" />
                                            <TextBlock Grid.Column="1" Text="{Binding TimeDisplay}" Foreground="#A1A1AA" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding EquipmentId}" FontWeight="Bold" Foreground="#F59E0B" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="{Binding Area}" Foreground="#A1A1AA" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="4" Text="{Binding Message}" Foreground="#FAFAFA" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="5" Text="{Binding Severity}" FontWeight="Bold"
                                                       Foreground="{Binding Severity, Converter={x:Static conv:StatusToBrushConverter.Instance}}" VerticalAlignment="Center" />
                                            <Button Grid.Column="6" Content="3D ↗"
                                                    Command="{Binding $parent[UserControl].((vm:MainShellViewModel)DataContext).LocateIn3DCommand}"
                                                    CommandParameter="{Binding EquipmentId}"
                                                    Classes="secondary-action" Padding="8,4" />
                                            <Button Grid.Column="7" Content="Ack"
                                                    IsEnabled="{Binding !IsAcknowledged}"
                                                    Command="{Binding $parent[UserControl].((vm:MainShellViewModel)DataContext).AcknowledgeAlarmCommand}"
                                                    CommandParameter="{Binding}"
                                                    Classes="secondary-action" Padding="10,4" />
                                            <Button Grid.Column="8" Content="Shelve 15m"
                                                    Command="{Binding $parent[UserControl].((vm:MainShellViewModel)DataContext).ShelveAlarmCommand}"
                                                    CommandParameter="{Binding}"
                                                    Classes="secondary-action" Padding="10,4" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- 9. SYSTEM DIAGNOSTICS -->
                    <StackPanel IsVisible="{Binding IsDiagnostics}" Spacing="14">
                        <TextBlock Text="System, 3D Engine &amp; 8-Gate Deployment Diagnostics" Classes="section-title" />
                        <Border Classes="scada-card">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{Binding ConnectionStatusLabel, StringFormat='SCADA Core: {0}'}" Foreground="#FAFAFA" />
                                <TextBlock Text="{Binding NativeProtocolStatus, StringFormat='Native ScadaClient Protocol: {0}'}" Foreground="#F59E0B" />
                                <TextBlock Text="{Binding ControlModeSummary, StringFormat='Control Boundary: {0}'}" Foreground="#22C55E" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding OperatorBadge, StringFormat='Active Operator Session: {0}'}" Foreground="#F59E0B" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding GlbEngineSummaryText, StringFormat='3D Digital Twin Engine: {0}'}" Foreground="#F59E0B" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding UnityStreamStatus, StringFormat='Unity 3D Bridge: {0}'}" Foreground="#A1A1AA" />
                                <TextBlock Text="{Binding UnityBridge.IsBlenderInstalled, StringFormat='Blender Installed: {0}'}" Foreground="#A1A1AA" />
                                <TextBlock Text="{Binding UnityBridge.AssetsExportDirectory, StringFormat='3D Export Directory: {0}'}" Foreground="#A1A1AA" />
                            </StackPanel>
                        </Border>

                        <!-- 8-Gate Live Deployment Readiness Verification Card -->
                        <Border Classes="scada-card">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel>
                                        <TextBlock Text="8-Gate Deployment &amp; Architecture Readiness Suite" FontSize="15" FontWeight="SemiBold" Foreground="#FAFAFA" />
                                        <TextBlock Text="{Binding DiagnosticSummaryText}" FontSize="12" Foreground="#22C55E" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Re-Verify All 8 Gates" Command="{Binding RunDeploymentHealthCheckCommand}" Classes="primary-action" Padding="12,6" FontSize="11" VerticalAlignment="Center" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding DiagnosticChecks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:StartupCheckItem">
                                            <Border Classes="scada-panel" Margin="0,2">
                                                <Grid ColumnDefinitions="70,75,240,*,65" ColumnSpacing="10">
                                                    <TextBlock Grid.Column="0" Text="{Binding StateLabel}" FontSize="11" FontWeight="Bold" Foreground="#22C55E" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Category}" FontSize="11" FontWeight="Bold" Foreground="#F59E0B" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Title}" FontSize="11.5" FontWeight="SemiBold" Foreground="#FAFAFA" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="3" Text="{Binding Detail}" FontSize="11" Foreground="#A1A1AA" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="4" Text="{Binding DurationText}" FontSize="10.5" Foreground="#71717A" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Classes="scada-card">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Operator Authentication, RBAC &amp; Electronic Shift Handover" FontSize="15" FontWeight="SemiBold" Foreground="#FAFAFA" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Operator (J. Mokoena)" Command="{Binding SwitchOperatorCommand}" CommandParameter="operator1:1234" Classes="secondary-action" Padding="10,6" FontSize="11" />
                                    <Button Content="Shift Supervisor (S. Nkosi)" Command="{Binding SwitchOperatorCommand}" CommandParameter="supervisor1:2468" Classes="secondary-action" Padding="10,6" FontSize="11" />
                                    <Button Content="C&amp;I Engineer (T. van Wyk)" Command="{Binding SwitchOperatorCommand}" CommandParameter="engineer1:9999" Classes="secondary-action" Padding="10,6" FontSize="11" />
                                    <Button Content="Observer (Read-Only)" Command="{Binding SwitchOperatorCommand}" CommandParameter="viewer1:0000" Classes="secondary-action" Padding="10,6" FontSize="11" />
                                </StackPanel>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBox Text="{Binding HandoverNoteDraft}" PlaceholderText="Enter shift handover log note..." />
                                    <Button Grid.Column="1" Content="Log Handover Note" Command="{Binding AddHandoverNoteCommand}" Classes="primary-action" Padding="12,8" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding HandoverLog}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Classes="scada-panel" Margin="0,2">
                                                <Grid ColumnDefinitions="140,140,*" ColumnSpacing="10">
                                                    <TextBlock Grid.Column="0" Text="{Binding TimeDisplay}" FontSize="11" Foreground="#A1A1AA" />
                                                    <TextBlock Grid.Column="1" Text="{Binding RoleDisplay}" FontSize="11" FontWeight="SemiBold" Foreground="#F59E0B" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Note}" FontSize="11" Foreground="#FAFAFA" TextWrapping="Wrap" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <Border Classes="scada-card">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Control Safety Boundary (Simulated Audit)" FontSize="15" FontWeight="SemiBold" Foreground="#FAFAFA" />
                                <TextBlock Text="Executes a read-only / simulated Cause-and-Effect interlock audit via ControlBoundaryEngine without actuating real plant hardware." FontSize="12" Foreground="#A1A1AA" TextWrapping="Wrap" />
                                <Button Content="Run Simulated Control Audit" Command="{Binding RunSimulatedControlAuditCommand}" Classes="secondary-action" HorizontalAlignment="Left" />
                                <TextBlock Text="{Binding LastControlAuditResult}" FontSize="12" Foreground="#F59E0B" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                </Panel>
            </ScrollViewer>

            <!-- 3D DIGITAL TWIN SINGLE-PAGE WORKSPACE (ZERO SCROLLING) -->
            <Grid Grid.Column="1" IsVisible="{Binding IsDigitalTwin3D}" RowDefinitions="Auto,*" Margin="14,10" RowSpacing="8">
                <!-- Row 0: Unified Single-Line Header & Node Selection Bar -->
                <Border Grid.Row="0" Classes="scada-card" Padding="12,8">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="3D Digital Twin" FontSize="16" FontWeight="Bold" Foreground="#FAFAFA" VerticalAlignment="Center" />
                            <Border Background="#2A1C08" BorderBrush="#D97706" BorderThickness="1" CornerRadius="6" Padding="8,2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding TelemetrySourceBadgeText}" FontSize="10.5" FontWeight="Bold" Foreground="#FBBF24" />
                            </Border>
                            <TextBlock Text="Read-only · Zero PLC Write" FontSize="11" Foreground="#A1A1AA" VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Button Content="◀ Prev" Command="{Binding SelectPrev3DNodeCommand}" Classes="secondary-action" Padding="9,4" FontSize="11" />
                            <Button Content="Next ▶" Command="{Binding SelectNext3DNodeCommand}" Classes="secondary-action" Padding="9,4" FontSize="11" />
                            <ComboBox ItemsSource="{Binding All3DNodes}" SelectedItem="{Binding Selected3DNode}" MinWidth="220" Padding="8,4" FontSize="11">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="threed:Plant3DNode">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{Binding Id}" FontWeight="Bold" Foreground="#F59E0B" />
                                            <TextBlock Text="·" Foreground="#71717A" />
                                            <TextBlock Text="{Binding GaLabel}" Foreground="#E4E4E7" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Content="Focus (F)" Command="{Binding FocusSelected3DCommand}" Classes="primary-action" Padding="10,4" FontSize="11" />
                            <Button Content="Focus Alarm" Command="{Binding FocusActiveAlarm3DCommand}" Classes="secondary-action" Padding="10,4" FontSize="11" />
                        </StackPanel>

                        <Border Grid.Column="2" Classes="scada-panel" Padding="8,4" VerticalAlignment="Center">
                            <TextBlock Text="{Binding UnityStreamStatus}" FontSize="11" Foreground="#22C55E" />
                        </Border>
                    </Grid>
                </Border>

                <!-- Row 1: Responsive Full-Height 3D Viewport + Zero-Scroll 3-Card Side Menu -->
                <Grid Grid.Row="1" ColumnDefinitions="*,395" ColumnSpacing="10">
                    <!-- Left: Auto-Stretching OpenGL Viewport & Single-Row Camera Presets -->
                    <Border Grid.Column="0" Classes="scada-card" Padding="10">
                        <Grid RowDefinitions="*,Auto" RowSpacing="8">
                            <controls:Plant3DViewportControl
                                Grid.Row="0"
                                x:Name="Plant3DViewport"
                                Equipment="{Binding Equipment}"
                                Effects="{Binding UnityEffects}"
                                CameraPreset="{Binding UnityEffects.CameraPreset}"
                                SelectedEquipment="{Binding SelectedEquipment, Mode=TwoWay}"
                                Selected3DNode="{Binding Selected3DNode, Mode=TwoWay}"
                                FocusTargetId="{Binding FocusTargetId}"
                                TelemetrySourceBadge="{Binding TelemetrySourceBadgeText}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch" />

                            <Grid Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Border Background="#241C0B" BorderBrush="#453517" BorderThickness="1" CornerRadius="6" Padding="8,4" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding UnityEffects.CameraPreset, StringFormat='Camera: {0}'}"
                                               FontSize="11" FontWeight="SemiBold" Foreground="#F59E0B" />
                                </Border>
                                <ItemsControl Grid.Column="1" ItemsSource="{Binding CameraPresets}" VerticalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding}" Classes="secondary-action" Padding="8,4" FontSize="10.5"
                                                    Margin="0,0,5,2"
                                                    Command="{Binding $parent[UserControl].((vm:MainShellViewModel)DataContext).SetCameraPresetCommand}"
                                                    CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Right: Zero-Scroll Side Menu (3 Compact Cards Fit 100% On Screen) -->
                    <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*" RowSpacing="8">
                        <!-- Card 1: Equipment Identification & Process Flow -->
                        <Border Grid.Row="0" Classes="scada-card" Padding="11,8">
                            <StackPanel Spacing="4">
                                <TextBlock Text="EQUIPMENT IDENTIFICATION &amp; PROCESS FLOW" FontSize="10.5" FontWeight="Bold" Foreground="#A1A1AA" />

                                <Grid ColumnDefinitions="*,Auto" DataContext="{Binding Selected3DNode}">
                                    <TextBlock Text="{Binding Id}" FontSize="15" FontWeight="Bold" Foreground="#F59E0B" />
                                    <TextBlock Grid.Column="1" Text="{Binding EquipmentType}" FontSize="10.5" FontWeight="SemiBold" Foreground="#A1A1AA" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock DataContext="{Binding Selected3DNode}" Text="{Binding GaLabel}" FontSize="13" FontWeight="Bold" Foreground="#FAFAFA" TextTrimming="CharacterEllipsis" />
                                <TextBlock DataContext="{Binding Selected3DNode}" Text="{Binding StageLabel}" FontSize="10.5" FontWeight="SemiBold" Foreground="#F59E0B" TextTrimming="CharacterEllipsis" />

                                <Grid ColumnDefinitions="*,*" ColumnSpacing="6" DataContext="{Binding Selected3DNode}">
                                    <Border Grid.Column="0" Classes="scada-panel" Padding="6,4">
                                        <StackPanel Spacing="1">
                                            <TextBlock Text="MATERIAL FLOW" FontSize="9" FontWeight="Bold" Foreground="#71717A" />
                                            <TextBlock Text="{Binding FlowSummary}" FontSize="10.5" FontWeight="SemiBold" Foreground="#E4E4E7" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Classes="scada-panel" Padding="6,4">
                                        <StackPanel Spacing="1">
                                            <TextBlock Text="PLC / SCADA CHANNEL" FontSize="9" FontWeight="Bold" Foreground="#71717A" />
                                            <TextBlock Text="{Binding PlcChannelMapping}" FontSize="10" FontWeight="SemiBold" Foreground="#F59E0B" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Border Background="#111113" BorderBrush="#27272A" BorderThickness="1" CornerRadius="5" Padding="6,4" DataContext="{Binding Selected3DNode}">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding ProvisionalConfigNote}" FontSize="10" FontWeight="SemiBold" Foreground="#D4D4D8" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding DimensionsSpec, StringFormat='Spec: {0}'}" FontSize="10" Foreground="#A1A1AA" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding MechanicalPrinciple}" FontSize="10" Foreground="#71717A" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Border>

                                <Border BorderBrush="#27272A" BorderThickness="0,1,0,0" Padding="0,4,0,0" DataContext="{Binding SelectedEquipment}">
                                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10">
                                        <TextBlock Grid.Column="0" Text="{Binding Id, StringFormat='SCADA: {0}'}" FontSize="11" FontWeight="SemiBold" Foreground="#F59E0B" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Status}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"
                                                   Foreground="{Binding Status, Converter={x:Static conv:StatusToBrushConverter.Instance}}" />
                                        <TextBlock Grid.Column="2" Text="{Binding PowerKw, StringFormat='{}{0:0.0} kW'}" FontSize="10.5" Foreground="#A1A1AA" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Text="{Binding LoadPercent, StringFormat='Load {0:0}%'}" FontSize="10.5" Foreground="#FAFAFA" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>

                                <!-- Live Hardware-Accelerated Telemetry Sparkline (ScottPlot.Avalonia) -->
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,2,0,0">
                                    <TextBlock Grid.Column="0" Text="LIVE TELEMETRY TREND" FontSize="9" FontWeight="Bold" Foreground="#71717A" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Selected3DTrendLabel}" FontSize="9.5" FontWeight="SemiBold" Foreground="#F59E0B"
                                               HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                </Grid>
                                <Border Background="#111113" BorderBrush="#27272A" BorderThickness="1" CornerRadius="5" Padding="2" Height="52">
                                    <scott:AvaPlot x:Name="SelectedNodeTrendPlot" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Card 2: Compact 2-Column 3D Physics, Camera & FX Grid (14 Toggles) -->
                        <Border Grid.Row="1" Classes="scada-card" Padding="12,9">
                            <StackPanel Spacing="4">
                                <TextBlock Text="3D PHYSICS, CAMERA &amp; FX" FontSize="10.5" FontWeight="Bold" Foreground="#A1A1AA" />
                                <UniformGrid Columns="2" Rows="7">
                                    <CheckBox Content="Equipment Tags" IsChecked="{Binding UnityEffects.ShowEquipmentLabels}" Foreground="#D4D4D8" FontSize="10.5" MinHeight="22" Margin="0,1" />
                                    <CheckBox Content="Flow Arrows (&gt;&gt;&gt;)" IsChecked="{Binding UnityEffects.ShowFlowDirection}" Foreground="#D4D4D8" FontSize="10.5" MinHeight="22" Margin="0,1" />
                                    <CheckBox Content="Flow Particles" IsChecked="{Binding UnityEffects.ShowFlowParticles}" Foreground="#D4D4D8" FontSize="10.5" MinHeight="22" Margin="0,1" />
                                    <CheckBox Content="Thermal Heatmap" IsChecked="{Binding UnityEffects.ShowThermalHeatmap}" Foreground="#D4D4D8" FontSize="10.5" MinHeight="22" Margin="0,1" />
                                    <CheckBox Content="Alarm Halos" IsChecked="{Binding UnityEffects.ShowAlarmHalos}" Foreground="#D4D4D8" FontSize="10.5" MinHeight="22" Margin="0,1" />
                                    <CheckBox Content="Animate Mechanics" IsChecked="{Binding UnityEffects.AnimateConveyors}" Foreground="#D4D4D8" FontSize="10.5" MinHeight="22" Margin="0,1" />
                                    <CheckBox Content="3-Axis Vibration" IsChecked="{Binding UnityEffects.EnableVibrationPhysics}" Foreground="#D4D4D8" FontSize="10.5" MinHeight="22" Margin="0,1" />
                                    <CheckBox Content="Ground Shadows" IsChecked="{Binding UnityEffects.ShowGroundShadows}" Foreground="#D4D4D8" FontSize="10.5" MinHeight="22" Margin="0,1" />
                                    <CheckBox Content="Bilateral GTAO" IsChecked="{Binding UnityEffects.EnableAmbientOcclusion}" Foreground="#D4D4D8" FontSize="10.5" MinHeight="22" Margin="0,1" />
                                    <CheckBox Content="Dust &amp; Water Sprays" IsChecked="{Binding UnityEffects.ShowDustAndSprayPlumes}" Foreground="#D4D4D8" FontSize="10.5" MinHeight="22" Margin="0,1" />
                                    <CheckBox Content="Wet-Coal Clearcoat" IsChecked="{Binding UnityEffects.EnableWetCoalClearcoat}" Foreground="#D4D4D8" FontSize="10.5" MinHeight="22" Margin="0,1" />
                                    <CheckBox Content="CAS Edge Sharpening" IsChecked="{Binding UnityEffects.EnableContrastSharpening}" Foreground="#D4D4D8" FontSize="10.5" MinHeight="22" Margin="0,1" />
                                    <CheckBox Content="Auto-Orbit Camera" IsChecked="{Binding UnityEffects.AutoOrbit}" Foreground="#D4D4D8" FontSize="10.5" MinHeight="22" Margin="0,1" />
                                    <CheckBox Content="Orthographic View" IsChecked="{Binding UnityEffects.IsOrthographic}" Foreground="#D4D4D8" FontSize="10.5" MinHeight="22" Margin="0,1" />
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <!-- Card 3: Blender 3D Asset Pipeline (Compact Wrap Chips, Zero Scroll) -->
                        <Border Grid.Row="2" Classes="scada-card" Padding="12,9">
                            <StackPanel Spacing="6">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBlock Text="BLENDER 3D ASSET PIPELINE" FontSize="10.5" FontWeight="Bold" Foreground="#A1A1AA" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="Generate GLB Models"
                                            Command="{Binding GenerateBlenderAssetsCommand}"
                                            IsEnabled="{Binding !IsGeneratingBlenderAssets}"
                                            Classes="primary-action"
                                            Padding="10,4"
                                            FontSize="10.5" />
                                </Grid>
                                <TextBlock Text="{Binding BlenderBuildStatus}" FontSize="10" Foreground="#A1A1AA" TextTrimming="CharacterEllipsis" />
                                <ItemsControl ItemsSource="{Binding Exported3DModels}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#241C0B" BorderBrush="#453517" BorderThickness="1" CornerRadius="4" Padding="5,2" Margin="0,0,4,4">
                                                <TextBlock Text="{Binding}" FontSize="9.5" FontWeight="SemiBold" Foreground="#F59E0B" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <!-- BOTTOM ALARM TICKER -->
        <Border Grid.Row="2" Background="#111113" BorderBrush="#27272A" BorderThickness="0,1,0,0" Padding="16,0">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <TextBlock Text="ALARM TICKER:" FontSize="11" FontWeight="Bold" Foreground="#F59E0B" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding LatestAlarmTicker}" FontSize="12" Foreground="#D4D4D8" VerticalAlignment="Center" />
            </Grid>
        </Border>

    </Grid>
</UserControl>
