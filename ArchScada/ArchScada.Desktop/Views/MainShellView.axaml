<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ArchScada.Desktop.ViewModels"
             xmlns:models="using:ArchScada.Desktop.Models"
             xmlns:controls="using:ArchScada.Desktop.Controls"
             xmlns:threed="using:ArchScada.Desktop.Controls.ThreeD"
             xmlns:conv="using:ArchScada.Desktop.Converters"
             x:Class="ArchScada.Desktop.Views.MainShellView"
             x:DataType="vm:MainShellViewModel">

    <Grid RowDefinitions="56,*,34" Background="#080D18">

        <!-- TOP STATUS BAR -->
        <Border Grid.Row="0" Background="#0B1220" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="16,0">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto" ColumnSpacing="14">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Ellipse Width="10" Height="10" Fill="#22C55E" />
                    <TextBlock Text="ARCH SCADA" FontSize="14" FontWeight="Bold" Foreground="#38BDF8" LetterSpacing="1.5" />
                    <TextBlock Text="|" Foreground="#334155" />
                    <TextBlock Text="{Binding CurrentSectionTitle}" FontSize="14" FontWeight="SemiBold" Foreground="#F1F5F9" />
                </StackPanel>

                <Border Grid.Column="2" Classes="safety-pill" VerticalAlignment="Center">
                    <TextBlock Text="READ-ONLY MODE (CONTROL DISABLED)" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" />
                </Border>

                <Border Grid.Column="3" Classes="scada-panel" CornerRadius="6" Padding="10,4" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ConnectionStatusLabel}" FontSize="11" Foreground="#94A3B8" />
                </Border>

                <Button Grid.Column="4"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="{x:Static models:PlantSection.AlarmsEvents}"
                        Background="#2A0F14"
                        BorderBrush="#EF4444"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="10,4"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse Width="8" Height="8" Fill="#EF4444" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding UnacknowledgedAlarmCount, StringFormat='Alarms: {0} Unack'}"
                                   FontSize="11" FontWeight="SemiBold" Foreground="#FCA5A5" />
                    </StackPanel>
                </Button>

                <TextBlock Grid.Column="5"
                           Text="{Binding CurrentTimeDisplay}"
                           FontSize="12"
                           Foreground="#94A3B8"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- BODY: LEFT NAV + MAIN CONTENT -->
        <Grid Grid.Row="1" ColumnDefinitions="215,*">

            <!-- LEFT NAVIGATION RAIL -->
            <Border Grid.Column="0" Background="#0B1220" BorderBrush="#1E293B" BorderThickness="0,0,1,0" Padding="8,10">
                <StackPanel Spacing="2">
                    <TextBlock Text="PLANT MONITORING" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="10,2,0,4" />

                    <Button Content="Plant Overview" Classes="nav-item" Padding="12,8"
                            Background="{Binding IsOverview, Converter={x:Static conv:BoolToActiveNavBrushConverter.Instance}}"
                            Command="{Binding NavigateCommand}" CommandParameter="{x:Static models:PlantSection.Overview}" />

                    <Button Content="Crushing &amp; Conveyors" Classes="nav-item" Padding="12,8"
                            Background="{Binding IsCrushing, Converter={x:Static conv:BoolToActiveNavBrushConverter.Instance}}"
                            Command="{Binding NavigateCommand}" CommandParameter="{x:Static models:PlantSection.CrushingConveyors}" />

                    <Button Content="Thickener Circuit" Classes="nav-item" Padding="12,8"
                            Background="{Binding IsThickener, Converter={x:Static conv:BoolToActiveNavBrushConverter.Instance}}"
                            Command="{Binding NavigateCommand}" CommandParameter="{x:Static models:PlantSection.ThickenerCircuit}" />

                    <Button Content="Magnetite Preparation" Classes="nav-item" Padding="12,8"
                            Background="{Binding IsMagnetite, Converter={x:Static conv:BoolToActiveNavBrushConverter.Instance}}"
                            Command="{Binding NavigateCommand}" CommandParameter="{x:Static models:PlantSection.MagnetitePrep}" />

                    <Button Content="Fine Coal &amp; Flotation" Classes="nav-item" Padding="12,8"
                            Background="{Binding IsFineCoal, Converter={x:Static conv:BoolToActiveNavBrushConverter.Instance}}"
                            Command="{Binding NavigateCommand}" CommandParameter="{x:Static models:PlantSection.FineCoalFlotation}" />

                    <Button Content="Dewatering &amp; Tailings" Classes="nav-item" Padding="12,8"
                            Background="{Binding IsDewatering, Converter={x:Static conv:BoolToActiveNavBrushConverter.Instance}}"
                            Command="{Binding NavigateCommand}" CommandParameter="{x:Static models:PlantSection.DewateringTailings}" />

                    <Button Content="ROM, Loadout &amp; PGNAA" Classes="nav-item" Padding="12,8"
                            Background="{Binding IsRomLoadout, Converter={x:Static conv:BoolToActiveNavBrushConverter.Instance}}"
                            Command="{Binding NavigateCommand}" CommandParameter="{x:Static models:PlantSection.RomLoadoutQuality}" />

                    <TextBlock Text="3D &amp; VISUALS" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="10,10,0,4" />

                    <Button Content="3D Digital Twin (Unity)" Classes="nav-item" Padding="12,8"
                            Background="{Binding IsDigitalTwin3D, Converter={x:Static conv:BoolToActiveNavBrushConverter.Instance}}"
                            Command="{Binding NavigateCommand}" CommandParameter="{x:Static models:PlantSection.DigitalTwin3D}" />

                    <TextBlock Text="OPERATIONS" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="10,10,0,4" />

                    <Button Content="Equipment &amp; Assets" Classes="nav-item" Padding="12,8"
                            Background="{Binding IsEquipmentAssets, Converter={x:Static conv:BoolToActiveNavBrushConverter.Instance}}"
                            Command="{Binding NavigateCommand}" CommandParameter="{x:Static models:PlantSection.EquipmentAssets}" />

                    <Button Content="Trends &amp; Historian" Classes="nav-item" Padding="12,8"
                            Background="{Binding IsTrends, Converter={x:Static conv:BoolToActiveNavBrushConverter.Instance}}"
                            Command="{Binding NavigateCommand}" CommandParameter="{x:Static models:PlantSection.TrendsHistorian}" />

                    <Button Content="Alarms &amp; Events" Classes="nav-item" Padding="12,8"
                            Background="{Binding IsAlarms, Converter={x:Static conv:BoolToActiveNavBrushConverter.Instance}}"
                            Command="{Binding NavigateCommand}" CommandParameter="{x:Static models:PlantSection.AlarmsEvents}" />

                    <Button Content="System Diagnostics" Classes="nav-item" Padding="12,8"
                            Background="{Binding IsDiagnostics, Converter={x:Static conv:BoolToActiveNavBrushConverter.Instance}}"
                            Command="{Binding NavigateCommand}" CommandParameter="{x:Static models:PlantSection.Diagnostics}" />
                </StackPanel>
            </Border>

            <!-- MAIN CONTENT AREA (Scrollable Standard Views) -->
            <ScrollViewer Grid.Column="1" IsVisible="{Binding !IsDigitalTwin3D}" Padding="22">
                <Panel>

                    <!-- 1. PLANT OVERVIEW -->
                    <StackPanel IsVisible="{Binding IsOverview}" Spacing="18">
                        <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="14">
                            <Border Grid.Column="0" Classes="scada-card">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="PLANT FEED TONNAGE" Classes="card-label" />
                                    <TextBlock Text="{Binding TotalFeedTonnageTph, StringFormat='{}{0:0.0} t/h'}" Classes="kpi-value" />
                                    <TextBlock Text="CR-101 Primary Jaw Crusher" FontSize="11" Foreground="#22C55E" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Classes="scada-card">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="TOTAL POWER DRAW" Classes="card-label" />
                                    <TextBlock Text="{Binding TotalPowerDrawKw, StringFormat='{}{0:0.0} kW'}" Classes="kpi-value" />
                                    <TextBlock Text="Across 23 monitored assets" FontSize="11" Foreground="#94A3B8" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Classes="scada-card">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="WATER RECOVERY" Classes="card-label" />
                                    <TextBlock Text="{Binding WaterRecoveryPercent, StringFormat='{}{0:0.0} %'}" Classes="kpi-value" />
                                    <TextBlock Text="TK-201 High-Rate Thickener" FontSize="11" Foreground="#38BDF8" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="3" Classes="scada-card">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="MEDIUM DENSITY" Classes="card-label" />
                                    <TextBlock Text="{Binding MediumSpecificGravity, StringFormat='{}{0:0.00} SG'}" Classes="kpi-value" />
                                    <TextBlock Text="TK-301 Magnetite Circuit" FontSize="11" Foreground="#F59E0B" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <TextBlock Text="Process Circuits" Classes="section-title" />
                        <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="14" RowSpacing="14">
                            <Border Grid.Row="0" Grid.Column="0" Classes="scada-card">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="Crushing &amp; Conveyors" FontSize="16" FontWeight="SemiBold" Foreground="#F1F5F9" />
                                    <TextBlock Text="CR-101, SC-102, CV-101, CV-102" FontSize="12" Foreground="#94A3B8" />
                                    <Button Content="Open Circuit View" Classes="secondary-action"
                                            Command="{Binding NavigateCommand}" CommandParameter="{x:Static models:PlantSection.CrushingConveyors}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="0" Grid.Column="1" Classes="scada-card">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="Thickener Circuit" FontSize="16" FontWeight="SemiBold" Foreground="#F1F5F9" />
                                    <TextBlock Text="TK-201, PP-201, PP-202, PP-203" FontSize="12" Foreground="#94A3B8" />
                                    <Button Content="Open Circuit View" Classes="secondary-action"
                                            Command="{Binding NavigateCommand}" CommandParameter="{x:Static models:PlantSection.ThickenerCircuit}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="0" Grid.Column="2" Classes="scada-card">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="Magnetite Preparation" FontSize="16" FontWeight="SemiBold" Foreground="#F1F5F9" />
                                    <TextBlock Text="TK-301, MS-301, DM-301" FontSize="12" Foreground="#94A3B8" />
                                    <Button Content="Open Circuit View" Classes="secondary-action"
                                            Command="{Binding NavigateCommand}" CommandParameter="{x:Static models:PlantSection.MagnetitePrep}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="0" Classes="scada-card">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="Fine Coal &amp; Flotation" FontSize="16" FontWeight="SemiBold" Foreground="#F1F5F9" />
                                    <TextBlock Text="SP-401, FC-401, AB-401, PP-401, PP-402" FontSize="12" Foreground="#94A3B8" />
                                    <Button Content="Open Circuit View" Classes="secondary-action"
                                            Command="{Binding NavigateCommand}" CommandParameter="{x:Static models:PlantSection.FineCoalFlotation}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="1" Classes="scada-card">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="Dewatering &amp; Tailings" FontSize="16" FontWeight="SemiBold" Foreground="#F1F5F9" />
                                    <TextBlock Text="CF-501, FP-501, CV-501" FontSize="12" Foreground="#94A3B8" />
                                    <Button Content="Open Circuit View" Classes="secondary-action"
                                            Command="{Binding NavigateCommand}" CommandParameter="{x:Static models:PlantSection.DewateringTailings}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="2" Classes="scada-card">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="ROM, Loadout &amp; PGNAA" FontSize="16" FontWeight="SemiBold" Foreground="#F1F5F9" />
                                    <TextBlock Text="AF-001, SL-601, AN-601, LD-601" FontSize="12" Foreground="#94A3B8" />
                                    <Button Content="Open Circuit View" Classes="secondary-action"
                                            Command="{Binding NavigateCommand}" CommandParameter="{x:Static models:PlantSection.RomLoadoutQuality}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- ACTIVE MICRO-OPTIMIZATION & EFFICIENCY -->
                        <Border Classes="scada-card">
                            <StackPanel Spacing="12">
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="14">
                                    <StackPanel>
                                        <TextBlock Text="Automated Closed-Loop Micro-Optimization (Read-Only / Simulated Trim)" FontSize="16" FontWeight="SemiBold" Foreground="#F1F5F9" />
                                        <TextBlock Text="Continuously monitors process setpoints (DMC SG, Thickener Turbidity, Flotation Dosing, Cake Moisture, Crusher Feed) and applies bounded micro-trims."
                                                   FontSize="12" Foreground="#94A3B8" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" Content="Auto Micro-Trim Active" IsChecked="{Binding IsAutoOptimizationEnabled}" Foreground="#22C55E" VerticalAlignment="Center" />
                                    <Button Grid.Column="2" Content="Apply Trim Now" Command="{Binding StepMicroOptimizationCommand}" Classes="secondary-action" Padding="12,6" FontSize="11" VerticalAlignment="Center" />
                                </Grid>

                                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="12">
                                    <Border Grid.Column="0" Classes="scada-panel">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="PLANT EFFICIENCY SCORE" Classes="card-label" />
                                            <TextBlock Text="{Binding PlantEfficiencyScorePercent, StringFormat='{}{0:0.00} %'}" FontSize="20" FontWeight="Bold" Foreground="#22C55E" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Classes="scada-panel">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="CLEAN COAL YIELD" Classes="card-label" />
                                            <TextBlock Text="{Binding CleanCoalYieldPercent, StringFormat='{}{0:0.00} %'}" FontSize="20" FontWeight="Bold" Foreground="#38BDF8" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Classes="scada-panel">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="SPECIFIC ENERGY" Classes="card-label" />
                                            <TextBlock Text="{Binding SpecificEnergyKwhPerTon, StringFormat='{}{0:0.00} kWh/t'}" FontSize="20" FontWeight="Bold" Foreground="#F1F5F9" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="3" Classes="scada-panel">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="MICRO-TRIMS APPLIED" Classes="card-label" />
                                            <TextBlock Text="{Binding TotalMicroTrimsApplied}" FontSize="20" FontWeight="Bold" Foreground="#F59E0B" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <ItemsControl ItemsSource="{Binding OptimizationLog}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Classes="scada-panel" Margin="0,2">
                                                <Grid ColumnDefinitions="70,190,65,190,*,Auto" ColumnSpacing="10">
                                                    <TextBlock Grid.Column="0" Text="{Binding TimeDisplay}" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding LoopName}" FontSize="11" FontWeight="SemiBold" Foreground="#F1F5F9" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2" Text="{Binding EquipmentId}" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="3" Text="{Binding ValueTransitionDisplay}" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="4" Text="{Binding EfficiencyGainSummary}" FontSize="11" Foreground="#22C55E" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="5" Text="{Binding AuditStatus}" FontSize="10" Foreground="#38BDF8" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Recent Alarms" Classes="section-title" />
                        <ItemsControl ItemsSource="{Binding Alarms}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Classes="scada-panel" Margin="0,3">
                                        <Grid ColumnDefinitions="12,80,140,*,Auto" ColumnSpacing="12">
                                            <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                                     Fill="{Binding Severity, Converter={x:Static conv:StatusToBrushConverter.Instance}}" />
                                            <TextBlock Grid.Column="1" Text="{Binding TimeDisplay}" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding Area}" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="{Binding Message}" FontSize="12" Foreground="#F1F5F9" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="4" Text="{Binding Severity}" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{Binding Severity, Converter={x:Static conv:StatusToBrushConverter.Instance}}" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- 2. CRUSHING & CONVEYORS -->
                    <StackPanel IsVisible="{Binding IsCrushing}" Spacing="14">
                        <TextBlock Text="Crushing &amp; Conveyor Circuit" Classes="section-title" />
                        <ItemsControl ItemsSource="{Binding CrushingEquipment}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Classes="scada-card" Width="320" Margin="0,0,14,14">
                                        <StackPanel Spacing="10">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Id}" FontSize="12" FontWeight="Bold" Foreground="#38BDF8" />
                                                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Foreground="#F1F5F9" />
                                                </StackPanel>
                                                <Border Grid.Column="1" Classes="scada-panel" CornerRadius="4" Padding="8,3" VerticalAlignment="Top">
                                                    <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="Bold"
                                                               Foreground="{Binding Status, Converter={x:Static conv:StatusToBrushConverter.Instance}}" />
                                                </Border>
                                            </Grid>
                                            <Grid ColumnDefinitions="*,*">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding PrimaryMetricLabel}" Classes="card-label" />
                                                    <TextBlock Text="{Binding PrimaryMetricDisplay}" FontSize="18" FontWeight="Bold" Foreground="#F1F5F9" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="Power Draw" Classes="card-label" />
                                                    <TextBlock Text="{Binding PowerKw, StringFormat='{}{0:0.0} kW'}" FontSize="18" FontWeight="Bold" Foreground="#94A3B8" />
                                                </StackPanel>
                                            </Grid>
                                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding LoadPercent}" Height="6" Foreground="#38BDF8" />
                                            <TextBlock Text="{Binding LoadPercent, StringFormat='Load: {0:0.0}%'}" FontSize="11" Foreground="#94A3B8" />
                                            <Border IsVisible="{Binding HasConveyorSafety}" Classes="scada-panel" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="4" Padding="8,6">
                                                <StackPanel Spacing="3">
                                                    <TextBlock Text="CONVEYOR SAFETY &amp; TRIP CASCADE" FontSize="10" FontWeight="Bold" Foreground="#38BDF8" />
                                                    <TextBlock Text="{Binding ConveyorSafetySummary}" FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- 3. THICKENER CIRCUIT -->
                    <StackPanel IsVisible="{Binding IsThickener}" Spacing="14">
                        <TextBlock Text="Thickener Circuit" Classes="section-title" />
                        <Border Classes="scada-card">
                            <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="24">
                                <controls:TankLevelControl Grid.Column="0"
                                                           Label="TK-201 Bed"
                                                           LevelPercent="{Binding ThickenerBedLevelPercent}"
                                                           HighHighLimit="92"
                                                           HighLimit="82"
                                                           LowLimit="20"
                                                           LowLowLimit="10"
                                                           Width="130" Height="160" />
                                <controls:ValveIndicatorControl Grid.Column="1"
                                                                Label="XV-201 Underflow"
                                                                State="{Binding ThickenerValveState}"
                                                                Width="110" Height="100"
                                                                VerticalAlignment="Center" />
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="6">
                                    <TextBlock Text="TK-201 High-Rate Thickener Instrumentation" FontSize="15" FontWeight="SemiBold" Foreground="#F1F5F9" />
                                    <TextBlock Text="{Binding ThickenerBedLevelPercent, StringFormat='Bed Level: {0:0.0} %'}" FontSize="13" Foreground="#38BDF8" />
                                    <TextBlock Text="{Binding WaterRecoveryPercent, StringFormat='Clarified Water Recovery: {0:0.0} %'}" FontSize="13" Foreground="#22C55E" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ItemsControl ItemsSource="{Binding ThickenerEquipment}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Classes="scada-card" Width="320" Margin="0,0,14,14">
                                        <StackPanel Spacing="10">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Id}" FontSize="12" FontWeight="Bold" Foreground="#38BDF8" />
                                                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Foreground="#F1F5F9" />
                                                </StackPanel>
                                                <Border Grid.Column="1" Classes="scada-panel" CornerRadius="4" Padding="8,3" VerticalAlignment="Top">
                                                    <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="Bold"
                                                               Foreground="{Binding Status, Converter={x:Static conv:StatusToBrushConverter.Instance}}" />
                                                </Border>
                                            </Grid>
                                            <Grid ColumnDefinitions="*,*">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding PrimaryMetricLabel}" Classes="card-label" />
                                                    <TextBlock Text="{Binding PrimaryMetricDisplay}" FontSize="18" FontWeight="Bold" Foreground="#F1F5F9" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="Power Draw" Classes="card-label" />
                                                    <TextBlock Text="{Binding PowerKw, StringFormat='{}{0:0.0} kW'}" FontSize="18" FontWeight="Bold" Foreground="#94A3B8" />
                                                </StackPanel>
                                            </Grid>
                                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding LoadPercent}" Height="6" Foreground="#22C55E" />
                                            <TextBlock Text="{Binding LoadPercent, StringFormat='Load: {0:0.0}%'}" FontSize="11" Foreground="#94A3B8" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- 4. MAGNETITE PREPARATION -->
                    <StackPanel IsVisible="{Binding IsMagnetite}" Spacing="14">
                        <TextBlock Text="Magnetite Preparation Circuit" Classes="section-title" />
                        <Border Classes="scada-card">
                            <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="24">
                                <controls:TankLevelControl Grid.Column="0"
                                                           Label="TK-301 Medium"
                                                           LevelPercent="{Binding MagnetiteTankLevelPercent}"
                                                           HighHighLimit="90"
                                                           HighLimit="80"
                                                           LowLimit="22"
                                                           LowLowLimit="12"
                                                           Width="130" Height="160" />
                                <controls:ValveIndicatorControl Grid.Column="1"
                                                                Label="XV-301 DMC Feed"
                                                                State="{Binding MagnetiteValveState}"
                                                                Width="110" Height="100"
                                                                VerticalAlignment="Center" />
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="6">
                                    <TextBlock Text="TK-301 Magnetite Medium Sump &amp; DMC Feed" FontSize="15" FontWeight="SemiBold" Foreground="#F1F5F9" />
                                    <TextBlock Text="{Binding MagnetiteTankLevelPercent, StringFormat='Medium Tank Level: {0:0.0} %'}" FontSize="13" Foreground="#38BDF8" />
                                    <TextBlock Text="{Binding MediumSpecificGravity, StringFormat='Medium Density: {0:0.00} SG'}" FontSize="13" Foreground="#F59E0B" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ItemsControl ItemsSource="{Binding MagnetiteEquipment}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Classes="scada-card" Width="320" Margin="0,0,14,14">
                                        <StackPanel Spacing="10">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Id}" FontSize="12" FontWeight="Bold" Foreground="#38BDF8" />
                                                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Foreground="#F1F5F9" />
                                                </StackPanel>
                                                <Border Grid.Column="1" Classes="scada-panel" CornerRadius="4" Padding="8,3" VerticalAlignment="Top">
                                                    <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="Bold"
                                                               Foreground="{Binding Status, Converter={x:Static conv:StatusToBrushConverter.Instance}}" />
                                                </Border>
                                            </Grid>
                                            <Grid ColumnDefinitions="*,*">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding PrimaryMetricLabel}" Classes="card-label" />
                                                    <TextBlock Text="{Binding PrimaryMetricDisplay}" FontSize="18" FontWeight="Bold" Foreground="#F1F5F9" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="Power Draw" Classes="card-label" />
                                                    <TextBlock Text="{Binding PowerKw, StringFormat='{}{0:0.0} kW'}" FontSize="18" FontWeight="Bold" Foreground="#94A3B8" />
                                                </StackPanel>
                                            </Grid>
                                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding LoadPercent}" Height="6" Foreground="#F59E0B" />
                                            <TextBlock Text="{Binding LoadPercent, StringFormat='Load: {0:0.0}%'}" FontSize="11" Foreground="#94A3B8" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- 4B. FINE COAL & FROTH FLOTATION -->
                    <StackPanel IsVisible="{Binding IsFineCoal}" Spacing="14">
                        <TextBlock Text="Fine Coal &amp; Froth Flotation" Classes="section-title" />
                        <ItemsControl ItemsSource="{Binding FlotationEquipment}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Classes="scada-card" Width="320" Margin="0,0,14,14">
                                        <StackPanel Spacing="10">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Id}" FontSize="12" FontWeight="Bold" Foreground="#38BDF8" />
                                                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Foreground="#F1F5F9" />
                                                </StackPanel>
                                                <Border Grid.Column="1" Classes="scada-panel" CornerRadius="4" Padding="8,3" VerticalAlignment="Top">
                                                    <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="Bold"
                                                               Foreground="{Binding Status, Converter={x:Static conv:StatusToBrushConverter.Instance}}" />
                                                </Border>
                                            </Grid>
                                            <Grid ColumnDefinitions="*,*">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding PrimaryMetricLabel}" Classes="card-label" />
                                                    <TextBlock Text="{Binding PrimaryMetricDisplay}" FontSize="18" FontWeight="Bold" Foreground="#F1F5F9" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="Power Draw" Classes="card-label" />
                                                    <TextBlock Text="{Binding PowerKw, StringFormat='{}{0:0.0} kW'}" FontSize="18" FontWeight="Bold" Foreground="#94A3B8" />
                                                </StackPanel>
                                            </Grid>
                                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding LoadPercent}" Height="6" Foreground="#38BDF8" />
                                            <TextBlock Text="{Binding LoadPercent, StringFormat='Load: {0:0.0}%'}" FontSize="11" Foreground="#94A3B8" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- 4C. DEWATERING & TAILINGS -->
                    <StackPanel IsVisible="{Binding IsDewatering}" Spacing="14">
                        <TextBlock Text="Dewatering &amp; Tailings" Classes="section-title" />
                        <ItemsControl ItemsSource="{Binding DewateringEquipment}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Classes="scada-card" Width="320" Margin="0,0,14,14">
                                        <StackPanel Spacing="10">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Id}" FontSize="12" FontWeight="Bold" Foreground="#38BDF8" />
                                                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Foreground="#F1F5F9" />
                                                </StackPanel>
                                                <Border Grid.Column="1" Classes="scada-panel" CornerRadius="4" Padding="8,3" VerticalAlignment="Top">
                                                    <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="Bold"
                                                               Foreground="{Binding Status, Converter={x:Static conv:StatusToBrushConverter.Instance}}" />
                                                </Border>
                                            </Grid>
                                            <Grid ColumnDefinitions="*,*">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding PrimaryMetricLabel}" Classes="card-label" />
                                                    <TextBlock Text="{Binding PrimaryMetricDisplay}" FontSize="18" FontWeight="Bold" Foreground="#F1F5F9" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="Power Draw" Classes="card-label" />
                                                    <TextBlock Text="{Binding PowerKw, StringFormat='{}{0:0.0} kW'}" FontSize="18" FontWeight="Bold" Foreground="#94A3B8" />
                                                </StackPanel>
                                            </Grid>
                                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding LoadPercent}" Height="6" Foreground="#A855F7" />
                                            <TextBlock Text="{Binding LoadPercent, StringFormat='Load: {0:0.0}%'}" FontSize="11" Foreground="#94A3B8" />
                                            <Border IsVisible="{Binding HasConveyorSafety}" Classes="scada-panel" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="4" Padding="8,6">
                                                <StackPanel Spacing="3">
                                                    <TextBlock Text="CONVEYOR SAFETY &amp; TRIP CASCADE" FontSize="10" FontWeight="Bold" Foreground="#38BDF8" />
                                                    <TextBlock Text="{Binding ConveyorSafetySummary}" FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- 4D. ROM, LOADOUT & PGNAA -->
                    <StackPanel IsVisible="{Binding IsRomLoadout}" Spacing="14">
                        <TextBlock Text="ROM, Loadout &amp; PGNAA Online Quality" Classes="section-title" />
                        <ItemsControl ItemsSource="{Binding RomLoadoutEquipment}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Classes="scada-card" Width="320" Margin="0,0,14,14">
                                        <StackPanel Spacing="10">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Id}" FontSize="12" FontWeight="Bold" Foreground="#38BDF8" />
                                                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Foreground="#F1F5F9" />
                                                </StackPanel>
                                                <Border Grid.Column="1" Classes="scada-panel" CornerRadius="4" Padding="8,3" VerticalAlignment="Top">
                                                    <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="Bold"
                                                               Foreground="{Binding Status, Converter={x:Static conv:StatusToBrushConverter.Instance}}" />
                                                </Border>
                                            </Grid>
                                            <Grid ColumnDefinitions="*,*">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding PrimaryMetricLabel}" Classes="card-label" />
                                                    <TextBlock Text="{Binding PrimaryMetricDisplay}" FontSize="18" FontWeight="Bold" Foreground="#F1F5F9" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="Power Draw" Classes="card-label" />
                                                    <TextBlock Text="{Binding PowerKw, StringFormat='{}{0:0.0} kW'}" FontSize="18" FontWeight="Bold" Foreground="#94A3B8" />
                                                </StackPanel>
                                            </Grid>
                                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding LoadPercent}" Height="6" Foreground="#10B981" />
                                            <TextBlock Text="{Binding LoadPercent, StringFormat='Load: {0:0.0}%'}" FontSize="11" Foreground="#94A3B8" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- 6. EQUIPMENT & ASSETS INSPECTOR -->
                    <StackPanel IsVisible="{Binding IsEquipmentAssets}" Spacing="14">
                        <TextBlock Text="Equipment &amp; Assets Inspector" Classes="section-title" />
                        <Grid ColumnDefinitions="*,1.2*" ColumnSpacing="16">
                            <ListBox Grid.Column="0" ItemsSource="{Binding Equipment}" SelectedItem="{Binding SelectedEquipment}"
                                     Background="#0B1220" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" MaxHeight="520">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="12,80,*,Auto" ColumnSpacing="10" Margin="4">
                                            <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                                     Fill="{Binding Status, Converter={x:Static conv:StatusToBrushConverter.Instance}}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Id}" FontWeight="Bold" Foreground="#38BDF8" />
                                            <TextBlock Grid.Column="2" Text="{Binding Name}" Foreground="#F1F5F9" />
                                            <TextBlock Grid.Column="3" Text="{Binding PrimaryMetricDisplay}" Foreground="#94A3B8" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Border Grid.Column="1" Classes="scada-card" DataContext="{Binding SelectedEquipment}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="Bold" Foreground="#F1F5F9" />
                                    <TextBlock Text="{Binding Area, StringFormat='Area: {0}'}" FontSize="12" Foreground="#94A3B8" />
                                    <TextBlock Text="{Binding InterlockSummary}" FontSize="12" Foreground="#38BDF8" />
                                    <TextBlock Text="Live Tags" FontSize="14" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,6,0,0" />
                                    <ItemsControl ItemsSource="{Binding Tags}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Classes="scada-panel" Margin="0,3">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock Text="{Binding Name}" Foreground="#94A3B8" />
                                                        <TextBlock Grid.Column="1" Text="{Binding FormattedValue}" FontWeight="Bold" Foreground="#F1F5F9" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <!-- 7. TRENDS & HISTORIAN -->
                    <StackPanel IsVisible="{Binding IsTrends}" Spacing="14">
                        <TextBlock Text="Live Trends &amp; Local Historian" Classes="section-title" />
                        <ComboBox ItemsSource="{Binding AllTags}" SelectedItem="{Binding SelectedTrendTag}" Width="340">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Border Classes="scada-card">
                            <StackPanel Spacing="10">
                                <TextBlock Text="{Binding SelectedTrendTag.Name}" FontSize="15" FontWeight="SemiBold" Foreground="#F1F5F9" />
                                <TextBlock Text="{Binding SelectedTrendTag.FormattedValue, StringFormat='Current Value: {0}'}" FontSize="13" Foreground="#38BDF8" />
                                <controls:TrendChartControl Values="{Binding SelectedTrendValues}" Height="280" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 8. ALARMS & EVENTS -->
                    <StackPanel IsVisible="{Binding IsAlarms}" Spacing="14">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                            <TextBlock Text="Alarms &amp; Events (ISA-18.2 State Machine)" Classes="section-title" />
                            <Button Grid.Column="1" Content="Silence Horn" Command="{Binding SilenceHornCommand}" Classes="secondary-action" />
                            <Button Grid.Column="2" Content="Acknowledge All (Local)" Command="{Binding AcknowledgeAllAlarmsCommand}" Classes="secondary-action" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Alarms}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Classes="scada-card" Margin="0,4">
                                        <Grid ColumnDefinitions="14,90,150,*,Auto,Auto,Auto" ColumnSpacing="12">
                                            <Ellipse Width="10" Height="10" VerticalAlignment="Center"
                                                     Fill="{Binding Severity, Converter={x:Static conv:StatusToBrushConverter.Instance}}" />
                                            <TextBlock Grid.Column="1" Text="{Binding TimeDisplay}" Foreground="#94A3B8" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding Area}" Foreground="#94A3B8" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="{Binding Message}" Foreground="#F1F5F9" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="4" Text="{Binding Severity}" FontWeight="Bold"
                                                       Foreground="{Binding Severity, Converter={x:Static conv:StatusToBrushConverter.Instance}}" VerticalAlignment="Center" />
                                            <Button Grid.Column="5" Content="Ack"
                                                    IsEnabled="{Binding !IsAcknowledged}"
                                                    Command="{Binding $parent[UserControl].((vm:MainShellViewModel)DataContext).AcknowledgeAlarmCommand}"
                                                    CommandParameter="{Binding}"
                                                    Classes="secondary-action" Padding="10,4" />
                                            <Button Grid.Column="6" Content="Shelve 15m"
                                                    Command="{Binding $parent[UserControl].((vm:MainShellViewModel)DataContext).ShelveAlarmCommand}"
                                                    CommandParameter="{Binding}"
                                                    Classes="secondary-action" Padding="10,4" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- 9. SYSTEM DIAGNOSTICS -->
                    <StackPanel IsVisible="{Binding IsDiagnostics}" Spacing="14">
                        <TextBlock Text="System &amp; Driver Diagnostics" Classes="section-title" />
                        <Border Classes="scada-card">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{Binding ConnectionStatusLabel, StringFormat='SCADA Core: {0}'}" Foreground="#F1F5F9" />
                                <TextBlock Text="{Binding NativeProtocolStatus, StringFormat='Native ScadaClient Protocol: {0}'}" Foreground="#38BDF8" />
                                <TextBlock Text="{Binding ControlModeSummary, StringFormat='Control Boundary: {0}'}" Foreground="#22C55E" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding OperatorBadge, StringFormat='Active Operator Session: {0}'}" Foreground="#F59E0B" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding UnityStreamStatus, StringFormat='Unity 3D Bridge: {0}'}" Foreground="#38BDF8" />
                                <TextBlock Text="{Binding UnityBridge.IsBlenderInstalled, StringFormat='Blender Installed: {0}'}" Foreground="#94A3B8" />
                                <TextBlock Text="{Binding UnityBridge.IsUnityHubInstalled, StringFormat='Unity Hub Installed: {0}'}" Foreground="#94A3B8" />
                                <TextBlock Text="{Binding UnityBridge.AssetsExportDirectory, StringFormat='3D Export Directory: {0}'}" Foreground="#94A3B8" />
                            </StackPanel>
                        </Border>
                        <Border Classes="scada-card">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Operator Authentication, RBAC &amp; Electronic Shift Handover" FontSize="15" FontWeight="SemiBold" Foreground="#F1F5F9" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Operator (J. Mokoena)" Command="{Binding SwitchOperatorCommand}" CommandParameter="operator1" Classes="secondary-action" Padding="10,6" FontSize="11" />
                                    <Button Content="Shift Supervisor (S. Nkosi)" Command="{Binding SwitchOperatorCommand}" CommandParameter="supervisor1" Classes="secondary-action" Padding="10,6" FontSize="11" />
                                    <Button Content="C&amp;I Engineer (T. van Wyk)" Command="{Binding SwitchOperatorCommand}" CommandParameter="engineer1" Classes="secondary-action" Padding="10,6" FontSize="11" />
                                    <Button Content="Observer (Read-Only)" Command="{Binding SwitchOperatorCommand}" CommandParameter="viewer1" Classes="secondary-action" Padding="10,6" FontSize="11" />
                                </StackPanel>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBox Text="{Binding HandoverNoteDraft}" PlaceholderText="Enter shift handover log note..." />
                                    <Button Grid.Column="1" Content="Log Handover Note" Command="{Binding AddHandoverNoteCommand}" Classes="primary-action" Padding="12,8" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding HandoverLog}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Classes="scada-panel" Margin="0,2">
                                                <Grid ColumnDefinitions="140,140,*" ColumnSpacing="10">
                                                    <TextBlock Grid.Column="0" Text="{Binding TimeDisplay}" FontSize="11" Foreground="#94A3B8" />
                                                    <TextBlock Grid.Column="1" Text="{Binding RoleDisplay}" FontSize="11" FontWeight="SemiBold" Foreground="#38BDF8" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Note}" FontSize="11" Foreground="#F1F5F9" TextWrapping="Wrap" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <Border Classes="scada-card">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Control Safety Boundary (Simulated Audit)" FontSize="15" FontWeight="SemiBold" Foreground="#F1F5F9" />
                                <TextBlock Text="Executes a read-only / simulated Cause-and-Effect interlock audit via ControlBoundaryEngine without actuating real plant hardware." FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap" />
                                <Button Content="Run Simulated Control Audit" Command="{Binding RunSimulatedControlAuditCommand}" Classes="secondary-action" HorizontalAlignment="Left" />
                                <TextBlock Text="{Binding LastControlAuditResult}" FontSize="12" Foreground="#38BDF8" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                </Panel>
            </ScrollViewer>

            <!-- 3D DIGITAL TWIN SINGLE-PAGE WORKSPACE (ZERO SCROLLING) -->
            <Grid Grid.Column="1" IsVisible="{Binding IsDigitalTwin3D}" RowDefinitions="Auto,*" Margin="14,10" RowSpacing="8">
                <!-- Row 0: Unified Single-Line Header & Node Selection Bar -->
                <Border Grid.Row="0" Classes="scada-card" Padding="12,8">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="3D Digital Twin" FontSize="16" FontWeight="Bold" Foreground="#F1F5F9" VerticalAlignment="Center" />
                            <Border Background="#2A1C08" BorderBrush="#D97706" BorderThickness="1" CornerRadius="6" Padding="8,2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding TelemetrySourceBadgeText}" FontSize="10.5" FontWeight="Bold" Foreground="#FBBF24" />
                            </Border>
                            <TextBlock Text="Read-only · Zero PLC Write" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Button Content="◀ Prev" Command="{Binding SelectPrev3DNodeCommand}" Classes="secondary-action" Padding="9,4" FontSize="11" />
                            <Button Content="Next ▶" Command="{Binding SelectNext3DNodeCommand}" Classes="secondary-action" Padding="9,4" FontSize="11" />
                            <ComboBox ItemsSource="{Binding All3DNodes}" SelectedItem="{Binding Selected3DNode}" MinWidth="220" Padding="8,4" FontSize="11">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="threed:Plant3DNode">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{Binding Id}" FontWeight="Bold" Foreground="#38BDF8" />
                                            <TextBlock Text="·" Foreground="#64748B" />
                                            <TextBlock Text="{Binding GaLabel}" Foreground="#E2E8F0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Content="Focus (F)" Command="{Binding FocusSelected3DCommand}" Classes="primary-action" Padding="10,4" FontSize="11" />
                            <Button Content="Focus Alarm" Command="{Binding FocusActiveAlarm3DCommand}" Classes="secondary-action" Padding="10,4" FontSize="11" />
                        </StackPanel>

                        <Border Grid.Column="2" Classes="scada-panel" Padding="8,4" VerticalAlignment="Center">
                            <TextBlock Text="{Binding UnityStreamStatus}" FontSize="11" Foreground="#22C55E" />
                        </Border>
                    </Grid>
                </Border>

                <!-- Row 1: Responsive Full-Height 3D Viewport + Zero-Scroll 3-Card Side Menu -->
                <Grid Grid.Row="1" ColumnDefinitions="*,395" ColumnSpacing="10">
                    <!-- Left: Auto-Stretching OpenGL Viewport & Single-Row Camera Presets -->
                    <Border Grid.Column="0" Classes="scada-card" Padding="10">
                        <Grid RowDefinitions="*,Auto" RowSpacing="8">
                            <controls:Plant3DViewportControl
                                Grid.Row="0"
                                x:Name="Plant3DViewport"
                                Equipment="{Binding Equipment}"
                                Effects="{Binding UnityEffects}"
                                CameraPreset="{Binding UnityEffects.CameraPreset}"
                                SelectedEquipment="{Binding SelectedEquipment, Mode=TwoWay}"
                                Selected3DNode="{Binding Selected3DNode, Mode=TwoWay}"
                                FocusTargetId="{Binding FocusTargetId}"
                                TelemetrySourceBadge="{Binding TelemetrySourceBadgeText}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch" />

                            <Grid Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Border Background="#0F243C" BorderBrush="#1E3A5F" BorderThickness="1" CornerRadius="6" Padding="8,4" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding UnityEffects.CameraPreset, StringFormat='Camera: {0}'}"
                                               FontSize="11" FontWeight="SemiBold" Foreground="#38BDF8" />
                                </Border>
                                <ItemsControl Grid.Column="1" ItemsSource="{Binding CameraPresets}" VerticalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding}" Classes="secondary-action" Padding="8,4" FontSize="10.5"
                                                    Margin="0,0,5,2"
                                                    Command="{Binding $parent[UserControl].((vm:MainShellViewModel)DataContext).SetCameraPresetCommand}"
                                                    CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Right: Zero-Scroll Side Menu (3 Compact Cards Fit 100% On Screen) -->
                    <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*" RowSpacing="8">
                        <!-- Card 1: Equipment Identification & Process Flow -->
                        <Border Grid.Row="0" Classes="scada-card" Padding="12,9">
                            <StackPanel Spacing="5">
                                <TextBlock Text="EQUIPMENT IDENTIFICATION &amp; PROCESS FLOW" FontSize="10.5" FontWeight="Bold" Foreground="#94A3B8" />

                                <Grid ColumnDefinitions="*,Auto" DataContext="{Binding Selected3DNode}">
                                    <TextBlock Text="{Binding Id}" FontSize="15" FontWeight="Bold" Foreground="#38BDF8" />
                                    <TextBlock Grid.Column="1" Text="{Binding EquipmentType}" FontSize="10.5" FontWeight="SemiBold" Foreground="#94A3B8" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock DataContext="{Binding Selected3DNode}" Text="{Binding GaLabel}" FontSize="13" FontWeight="Bold" Foreground="#F1F5F9" TextTrimming="CharacterEllipsis" />
                                <TextBlock DataContext="{Binding Selected3DNode}" Text="{Binding StageLabel}" FontSize="10.5" FontWeight="SemiBold" Foreground="#38BDF8" TextTrimming="CharacterEllipsis" />

                                <Grid ColumnDefinitions="*,*" ColumnSpacing="6" DataContext="{Binding Selected3DNode}">
                                    <Border Grid.Column="0" Classes="scada-panel" Padding="6,4">
                                        <StackPanel Spacing="1">
                                            <TextBlock Text="MATERIAL FLOW" FontSize="9" FontWeight="Bold" Foreground="#64748B" />
                                            <TextBlock Text="{Binding FlowSummary}" FontSize="10.5" FontWeight="SemiBold" Foreground="#E2E8F0" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Classes="scada-panel" Padding="6,4">
                                        <StackPanel Spacing="1">
                                            <TextBlock Text="PLC / SCADA CHANNEL" FontSize="9" FontWeight="Bold" Foreground="#64748B" />
                                            <TextBlock Text="{Binding PlcChannelMapping}" FontSize="10" FontWeight="SemiBold" Foreground="#38BDF8" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Border Background="#0B1220" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="5" Padding="6,4" DataContext="{Binding Selected3DNode}">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding ProvisionalConfigNote}" FontSize="10" FontWeight="SemiBold" Foreground="#CBD5E1" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding DimensionsSpec, StringFormat='Spec: {0}'}" FontSize="10" Foreground="#94A3B8" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding MechanicalPrinciple}" FontSize="10" Foreground="#64748B" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Border>

                                <Border BorderBrush="#1E293B" BorderThickness="0,1,0,0" Padding="0,4,0,0" DataContext="{Binding SelectedEquipment}">
                                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10">
                                        <TextBlock Grid.Column="0" Text="{Binding Id, StringFormat='SCADA: {0}'}" FontSize="11" FontWeight="SemiBold" Foreground="#38BDF8" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Status}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"
                                                   Foreground="{Binding Status, Converter={x:Static conv:StatusToBrushConverter.Instance}}" />
                                        <TextBlock Grid.Column="2" Text="{Binding PowerKw, StringFormat='{}{0:0.0} kW'}" FontSize="10.5" Foreground="#94A3B8" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Text="{Binding LoadPercent, StringFormat='Load {0:0}%'}" FontSize="10.5" Foreground="#F1F5F9" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Card 2: Compact 2-Column 3D Physics, Camera & FX Grid (14 Toggles) -->
                        <Border Grid.Row="1" Classes="scada-card" Padding="12,9">
                            <StackPanel Spacing="4">
                                <TextBlock Text="3D PHYSICS, CAMERA &amp; FX" FontSize="10.5" FontWeight="Bold" Foreground="#94A3B8" />
                                <UniformGrid Columns="2" Rows="7">
                                    <CheckBox Content="Equipment Tags" IsChecked="{Binding UnityEffects.ShowEquipmentLabels}" Foreground="#CBD5E1" FontSize="10.5" MinHeight="22" Margin="0,1" />
                                    <CheckBox Content="Flow Arrows (&gt;&gt;&gt;)" IsChecked="{Binding UnityEffects.ShowFlowDirection}" Foreground="#CBD5E1" FontSize="10.5" MinHeight="22" Margin="0,1" />
                                    <CheckBox Content="Flow Particles" IsChecked="{Binding UnityEffects.ShowFlowParticles}" Foreground="#CBD5E1" FontSize="10.5" MinHeight="22" Margin="0,1" />
                                    <CheckBox Content="Thermal Heatmap" IsChecked="{Binding UnityEffects.ShowThermalHeatmap}" Foreground="#CBD5E1" FontSize="10.5" MinHeight="22" Margin="0,1" />
                                    <CheckBox Content="Alarm Halos" IsChecked="{Binding UnityEffects.ShowAlarmHalos}" Foreground="#CBD5E1" FontSize="10.5" MinHeight="22" Margin="0,1" />
                                    <CheckBox Content="Animate Mechanics" IsChecked="{Binding UnityEffects.AnimateConveyors}" Foreground="#CBD5E1" FontSize="10.5" MinHeight="22" Margin="0,1" />
                                    <CheckBox Content="3-Axis Vibration" IsChecked="{Binding UnityEffects.EnableVibrationPhysics}" Foreground="#CBD5E1" FontSize="10.5" MinHeight="22" Margin="0,1" />
                                    <CheckBox Content="Ground Shadows" IsChecked="{Binding UnityEffects.ShowGroundShadows}" Foreground="#CBD5E1" FontSize="10.5" MinHeight="22" Margin="0,1" />
                                    <CheckBox Content="Bilateral GTAO" IsChecked="{Binding UnityEffects.EnableAmbientOcclusion}" Foreground="#CBD5E1" FontSize="10.5" MinHeight="22" Margin="0,1" />
                                    <CheckBox Content="Dust &amp; Water Sprays" IsChecked="{Binding UnityEffects.ShowDustAndSprayPlumes}" Foreground="#CBD5E1" FontSize="10.5" MinHeight="22" Margin="0,1" />
                                    <CheckBox Content="Wet-Coal Clearcoat" IsChecked="{Binding UnityEffects.EnableWetCoalClearcoat}" Foreground="#CBD5E1" FontSize="10.5" MinHeight="22" Margin="0,1" />
                                    <CheckBox Content="CAS Edge Sharpening" IsChecked="{Binding UnityEffects.EnableContrastSharpening}" Foreground="#CBD5E1" FontSize="10.5" MinHeight="22" Margin="0,1" />
                                    <CheckBox Content="Auto-Orbit Camera" IsChecked="{Binding UnityEffects.AutoOrbit}" Foreground="#CBD5E1" FontSize="10.5" MinHeight="22" Margin="0,1" />
                                    <CheckBox Content="Orthographic View" IsChecked="{Binding UnityEffects.IsOrthographic}" Foreground="#CBD5E1" FontSize="10.5" MinHeight="22" Margin="0,1" />
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <!-- Card 3: Blender 3D Asset Pipeline (Compact Wrap Chips, Zero Scroll) -->
                        <Border Grid.Row="2" Classes="scada-card" Padding="12,9">
                            <StackPanel Spacing="6">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBlock Text="BLENDER 3D ASSET PIPELINE" FontSize="10.5" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="Generate GLB Models"
                                            Command="{Binding GenerateBlenderAssetsCommand}"
                                            IsEnabled="{Binding !IsGeneratingBlenderAssets}"
                                            Classes="primary-action"
                                            Padding="10,4"
                                            FontSize="10.5" />
                                </Grid>
                                <TextBlock Text="{Binding BlenderBuildStatus}" FontSize="10" Foreground="#94A3B8" TextTrimming="CharacterEllipsis" />
                                <ItemsControl ItemsSource="{Binding Exported3DModels}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#0F243C" BorderBrush="#1E3A5F" BorderThickness="1" CornerRadius="4" Padding="5,2" Margin="0,0,4,4">
                                                <TextBlock Text="{Binding}" FontSize="9.5" FontWeight="SemiBold" Foreground="#38BDF8" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <!-- BOTTOM ALARM TICKER -->
        <Border Grid.Row="2" Background="#0B1220" BorderBrush="#1E293B" BorderThickness="0,1,0,0" Padding="16,0">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <TextBlock Text="ALARM TICKER:" FontSize="11" FontWeight="Bold" Foreground="#F59E0B" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding LatestAlarmTicker}" FontSize="12" Foreground="#CBD5E1" VerticalAlignment="Center" />
            </Grid>
        </Border>

    </Grid>
</UserControl>
