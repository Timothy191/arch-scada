<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ArchScada.Desktop.ViewModels"
             xmlns:models="using:ArchScada.Desktop.Models"
             xmlns:controls="using:ArchScada.Desktop.Controls"
             xmlns:conv="using:ArchScada.Desktop.Converters"
             x:Class="ArchScada.Desktop.Views.SplashView"
             x:DataType="vm:SplashViewModel">

    <Grid Background="Transparent" Margin="10">
        <Border Classes="splash-card"
                MaxWidth="672"
                Padding="26,20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel Spacing="11" HorizontalAlignment="Stretch">

                <!-- Procedural motion-graphics intro (plays once on open) -->
                <controls:IntroAnimationControl x:Name="IntroAnimation"
                                                Height="132"
                                                HorizontalAlignment="Stretch" />

                <!-- Header: Brand Badge + Title + Version -->
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <Panel Width="48" Height="48" VerticalAlignment="Center">
                        <!-- Slow ambient outer ring -->
                        <Arc Classes="splash-brand-ring"
                             StartAngle="0" SweepAngle="270"
                             Stroke="#D97706" StrokeThickness="2"
                             Width="46" Height="46"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <!-- Pulsing brand badge with Official Golden Arch Linux Logo -->
                        <Border Classes="splash-brand-badge"
                                Width="40" Height="40"
                                CornerRadius="12"
                                Background="#14120B"
                                BorderBrush="#F59E0B"
                                BorderThickness="1"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Panel>
                                <Ellipse Classes="splash-core-dot" Fill="#F59E0B" Width="6" Height="6"
                                         HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,3,0" />
                                <Image Source="avares://ArchScada.Desktop/Assets/archlinux-logo.png"
                                       Width="30" Height="30"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Panel>
                        </Border>
                    </Panel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{Binding AppTitle}"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="#FBBF24" />
                        <TextBlock Text="{Binding AppSubtitle}"
                                   FontSize="12"
                                   FontWeight="Medium"
                                   Foreground="#A1A1AA" />
                    </StackPanel>

                    <Border Grid.Column="2"
                            Background="#141418"
                            BorderBrush="#27272A"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="8,4"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding VersionLabel}"
                                   FontSize="10"
                                   FontWeight="Medium"
                                   Foreground="#FBBF24" />
                    </Border>
                </Grid>

                <!-- Readiness Summary Banner -->
                <Border Background="#141418"
                        BorderBrush="#453517"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="14,10">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Ellipse Classes="splash-status-dot"
                                 Width="12" Height="12"
                                 VerticalAlignment="Center"
                                 Fill="{Binding ReadinessState, Converter={x:Static conv:StatusToBrushConverter.Instance}}" />
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="{Binding ReadinessBannerTitle}"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="#FAFAFA" />
                            <TextBlock Text="{Binding ReadinessBannerDetail}"
                                       FontSize="11"
                                       Foreground="#A1A1AA" />
                        </StackPanel>
                        <TextBlock Grid.Column="2"
                                   Text="{Binding ProgressText}"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="#F59E0B"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Progress Bar & Active Step Text -->
                <StackPanel Spacing="4" HorizontalAlignment="Center" Width="560">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <!-- Indeterminate processing arc, visible only while checks run -->
                        <Panel Grid.Column="0" Width="18" Height="18" VerticalAlignment="Center"
                               IsVisible="{Binding IsRunning}">
                            <Arc Classes="splash-processing-arc"
                                 StartAngle="0" SweepAngle="270"
                                 Stroke="#F59E0B" StrokeThickness="2.5"
                                 Width="18" Height="18"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Panel>
                        <Border Grid.Column="1" Width="560" Height="6"
                                CornerRadius="3"
                                Background="#27272A"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center">
                            <Border Classes="splash-progress-fill"
                                    Width="{Binding Progress, Converter={x:Static conv:ProgressToWidthConverter.Instance}, ConverterParameter=5.6}"
                                    Height="6"
                                    CornerRadius="3"
                                    Background="#F59E0B"
                                    HorizontalAlignment="Left" />
                        </Border>
                    </Grid>
                    <TextBlock Text="{Binding StatusText}"
                               FontSize="11"
                               FontWeight="Medium"
                               Foreground="#A1A1AA"
                               TextTrimming="CharacterEllipsis"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <!-- 8-Point Deployment Requirements Verification List -->
                <ScrollViewer MaxHeight="470" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Checks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:StartupCheckItem">
                                <Border Classes="splash-check-row"
                                        Background="#141418"
                                        BorderBrush="#27272A"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="10,6"
                                        Margin="0,2">
                                    <Grid ColumnDefinitions="12,Auto,*,Auto,Auto" ColumnSpacing="10">
                                        <Ellipse Width="9" Height="9"
                                                 VerticalAlignment="Center"
                                                 Fill="{Binding State, Converter={x:Static conv:StatusToBrushConverter.Instance}}" />

                                        <Border Grid.Column="1"
                                                Background="#241C0B"
                                                BorderBrush="#D97706"
                                                BorderThickness="1"
                                                CornerRadius="5"
                                                Padding="6,2"
                                                Width="64"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Category}"
                                                       FontSize="9"
                                                       FontWeight="Bold"
                                                       Foreground="#FBBF24"
                                                       HorizontalAlignment="Center" />
                                        </Border>

                                        <StackPanel Grid.Column="2" Spacing="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="#FAFAFA" />
                                            <TextBlock Text="{Binding Detail}"
                                                       FontSize="11"
                                                       Foreground="#A1A1AA"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding DurationText}"
                                                   FontSize="10"
                                                   Foreground="#71717A"
                                                   VerticalAlignment="Center" />

                                        <Border Grid.Column="4"
                                                Background="#0D0D0F"
                                                BorderBrush="#27272A"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="8,2"
                                                MinWidth="66"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding StateLabel}"
                                                       FontSize="10"
                                                       FontWeight="Bold"
                                                       Foreground="{Binding State, Converter={x:Static conv:StatusToBrushConverter.Instance}}"
                                                       HorizontalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Border Classes="divider" Margin="0,2" />

                <!-- Footer Action Bar -->
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                    <CheckBox IsChecked="{Binding HoldOnSplash}"
                              Content="Hold screen to inspect results"
                              FontSize="11"
                              Foreground="#D4D4D8"
                              VerticalAlignment="Center" />

                    <Button Grid.Column="1"
                            Content="Re-run Checks"
                            Command="{Binding RerunChecksCommand}"
                            IsEnabled="{Binding !IsRunning}"
                            Classes="secondary-action"
                            Padding="14,8"
                            FontSize="12" />

                    <Button Grid.Column="2"
                            Content="{Binding LaunchButtonText}"
                            Command="{Binding ContinueToAppCommand}"
                            Classes="primary-action"
                            Classes.splash-launch-ready="{Binding IsComplete}"
                            Padding="16,8"
                            FontSize="12" />
                </Grid>

                <TextBlock Text="ESC to skip · R to re-run checks · Read-Only Safety Boundary Enforced"
                           FontSize="10"
                           Foreground="#71717A"
                           HorizontalAlignment="Center" />

            </StackPanel>
        </Border>
    </Grid>
</UserControl>
