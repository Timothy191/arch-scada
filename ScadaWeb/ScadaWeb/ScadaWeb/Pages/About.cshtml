@page
@model AboutModel
@{
    Layout = "_MainLayout";
    dynamic dict = Locale.GetDictionary("Scada.Web.Pages.About");
    ViewBag.Title = dict.PageTitle;
    var version = System.Reflection.Assembly.GetExecutingAssembly().GetName().Version;
}

@section Styles {
    <link href="~/css/pages/about.min.css" rel="stylesheet" asp-append-version="true" />
}

<div id="divContainer" class="box-center">
    <div style="text-align:center; max-width:560px; padding:18px 22px;">
        <div style="margin-bottom:12px;">
            <img src="~/images/archlinux-logo.svg" alt="Arch Linux Logo" style="width:64px; height:64px;" />
        </div>
        <div>
            <a href="@CommonPhrases.WebsiteUrl" target="_blank" class="fs-1 mx-2">@CommonPhrases.WebAppName</a><span>@version</span>
        </div>
        <div style="margin-top:14px; font-size:13px; opacity:0.85;">
            Arch SCADA · CHPP Plant Monitoring &amp; Read-Only 3D Digital Twin (29 GA Nodes · 64 Sub-Equipment · 11 Process Pipes · 16 glTF 2.0 PBR Models · Zero PLC Write Path)
        </div>
        <div style="margin-top:16px;">
            <a href="~/DigitalTwin3D" class="btn btn-primary">Open 3D Digital Twin (Read-Only)</a>
        </div>
    </div>
</div>
