            addSubMesh(new THREE.BoxGeometry(0.18, 0.16, 0.14), railMat, [off.x, off.y + 0.28, off.z], [0, cd.yaw, 0], nodeId);
            addSubMesh(new THREE.BoxGeometry(0.05, 0.14, 0.08), tripRedMat, [off.x, off.y + 0.40, off.z], [0, cd.yaw, 0], nodeId);
        };
        addRipChord("RC-101", "CV-101", 0.34);
        addRipChord("RC-102", "CV-102", 0.52);

