// Per-equipment rolling telemetry ring buffer (60 samples at 1 Hz) for Inspector Sparkline
const trendHistory = new Map();
const MAX_TREND_SAMPLES = 60;

function getOrSeedTrend(key, currentVal) {
    let arr = trendHistory.get(key);
    if (!arr) {
        arr = [];
        for (let i = 23; i >= 1; i--) {
            const wave = Math.sin(i * 0.42) * 1.4 + Math.cos(i * 0.19) * 0.8;
            arr.push(Math.max(0, Math.min(100, currentVal + wave)));
        }
        arr.push(currentVal);
        trendHistory.set(key, arr);
    }
    return arr;
}

function recordTrendSamples(telemetryData) {
    const eqMap = telemetryData?.equipment;
    if (!eqMap) return;
    for (const [scadaId, eq] of Object.entries(eqMap)) {
        const val = Number(eq?.loadPct);
        if (!Number.isFinite(val)) continue;
        const arr = getOrSeedTrend(scadaId, val);
        arr.push(Math.max(0, Math.min(100, val)));
        if (arr.length > MAX_TREND_SAMPLES) arr.shift();
    }
}

function renderInspectorSparkline(node, loadPct) {
    const canvas = document.getElementById("insp-sparkline");
    const labelEl = document.getElementById("insp-trend-label");
    if (!canvas) return;

    const samples = getOrSeedTrend(node.scada || node.id, loadPct);
    if (labelEl) {
        labelEl.textContent = `${node.scada} Load: ${loadPct.toFixed(1)}%`;
    }

    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    const cssW = Math.max(180, Math.floor(canvas.clientWidth || 324));
    const cssH = 52;
    if (canvas.width !== Math.floor(cssW * dpr) || canvas.height !== Math.floor(cssH * dpr)) {
        canvas.width = Math.floor(cssW * dpr);
        canvas.height = Math.floor(cssH * dpr);
    }

    const ctx = canvas.getContext("2d");
    ctx.save();
    ctx.scale(dpr, dpr);

    const isDark = document.documentElement.getAttribute("data-theme") !== "light";
    ctx.fillStyle = isDark ? "#0b1220" : "#f8fafc";
    ctx.fillRect(0, 0, cssW, cssH);

    const padX = 6;
    const padY = 6;
    const plotW = cssW - padX * 2;
    const plotH = cssH - padY * 2;

    // Subtle horizontal gridlines (25%, 50%, 75%)
    ctx.strokeStyle = isDark ? "rgba(148, 163, 184, 0.14)" : "rgba(15, 23, 42, 0.10)";
    ctx.lineWidth = 1;
    for (const pct of [25, 50, 75]) {
        const y = padY + plotH * (1 - pct / 100);
        ctx.beginPath();
        ctx.moveTo(padX, y);
        ctx.lineTo(cssW - padX, y);
        ctx.stroke();
    }

    // High-load warning threshold line (85%)
    const warnY = padY + plotH * (1 - 0.85);
    ctx.save();
    ctx.setLineDash([4, 3]);
    ctx.strokeStyle = "rgba(245, 158, 11, 0.65)";
    ctx.beginPath();
    ctx.moveTo(padX, warnY);
    ctx.lineTo(cssW - padX, warnY);
    ctx.stroke();
    ctx.restore();

    if (samples.length >= 2) {
        const stepX = plotW / (samples.length - 1);
        const pts = samples.map((v, idx) => ({
            x: padX + idx * stepX,
            y: padY + plotH * (1 - Math.max(0, Math.min(100, v)) / 100)
        }));

        // Gradient fill under polyline
        const grad = ctx.createLinearGradient(0, padY, 0, cssH - padY);
        grad.addColorStop(0, "rgba(56, 189, 248, 0.34)");
        grad.addColorStop(1, "rgba(56, 189, 248, 0.02)");
        ctx.beginPath();
        ctx.moveTo(pts[0].x, cssH - padY);
        for (const p of pts) ctx.lineTo(p.x, p.y);
        ctx.lineTo(pts[pts.length - 1].x, cssH - padY);
        ctx.closePath();
        ctx.fillStyle = grad;
        ctx.fill();

        // Crisp trend polyline
        ctx.beginPath();
        ctx.moveTo(pts[0].x, pts[0].y);
        for (let i = 1; i < pts.length; i++) ctx.lineTo(pts[i].x, pts[i].y);
        ctx.strokeStyle = loadPct >= 85 ? "#f59e0b" : "#38bdf8";
        ctx.lineWidth = 1.8;
        ctx.lineJoin = "round";
        ctx.stroke();

        // Live latest sample marker
        const last = pts[pts.length - 1];
        ctx.beginPath();
        ctx.arc(last.x, last.y, 2.8, 0, Math.PI * 2);
        ctx.fillStyle = loadPct >= 85 ? "#f59e0b" : "#38bdf8";
        ctx.fill();
    }

    ctx.restore();
}

