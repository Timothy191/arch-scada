        addSubMesh(new THREE.BoxGeometry(0.64, 0.08, 0.84), sensorMat, [1.55, 1.70, -15.8], null, "LAUNDER-201");

        // Instrumentation beacons: VT-102, LT-201, DT-301, PT-301
        for (const id of ["VT-102", "LT-201", "DT-301", "PT-301"]) {
