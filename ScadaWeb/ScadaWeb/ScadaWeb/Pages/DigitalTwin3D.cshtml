@page
@model DigitalTwin3DModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>CHPP 3D Digital Twin (Read-Only) - Arch SCADA</title>
    <link rel="icon" href="~/favicon.ico" type="image/x-icon" />
    <style>
        :root {
            --bg-canvas: #09090b;
            --bg-panel: rgba(16, 16, 19, 0.92);
            --bg-card: rgba(23, 23, 27, 0.90);
            --bg-chip: rgba(32, 30, 24, 0.88);
            --border: rgba(245, 158, 11, 0.25);
            --border-strong: rgba(245, 158, 11, 0.55);
            --text-primary: #fafafa;
            --text-secondary: #a1a1aa;
            --text-muted: #71717a;
            --accent: #f59e0b;
            --accent-strong: #d97706;
            --emerald: #22c55e;
            --amber: #fbbf24;
            --red: #ef4444;
            --teal: #14b8a6;
            --shadow: 0 12px 32px rgba(0, 0, 0, 0.65);
        }

        html[data-theme="light"] {
            --bg-canvas: #e2e8f0;
            --bg-panel: rgba(248, 250, 252, 0.94);
            --bg-card: rgba(255, 255, 255, 0.94);
            --bg-chip: rgba(226, 232, 240, 0.92);
            --border: rgba(15, 23, 42, 0.14);
            --border-strong: rgba(2, 132, 199, 0.45);
            --text-primary: #0f172a;
            --text-secondary: #334155;
            --text-muted: #64748b;
            --accent: #0284c7;
            --accent-strong: #0369a1;
            --shadow: 0 10px 26px rgba(15, 23, 42, 0.14);
        }

        * { box-sizing: border-box; }
        html, body {
            margin: 0;
            padding: 0;
            width: 100%;
            height: 100%;
            overflow: hidden;
            background: var(--bg-canvas);
            color: var(--text-primary);
            font-family: "Inter", "Segoe UI", system-ui, -apple-system, sans-serif;
            font-size: 12.5px;
        }

        #app-shell {
            display: grid;
            grid-template-rows: auto 1fr;
            grid-template-columns: 1fr 370px;
            width: 100%;
            height: 100%;
        }

        /* Top HUD Bar */
        #top-bar {
            grid-column: 1 / -1;
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            padding: 8px 14px;
            background: var(--bg-panel);
            border-bottom: 1px solid var(--border);
            backdrop-filter: blur(10px);
            z-index: 30;
        }

        .brand-group {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
        }

        .brand-title {
            font-weight: 700;
            letter-spacing: 0.05em;
            font-size: 13.5px;
            color: var(--text-primary);
        }

        .badge {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 3px 8px;
            border-radius: 999px;
            font-size: 10.5px;
            font-weight: 700;
            letter-spacing: 0.04em;
            border: 1px solid transparent;
            white-space: nowrap;
        }

        .badge-ro {
            background: rgba(2, 132, 199, 0.18);
            border-color: rgba(56, 189, 248, 0.45);
            color: var(--accent);
        }

        .badge-demo {
            background: rgba(245, 158, 11, 0.16);
            border-color: rgba(245, 158, 11, 0.45);
            color: var(--amber);
        }

        .badge-live {
            background: rgba(34, 197, 94, 0.16);
            border-color: rgba(34, 197, 94, 0.45);
            color: var(--emerald);
        }

        .kpi-strip {
            display: flex;
            align-items: center;
            gap: 8px;
            flex-wrap: wrap;
        }

        .kpi-chip {
            background: var(--bg-chip);
            border: 1px solid var(--border);
            border-radius: 6px;
            padding: 3px 8px;
            display: flex;
            align-items: baseline;
            gap: 5px;
        }

        .kpi-chip .k { color: var(--text-muted); font-size: 10.5px; }
        .kpi-chip .v { color: var(--text-primary); font-weight: 700; font-variant-numeric: tabular-nums; }

        .toolbar-actions {
            display: flex;
            align-items: center;
            gap: 6px;
            flex-wrap: wrap;
        }

        .btn-hud {
            background: var(--bg-chip);
            color: var(--text-primary);
            border: 1px solid var(--border);
            border-radius: 6px;
            padding: 4px 9px;
            font-size: 11px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.15s ease;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 4px;
        }

        .btn-hud:hover {
            border-color: var(--border-strong);
            color: var(--accent);
        }

        .btn-hud.active {
            background: rgba(56, 189, 248, 0.20);
            border-color: var(--accent);
            color: var(--accent);
        }

        /* 3D Viewport */
        #viewport-wrap {
            position: relative;
            overflow: hidden;
            background: radial-gradient(circle at 50% 35%, #18150e 0%, var(--bg-canvas) 75%);
        }

        html[data-theme="light"] #viewport-wrap {
            background: radial-gradient(circle at 50% 35%, #f1f5f9 0%, #cbd5e1 85%);
        }

        #gl-container, #fallback-canvas {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            display: block;
        }

        #labels-overlay {
            position: absolute;
            inset: 0;
            pointer-events: none;
            overflow: hidden;
            z-index: 10;
        }

        .node-label {
            position: absolute;
            transform: translate(-50%, -100%);
            background: var(--bg-panel);
            border: 1px solid var(--border);
            border-radius: 5px;
            padding: 2px 6px;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 0.03em;
            color: var(--text-primary);
            white-space: nowrap;
            box-shadow: 0 2px 8px rgba(0,0,0,0.35);
            pointer-events: auto;
            cursor: pointer;
            transition: border-color 0.15s, background-color 0.15s;
        }

        .node-label.sub-badge {
            font-size: 9.2px;
            padding: 1.5px 5px;
            opacity: 0.92;
        }

        .node-label.hovered {
            border-color: #93c5fd;
            background: rgba(15, 23, 42, 0.94);
            color: #e0f2fe;
            z-index: 14;
        }

        .node-label.selected {
            border-color: var(--accent);
            background: rgba(2, 132, 199, 0.88);
            color: #fff;
            z-index: 15;
        }

        #hover-tooltip {
            position: absolute;
            display: none;
            pointer-events: none;
            z-index: 24;
            max-width: 280px;
            padding: 6px 9px;
            border-radius: 7px;
            background: var(--bg-panel);
            border: 1px solid var(--border-strong);
            box-shadow: var(--shadow);
            backdrop-filter: blur(8px);
            color: var(--text-primary);
            font-size: 11px;
            line-height: 1.35;
        }

        #hover-tooltip .tt-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 8px;
            font-weight: 800;
            color: var(--accent);
        }

        #hover-tooltip .tt-ga {
            font-weight: 600;
            margin-top: 2px;
            color: var(--text-primary);
        }

        #hover-tooltip .tt-meta {
            margin-top: 2px;
            font-size: 10px;
            color: var(--text-secondary);
            font-variant-numeric: tabular-nums;
        }

        .node-label .dot {
            display: inline-block;
            width: 6px;
            height: 6px;
            border-radius: 50%;
            margin-right: 4px;
            vertical-align: middle;
        }

        /* Camera Preset Dock */
        #camera-bar {
            position: absolute;
            left: 12px;
            bottom: 12px;
            right: 12px;
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
            padding: 8px 10px;
            background: var(--bg-panel);
            border: 1px solid var(--border);
            border-radius: 10px;
            backdrop-filter: blur(10px);
            box-shadow: var(--shadow);
            z-index: 20;
        }

        .preset-btn {
            background: var(--bg-chip);
            color: var(--text-secondary);
            border: 1px solid var(--border);
            border-radius: 6px;
            padding: 5px 9px;
            font-size: 11px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.15s;
        }

        .preset-btn:hover {
            color: var(--text-primary);
            border-color: var(--border-strong);
        }

        .preset-btn.active {
            background: var(--accent-strong);
            border-color: var(--accent);
            color: #fff;
        }

        #offline-banner {
            position: absolute;
            top: 12px;
            left: 12px;
            max-width: 520px;
            padding: 8px 12px;
            background: rgba(245, 158, 11, 0.16);
            border: 1px solid rgba(245, 158, 11, 0.5);
            border-radius: 8px;
            color: var(--text-primary);
            font-size: 11.5px;
            z-index: 25;
            display: none;
            backdrop-filter: blur(8px);
        }

        #status-pill {
            position: absolute;
            top: 12px;
            right: 12px;
            padding: 5px 10px;
            background: var(--bg-panel);
            border: 1px solid var(--border);
            border-radius: 8px;
            font-size: 11px;
            color: var(--text-secondary);
            z-index: 20;
            pointer-events: none;
        }

        /* Inspector Sidebar */
        #inspector {
            background: var(--bg-panel);
            border-left: 1px solid var(--border);
            display: flex;
            flex-direction: column;
            overflow: hidden;
            z-index: 25;
        }

        .insp-header {
            padding: 8px 12px;
            border-bottom: 1px solid var(--border);
            background: var(--bg-card);
        }

        .insp-title-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 8px;
        }

        .insp-id {
            font-size: 15px;
            font-weight: 800;
            color: var(--accent);
            letter-spacing: 0.03em;
        }

        .insp-stage {
            font-size: 10px;
            font-weight: 700;
            color: var(--accent);
            text-transform: uppercase;
            letter-spacing: 0.05em;
            margin-top: 1px;
        }

        .insp-ga {
            font-size: 12.5px;
            font-weight: 700;
            margin-top: 2px;
        }

        .insp-body {
            padding: 8px 10px;
            overflow-y: auto;
            flex: 1;
            display: flex;
            flex-direction: column;
            justify-content: flex-start;
            gap: 6px;
        }

        .insp-card {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: 7px;
            padding: 7px 9px;
        }

        .insp-card h4 {
            margin: 0 0 4px 0;
            font-size: 10px;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            color: var(--text-muted);
        }

        .kv-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 4px 8px;
        }

        .kv-item .k { font-size: 9.5px; color: var(--text-muted); }
        .kv-item .v { font-size: 12px; font-weight: 700; font-variant-numeric: tabular-nums; }

        .flow-links {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 4px;
        }

        .node-pill {
            background: var(--bg-chip);
            border: 1px solid var(--border);
            border-radius: 5px;
            padding: 2px 6px;
            font-size: 10.5px;
            font-weight: 700;
            color: var(--text-primary);
            cursor: pointer;
        }

        .node-pill:hover { border-color: var(--accent); color: var(--accent); }
        .node-pill.current { background: var(--accent-strong); border-color: var(--accent); color: #fff; }

        .node-directory {
            display: grid;
            grid-template-columns: repeat(6, 1fr);
            gap: 3px;
            max-height: 220px;
            overflow-y: auto;
            padding-right: 2px;
        }

        .dir-btn {
            background: var(--bg-chip);
            border: 1px solid var(--border);
            border-radius: 4px;
            padding: 2px 3px;
            font-size: 10px;
            font-weight: 600;
            color: var(--text-secondary);
            text-align: center;
            cursor: pointer;
        }

        .dir-btn:hover { color: var(--text-primary); border-color: var(--border-strong); }
        .dir-btn.active { background: var(--accent-strong); border-color: var(--accent); color: #fff; }

        .status-tag {
            padding: 2px 8px;
            border-radius: 999px;
            font-size: 10.5px;
            font-weight: 700;
        }
        .st-Running { background: rgba(34, 197, 94, 0.18); color: var(--emerald); border: 1px solid rgba(34, 197, 94, 0.45); }
        .st-Warning { background: rgba(245, 158, 11, 0.18); color: var(--amber); border: 1px solid rgba(245, 158, 11, 0.45); }
        .st-Fault { background: rgba(239, 68, 68, 0.22); color: var(--red); border: 1px solid rgba(239, 68, 68, 0.55); }
        .st-Stopped { background: rgba(100, 116, 139, 0.22); color: var(--text-secondary); border: 1px solid rgba(100, 116, 139, 0.45); }

        @@media (max-width: 1024px) {
            #app-shell {
                grid-template-columns: 1fr;
                grid-template-rows: auto 58vh 1fr;
            }
            #inspector {
                border-left: none;
                border-top: 1px solid var(--border);
            }
        }
    </style>
    <script type="importmap">
    {
        "imports": {
            "three": "/lib/three/three.module.min.js",
            "three/addons/": "/lib/three/addons/",
            "three/examples/jsm/": "/lib/three/addons/",
            "postprocessing": "/lib/three/addons/postprocessing/Pass.js",
            "three-mesh-bvh": "/lib/three-mesh-bvh/index.module.js",
            "n8ao": "/lib/n8ao/N8AO.js"
        }
    }
    </script>
</head>
<body>
<div id="app-shell">
    <!-- Top HUD -->
    <header id="top-bar">
        <div class="brand-group">
            <img src="~/images/archlinux-logo.svg" alt="Arch Linux Logo" style="width:26px; height:26px; vertical-align:middle;" />
            <span class="brand-title" style="color:var(--accent);">ARCH SCADA · CHPP 3D DIGITAL TWIN</span>
            <span class="badge badge-ro" title="Zero PLC Write Path · HTTP GET Only">READ-ONLY · NO PLC WRITE</span>
            <span id="provenance-badge" class="badge badge-demo">SIMULATED DEMO TELEMETRY · READ-ONLY</span>
            <span class="badge badge-ro" style="opacity:0.85;">SITE CONFIRMED GA · 29 NODES + 75 SUB-ITEMS</span>
        </div>

        <div class="kpi-strip">
            <div class="kpi-chip"><span class="k">ROM</span><span class="v" id="kpi-rom">640.0 t/h</span></div>
            <div class="kpi-chip"><span class="k">Clean</span><span class="v" id="kpi-clean">408.0 t/h</span></div>
            <div class="kpi-chip"><span class="k">Med SG</span><span class="v" id="kpi-sg">1.52</span></div>
            <div class="kpi-chip"><span class="k">Water</span><span class="v" id="kpi-water">87.4%</span></div>
            <div class="kpi-chip"><span class="k">Ash</span><span class="v" id="kpi-ash">9.40%</span></div>
            <div class="kpi-chip"><span class="k">GLB</span><span class="v" id="kpi-glb">0/24</span></div>
            <div class="kpi-chip"><span class="k">FPS</span><span class="v" id="kpi-fps">--</span></div>
        </div>

        <div class="toolbar-actions">
            <button type="button" class="btn-hud" id="btn-circuits">Circuits &amp; Historian</button>
            <button type="button" class="btn-hud active" id="btn-labels">Labels</button>
            <button type="button" class="btn-hud active" id="btn-arrows">Flow Chevrons</button>
            <button type="button" class="btn-hud active" id="btn-postfx">Post FX</button>
            <button type="button" class="btn-hud" id="btn-thermal">Thermal Heatmap</button>
            <button type="button" class="btn-hud" id="btn-pause">Pause</button>
            <button type="button" class="btn-hud" id="btn-theme">Light HUD</button>
            <a class="btn-hud" href="~/About" title="ScadaWeb About">ScadaWeb</a>
        </div>
    </header>

    <!-- 3D Viewport -->
    <main id="viewport-wrap">
        <div id="gl-container"></div>
        <canvas id="fallback-canvas" style="display:none;"></canvas>
        <div id="labels-overlay"></div>
        <div id="hover-tooltip" role="status" aria-live="polite"></div>

        <!-- Collapsible 2D Plant Circuits & Multi-Trace Historian Drawer (Web <-> Desktop Parity) -->
        <section id="circuits-drawer" aria-label="2D Plant Circuits and Multi-Trace Historian" style="display:none; position:absolute; top:12px; left:12px; right:12px; bottom:58px; z-index:26; background:var(--bg-panel); border:1px solid var(--border-strong); border-radius:10px; box-shadow:var(--shadow); backdrop-filter:blur(12px); padding:12px 14px; overflow-y:auto;">
            <div style="display:flex; justify-content:space-between; align-items:center; gap:10px; border-bottom:1px solid var(--border); padding-bottom:8px; margin-bottom:10px;">
                <div>
                    <div style="font-size:14px; font-weight:800; color:var(--accent);">CHPP 2D Process Circuits &amp; Multi-Trace Loop Historian (Read-Only)</div>
                    <div style="font-size:11px; color:var(--text-secondary);">Click any circuit equipment card to select and focus it in the 3D Digital Twin</div>
                </div>
                <div style="display:flex; align-items:center; gap:8px;">
                    <select id="web-hist-preset" class="btn-hud" aria-label="Process loop overlay preset">
                        <option value="dmc">DMC-301 Cyclone Loop (DM-301 / TK-301 / MS-301)</option>
                        <option value="thickener">Thickener Loop (TK-201 / PP-201 / PP-203)</option>
                        <option value="crushing">Crushing Loop (CR-101 / SC-102 / CV-101)</option>
                        <option value="quality">ROM &amp; Loadout Loop (AF-001 / SL-601 / CV-501)</option>
                    </select>
                    <button type="button" class="btn-hud active" id="btn-web-export-csv">Export CSV</button>
                    <button type="button" class="btn-hud" id="btn-close-circuits">Close ✕</button>
                </div>
            </div>
            <div class="insp-card" style="margin-bottom:10px;">
                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:4px;">
                    <h4 style="margin:0;">Multi-Trace Process Loop Historian (60s Rolling Buffer · 1 Hz)</h4>
                    <span id="web-hist-legend" style="font-size:10.5px; font-weight:700; color:var(--text-secondary);"></span>
                </div>
                <canvas id="web-historian-canvas" width="820" height="145" style="width:100%; height:145px; display:block; border-radius:6px; background:#0b1220; border:1px solid var(--border);"></canvas>
            </div>
            <div id="web-circuits-grid" style="display:grid; grid-template-columns:repeat(auto-fill, minmax(235px, 1fr)); gap:8px;"></div>
        </section>

        <div id="offline-banner">
            <strong>2D GA Schematic Fallback Active:</strong> WebGL 3D context could not be initialized in this browser session. Displaying interactive 2D GA schematic twin (read-only telemetry &amp; 111-item flow simulation remain active).
        </div>

        <div id="status-pill">PBR · N8AO · HDR Bloom · ACES · BVH · 2048² PCF Shadows · Orbit: Drag | Pan: Right-Drag | Zoom: Wheel | Select: Click</div>

        <div id="camera-bar" role="toolbar" aria-label="GA Camera Presets">
        <button class="preset-btn active" data-preset="overview" title="Overview View">Overview</button>
        <button class="preset-btn" data-preset="crusher" title="Jaw Crusher View">Crusher</button>
        <button class="preset-btn" data-preset="screen" title="Sizing Screen View">Screen</button>
        <button class="preset-btn" data-preset="wash" title="Wash Plant View">Wash Plant</button>
        <button class="preset-btn active" data-toggles="bloom" title="Bloom Effect">Bloom</button>
        <button class="preset-btn" data-toggles="n8ao" title="Ambient Occlusion">AO</button>
    </div>
    </main>

    <!-- Equipment Identification & Process Flow Inspector -->
    <aside id="inspector" aria-label="Equipment Identification and Process Flow Inspector">
        <div class="insp-header">
            <div class="insp-title-row">
                <span class="insp-id" id="insp-id">JC-101</span>
                <span class="status-tag st-Running" id="insp-status">Running</span>
            </div>
            <div class="insp-stage" id="insp-stage">Stage 3 — Jaw Crushing</div>
            <div class="insp-ga" id="insp-ga">Primary Jaw Crusher</div>
        </div>

        <div class="insp-body">
            <div class="insp-card">
                <h4>Live / Coupled Process Telemetry (Read-Only)</h4>
                <div class="kv-grid">
                    <div class="kv-item"><div class="k">Load / Rate</div><div class="v" id="insp-load">78.4%</div></div>
                    <div class="kv-item"><div class="k">Throughput</div><div class="v" id="insp-tph">418.0 t/h</div></div>
                    <div class="kv-item"><div class="k">Motor Power</div><div class="v" id="insp-kw">266.0 kW</div></div>
                    <div class="kv-item"><div class="k">SCADA Group</div><div class="v" id="insp-scada">CR-101</div></div>
                </div>
                <div style="margin-top:8px; font-size:11px; color:var(--text-secondary);" id="insp-plc">
                    Direct PLC: CR101 (Modbus 10.10.1.11:502 · Cnl 101–103)
                </div>
                <div style="margin-top:4px; font-size:11px; color:var(--emerald); font-weight:600;" id="insp-prov-note">
                    [READ-ONLY] [SITE CONFIRMED]
                </div>
                <div style="margin-top:6px; padding-top:6px; border-top:1px solid var(--border);">
                    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:4px;">
                        <span style="font-size:9.5px; font-weight:700; letter-spacing:0.06em; color:var(--text-muted); text-transform:uppercase;">Live Telemetry Trend (60s)</span>
                        <span id="insp-trend-label" style="font-size:10px; font-weight:700; color:var(--accent); font-variant-numeric:tabular-nums;">Load: 78.4%</span>
                    </div>
                    <canvas id="insp-sparkline" width="324" height="52" aria-label="Selected equipment live telemetry sparkline" style="width:100%; height:52px; display:block; border-radius:5px; background:#0b1220; border:1px solid var(--border);"></canvas>
                </div>
            </div>

            <div class="insp-card">
                <h4>Process Flow Topology</h4>
                <div style="font-size:10.5px; color:var(--text-muted); margin-bottom:5px;">Upstream → Selected → Downstream (click node to inspect)</div>
                <div class="flow-links" id="insp-topology"></div>
            </div>

            <div class="insp-card">
                <h4>Mechanical &amp; GA Specification</h4>
