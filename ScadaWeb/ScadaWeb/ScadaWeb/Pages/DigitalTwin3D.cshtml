        };

        // GATE-101: BN-101 discharge throat slide gate + pneumatic actuator
        addSubMesh(new THREE.BoxGeometry(1.06, 0.14, 1.06), darkSteelMat, [-13.8, 4.82, 8.8], null, "GATE-101");
        addSubMesh(new THREE.CylinderGeometry(0.07, 0.07, 0.58, 12), railMat, [-14.58, 4.82, 8.8], [0, 0, Math.PI * 0.5], "GATE-101");
        addSubMesh(new THREE.CylinderGeometry(0.03, 0.03, 0.36, 10), chromeMat, [-14.22, 4.82, 8.8], [0, 0, Math.PI * 0.5], "GATE-101");

        // CHUTE-100: BN-101 to VF-101 enclosed transition chute
        addSubMesh(new THREE.BoxGeometry(1.16, 0.56, 1.38), mnMat, [-13.8, 5.25, 7.82], [-0.26, 0, 0], "CHUTE-100");

        // PAN-101: VF-101 manganese impact feeder pan
        addSubMesh(new THREE.BoxGeometry(1.26, 0.12, 1.48), mnMat, [-13.8, 5.38, 6.62], [-0.14, 0, 0], "PAN-101");

        // DIV-101: CV-103 bypass / roll-crusher diverter flap gate
        addSubMesh(new THREE.BoxGeometry(0.72, 0.70, 0.72), darkSteelMat, [-7.55, 1.72, -0.50], null, "DIV-101");
        addSubMesh(new THREE.CylinderGeometry(0.06, 0.06, 0.45, 12), railMat, [-7.55, 1.72, -0.96], [Math.PI * 0.5, 0, 0], "DIV-101");

        // BW-101, BW-102, BW-201: belt weigher scale bridges aligned on conveyors
        const addBeltWeigher = (nodeId, convId, frac) => {
            const cd = conveyorData.find(x => x.spec.id === convId);
            if (!cd) return;
            const p = new THREE.Vector3().lerpVectors(cd.tail, cd.head, frac);
