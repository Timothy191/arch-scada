    if (machineBeacons.instanceColor) machineBeacons.instanceColor.needsUpdate = true;
    scene.add(machineBeacons);

    // Conveyor labels too
    for (const c of CONVEYORS) {
        const lbl = document.createElement("div");
        lbl.className = "node-label";
        lbl.innerHTML = `<span class="dot" style="background:${c.matCol}"></span>${c.id}`;
        lbl.addEventListener("click", () => selectNode(c.id, false));
