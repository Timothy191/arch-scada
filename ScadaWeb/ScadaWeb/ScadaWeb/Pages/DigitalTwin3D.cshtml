        lbl.addEventListener("click", () => selectNode(r.id, false));
        overlay.appendChild(lbl);
        labelElems[r.id] = lbl;
    }

    // Procedural 3D details for Stage 1-6 & Wash Plant sub-equipment
    let rakeGroup = null;
    {
        // Enhanced materials with clearcoat for polished metal effects
        const darkSteelMat = new THREE.MeshPhysicalMaterial({ 
            color: 0x242b35, 
            roughness: 0.35, 
            metalness: 0.85,
            clearcoat: 0.4,
            clearcoatRoughness: 0.1
        });
        const mnMat = new THREE.MeshPhysicalMaterial({ 
            color: 0x3a4048, 
            roughness: 0.30, 
            metalness: 0.85,
            clearcoat: 0.2,
            clearcoatRoughness: 0.05
        });
        const chromeMat = new THREE.MeshPhysicalMaterial({ 
            color: 0xb8c0c8, 
            roughness: 0.15, 
            metalness: 0.95,
            clearcoat: 0.5,
            clearcoatRoughness: 0.02
        });
        const sensorMat = new THREE.MeshPhysicalMaterial({ 
            color: 0x06b6d4, 
            roughness: 0.25, 
            metalness: 0.60,
            emissive: 0x0284c7,
            emissiveIntensity: 0.4,
            clearcoat: 0.1,
            clearcoatRoughness: 0.2
        });
        const tripRedMat = new THREE.MeshStandardMaterial({ 
            color: 0xef4444, 
            roughness: 0.40, 
            metalness: 0.45
        });
        const addSubMesh = (geo, mat, pos, rot, nodeId) => {
            const m = new THREE.Mesh(geo, mat);
            m.position.set(...pos);
            if (rot) m.rotation.set(...rot);
            m.castShadow = true; m.receiveShadow = true;
            m.userData.nodeId = nodeId;
            scene.add(m);
            pickTargets.push(m);
