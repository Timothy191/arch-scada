    // Load all 24 .glb models from /models3d/{fileName}
    const gltfLoader = new GLTFLoader();
    if (MeshoptDecoder) gltfLoader.setMeshoptDecoder(MeshoptDecoder);
    const glbCache = new Map();
    const loadGlb = (fileName) => {
        if (glbCache.has(fileName)) return glbCache.get(fileName);
        const p = new Promise((resolve, reject) => {
            gltfLoader.load(`/models3d/${encodeURIComponent(fileName)}`, gltf => {
                gltf.scene.traverse(ch => {
                    if (ch.isMesh && ch.geometry?.computeBoundsTree && !ch.geometry.boundsTree) {
                        try { ch.geometry.computeBoundsTree(); } catch {}
                    }
                });
                state.loadedGlbSet.add(fileName);
                document.getElementById("kpi-glb").textContent = `${state.loadedGlbSet.size}/24`;
                resolve(gltf.scene);
            }, undefined, reject);
        });
        glbCache.set(fileName, p);
        return p;
    };

    const tagNodeHierarchy = (obj, nodeId) => {
        obj.traverse(ch => {
            ch.userData.nodeId = nodeId;
            if (ch.isMesh) {
                ch.castShadow = true;
                ch.receiveShadow = true;
                if (ch.material) ch.material = ch.material.clone();
                raycastTargets.push(ch);
            }
        });
    };

    for (const m of MACHINE_NODES) {
        loadGlb(m.glb).then(template => {
            const entry = machineObjects[m.id];
            const clone = template.clone(true);
            tagNodeHierarchy(clone, m.id);
            entry.root.remove(entry.proxy);
            entry.glbRoot = clone;

            // Create LOD for each machine (full detail at 0m, medium at 20m, low at 50m)
            // Coordinates are local to entry.root (which already applies m.pos, m.yaw, and m.scale)
            const lod = new THREE.LOD();
            
            // Full detail - original clone
            lod.add(clone, 0);
            
            // Medium detail - simplified box approximation in local space
            const simplifiedGeo = new THREE.BoxGeometry(
                m.half[0] * 2, 
                m.half[1] * 2, 
                m.half[2] * 2
            );
            const simplifiedMat = new THREE.MeshStandardMaterial({
                color: m.color,
                roughness: 0.6,
                metalness: 0.4
            });
            const simplifiedMesh = new THREE.Mesh(simplifiedGeo, simplifiedMat);
            simplifiedMesh.position.set(0, m.half[1], 0);
            simplifiedMesh.castShadow = true;
            simplifiedMesh.receiveShadow = true;
            simplifiedMesh.userData.nodeId = m.id;
            lod.add(simplifiedMesh, 20);
            
            // Low detail - small sphere in local space
            const lowDetail = new THREE.Mesh(
                new THREE.SphereGeometry(1, 8, 8),
                new THREE.MeshStandardMaterial({ color: m.color, roughness: 0.8, metalness: 0.1 })
            );
            lowDetail.position.set(0, m.half[1], 0);
            lowDetail.scale.set(
                m.half[0] / 1.5,
                m.half[1] / 1.5,
                m.half[2] / 1.5
            );
            lowDetail.userData.nodeId = m.id;
            lod.add(lowDetail, 50);
            
            entry.root.add(lod);
            entry.lod = lod;

            if (m.id === "FEL-101") {
                loadGlb("wheel_loader_bucket.glb").then(bTemplate => {
                    const pivot = new THREE.Group();
                    pivot.position.set(1.30, 1.38, 0);
                    const bClone = bTemplate.clone(true);
                    tagNodeHierarchy(bClone, "FEL-101");
                    pivot.add(bClone);
                    entry.root.add(pivot);
                    entry.bucketPivot = pivot;
                }).catch(() => {});
            }
        }).catch(() => {});
    }

    // Preload conveyor_segment.glb and load standalone sub-equipment GLB models so all 24 GLB assets are active
    loadGlb("conveyor_segment.glb").catch(() => {});
    for (const sn of SUB_EQUIPMENT_NODES) {
        if (!sn.glb) continue;
        loadGlb(sn.glb).then(template => {
            if (sn.id === "DMC-301") return; // DMC-301 is embedded in WP-301 frame
            const clone = template.clone(true);
            clone.position.set(...sn.pos);
            tagNodeHierarchy(clone, sn.id);
            scene.add(clone);
        }).catch(() => {});
    }

    // Camera Rig Bridge + Smooth Damped camAnim Interpolation
    let camAnim = null;
    controls.addEventListener("start", () => { camAnim = null; });

    window.__applyPreset = (p, immediate = false) => {
        const dist = 19.0 / Math.max(0.35, Math.min(3.2, p.zoom));
        const cp = Math.cos(p.pitch), sp = Math.sin(p.pitch);
        const cy = Math.cos(p.yaw), sy = Math.sin(p.yaw);
        const targetLook = new THREE.Vector3(p.tx, 0.9, p.tz);
        const targetPos = new THREE.Vector3(p.tx + dist * cp * sy, 0.9 + dist * sp, p.tz + dist * cp * cy);
        if (immediate) {
            camAnim = null;
            controls.target.copy(targetLook);
            camera.position.copy(targetPos);
            controls.update();
        } else {
            camAnim = { targetPos, targetLook };
        }
    };
    window.__focusTarget = (x, y, z) => {
        const targetLook = new THREE.Vector3(x, y, z);
        const baseLook = camAnim ? camAnim.targetLook : controls.target;
        const basePos = camAnim ? camAnim.targetPos : camera.position;
        const offset = new THREE.Vector3().subVectors(basePos, baseLook);
        if (offset.length() > 14) offset.setLength(12);
        if (offset.length() < 4.5) offset.setLength(5.5);
        camAnim = { targetPos: targetLook.clone().add(offset), targetLook };
    };
    window.__updateThreeTheme = (theme) => {
        const dark = theme === "dark";
        scene.background.setHex(dark ? 0x070d1a : 0xdbe5f0);
        scene.fog.color.setHex(dark ? 0x070d1a : 0xdbe5f0);
        groundMat.color.setHex(dark ? 0x0b1324 : 0xcbd5e1);
    };
    applyCameraPreset("Plant Overview", true);

    // Raycast Click Selection & Throttled Hover Tooltip
    const raycaster = new THREE.Raycaster();
    const pointer = new THREE.Vector2();
    const tooltipEl = document.getElementById("hover-tooltip");
    let downPt = null;
    let lastHoverTs = 0;

    const resolveHitNodeId = (hits) => {
        for (const h of hits) {
            let cur = h.object;
            while (cur) {
                if (cur.userData && cur.userData.nodeId) return cur.userData.nodeId;
                cur = cur.parent;
            }
        }
        return null;
    };

    const updateTooltip = (nodeId, clientX, clientY) => {
        if (!nodeId || !NODE_BY_ID[nodeId]) {
            tooltipEl.style.display = "none";
            return;
        }
        const n = NODE_BY_ID[nodeId];
        const eq = state.telemetry?.equipment?.[n.scada];
        const directFlow = state.flowMap[n.id];
        const flow = directFlow || state.flowMap[n.scada] || (n.parentId && state.flowMap[n.parentId]) || state.flowMap["WP-301"];
        const tph = directFlow ? directFlow.tph : (flow ? Math.round(n.nomTph * flow.rate * 10) / 10 : n.nomTph);
        const st = flow?.starved ? "Starved" : (eq?.status || "Running");
        const wrapRect = container.parentElement.getBoundingClientRect();
        const x = Math.min(wrapRect.width - 290, Math.max(12, clientX - wrapRect.left + 14));
        const y = Math.min(wrapRect.height - 96, Math.max(12, clientY - wrapRect.top + 14));

        tooltipEl.innerHTML =
            `<div class="tt-head"><span>${n.id}</span><span>${st}</span></div>` +
            `<div class="tt-ga">${n.ga}</div>` +
            `<div class="tt-meta">${n.type} · ${tph.toFixed(1)} t/h · SCADA ${n.scada}</div>`;
        tooltipEl.style.left = `${x}px`;
        tooltipEl.style.top = `${y}px`;
        tooltipEl.style.display = "block";
    };

    renderer.domElement.addEventListener("pointerdown", e => { downPt = { x: e.clientX, y: e.clientY }; });
    renderer.domElement.addEventListener("pointermove", e => {
        if (e.buttons !== 0) {
            tooltipEl.style.display = "none";
            return;
        }
        const nowTs = performance.now();
        if (nowTs - lastHoverTs < 45) {
            if (state.hoveredId) updateTooltip(state.hoveredId, e.clientX, e.clientY);
            return;
        }
        lastHoverTs = nowTs;
        const rect = renderer.domElement.getBoundingClientRect();
        pointer.x = ((e.clientX - rect.left) / rect.width) * 2 - 1;
        pointer.y = -((e.clientY - rect.top) / rect.height) * 2 + 1;
        raycaster.setFromCamera(pointer, camera);
        const hits = raycaster.intersectObjects(pickTargets, true);
        const hitId = resolveHitNodeId(hits);
        state.hoveredId = hitId;
        renderer.domElement.style.cursor = hitId ? "pointer" : "";
        updateTooltip(hitId, e.clientX, e.clientY);
    });
    renderer.domElement.addEventListener("pointerleave", () => {
        state.hoveredId = null;
        renderer.domElement.style.cursor = "";
        tooltipEl.style.display = "none";
    });
    renderer.domElement.addEventListener("pointerup", e => {
        if (!downPt || Math.hypot(e.clientX - downPt.x, e.clientY - downPt.y) > 5) return;
        const rect = renderer.domElement.getBoundingClientRect();
        pointer.x = ((e.clientX - rect.left) / rect.width) * 2 - 1;
        pointer.y = -((e.clientY - rect.top) / rect.height) * 2 + 1;
        raycaster.setFromCamera(pointer, camera);
        const hits = raycaster.intersectObjects(pickTargets, true);
        const hitId = resolveHitNodeId(hits);
        if (hitId) selectNode(hitId, false);
    });

    window.addEventListener("resize", () => {
        const w = container.clientWidth, h = Math.max(1, container.clientHeight);
        camera.aspect = w / h;
        camera.updateProjectionMatrix();
        renderer.setSize(w, h);
        if (composer) {
            composer.setSize(w, h);
            n8aoPass?.setSize?.(w, h);
        }
    });

    // Main Render Loop
    const dummy = new THREE.Object3D();
    const projVec = new THREE.Vector3();
    const labelWorldPos = new THREE.Vector3();
    let lastTime = performance.now(), fpsFrames = 0, fpsTimer = 0;

    function animate(now) {
        requestAnimationFrame(animate);
        const dt = Math.min(0.1, (now - lastTime) / 1000);
        lastTime = now;
        
        // Check for reduced motion preference
        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        fpsFrames++;
        fpsTimer += dt;
        if (fpsTimer >= 0.5) {
            const fpsAvg = Math.round(fpsFrames / fpsTimer);
            document.getElementById("kpi-fps").textContent = fpsAvg.toString();
            // Log frame time for debugging (optional)
            // console.log(`FPS: ${fpsAvg}, Frame time: ${(fpsTimer / fpsFrames).toFixed(2)}s`);
            fpsFrames = 0; fpsTimer = 0;
        }

        if (camAnim) {
            const alpha = 1 - Math.exp(-8.5 * dt);
            camera.position.lerp(camAnim.targetPos, alpha);
            controls.target.lerp(camAnim.targetLook, alpha);
            if (camera.position.distanceTo(camAnim.targetPos) < 0.02 && controls.target.distanceTo(camAnim.targetLook) < 0.02) {
                camera.position.copy(camAnim.targetPos);
                controls.target.copy(camAnim.targetLook);
                camAnim = null;
            }
        }

        if (!state.paused) state.simTime += dt;
        const t = state.simTime;
        evaluateProcessFlows(t);

        const eqMap = state.telemetry?.equipment || {};
        const loaderFlow = state.flowMap["FEL-101"];
        const lp = computeLoaderPose(t, !state.paused && (loaderFlow?.running ?? true));

        // Update 18 machines + 18 instanced status beacons
        MACHINE_NODES.forEach((m, mIdx) => {
            const entry = machineObjects[m.id];
            const flow = state.flowMap[m.id];
            const eq = eqMap[m.scada];
            const running = flow ? flow.running : true;
            const isSel = state.selectedId === m.id;

            if (m.id === "FEL-101") {
                entry.root.position.set(lp.x, lp.y, lp.z);
                entry.root.rotation.order = "YXZ";
                entry.root.rotation.y = THREE.MathUtils.degToRad(lp.yaw);
                entry.root.rotation.z = THREE.MathUtils.degToRad(lp.pitch);
                entry.ring.position.set(lp.x, lp.y + 0.08, lp.z);
                if (entry.bucketPivot) {
                    entry.bucketPivot.rotation.z = THREE.MathUtils.degToRad(lp.boom + lp.dump * 0.45);
                }
            } else if (m.vibrates && running && !state.paused) {
                const load = eq ? Math.max(0.15, Math.min(1.15, eq.loadPct / 100)) : 0.7;
                if (m.id === "VF-101") {
                    entry.root.position.set(m.pos[0] + Math.sin(t * 15.5) * 0.004 * load, m.pos[1] + Math.sin(t * 31.0) * (0.015 + 0.018 * load), m.pos[2] - Math.cos(t * 31.0) * (0.014 + 0.014 * load));
                } else if (m.id === "DS-201") {
                    entry.root.position.set(m.pos[0] - Math.cos(t * 34.0) * (0.012 + 0.015 * load), m.pos[1] + Math.sin(t * 34.0) * (0.016 + 0.022 * load), m.pos[2] + Math.sin(t * 17.0) * 0.004 * load);
                } else {
                    entry.root.position.set(m.pos[0] + Math.cos(t * 28.0) * (0.014 + 0.016 * load), m.pos[1] + Math.sin(t * 28.0) * (0.018 + 0.024 * load), m.pos[2] + Math.sin(t * 14.0) * 0.006 * load);
                }
            } else {
                entry.root.position.set(m.pos[0], m.pos[1], m.pos[2]);
            }

            // Status Beacon instance with pulsating glow
            const bx = m.id === "FEL-101" ? lp.x : m.pos[0];
            const by = m.id === "FEL-101" ? (lp.y + 3.12) : (m.pos[1] + m.labelH - 0.28);
            const bz = m.id === "FEL-101" ? lp.z : m.pos[2];
            const st = eq?.status;
            let beaconHex = 0x22c55e;
            let bScale = 1.0;
            // Pulsating glow based on status and simulation time
            const pulse = 1.0 + 0.15 * Math.sin(t * 4.0);
            if (st === "Fault") {
                beaconHex = 0xef4444;
                bScale = pulse * 1.28;
            } else if (st === "Warning" || flow?.starved) {
                beaconHex = 0xf59e0b;
                bScale = pulse * 1.15;
            } else if (st === "Running" || !!flow) {
                beaconHex = 0x22c55e;
                bScale = pulse * 1.0;
            } else if (st === "Stopped" || st === "Offline" || !running) {
                beaconHex = 0x64748b;
                bScale = 0.85;
            }
            dummy.position.set(bx, by, bz);
            dummy.rotation.set(0, 0, 0);
            dummy.scale.setScalar(bScale);
            dummy.updateMatrix();
            machineBeacons.setMatrixAt(mIdx, dummy.matrix);
            machineBeacons.setColorAt(mIdx, tmpColor.setHex(beaconHex));

            // Selection / Alarm Ring
            const isWarnOrFault = eq && (eq.status === "Warning" || eq.status === "Fault");
            entry.ring.visible = isSel || isWarnOrFault;
            if (entry.ring.visible) {
                entry.ring.material.color.setHex(isSel ? 0x38bdf8 : (eq.status === "Fault" ? 0xef4444 : 0xf59e0b));
                entry.ring.material.opacity = isSel ? 0.9 : 0.45 + 0.35 * Math.sin(t * 4.5);
            }

            // Optional thermal heatmap emissive tint
            if (entry.glbRoot) {
                let tintHex = 0x000000;
                let tintStrength = 0.0;
                if (state.thermalHeatmap && eq) {
                    tintStrength = 0.45;
                    tintHex = eq.loadPct >= 85 ? 0xef4444 : (eq.loadPct >= 70 ? 0xf59e0b : (eq.loadPct >= 40 ? 0x22c55e : 0x38bdf8));
                } else if (isSel) {
                    tintHex = 0x0284c7; tintStrength = 0.25;
                } else if (state.hoveredId === m.id) {
                    tintHex = 0x38bdf8; tintStrength = 0.16;
                } else if (eq && eq.status === "Fault") {
                    tintHex = 0xef4444; tintStrength = 0.45;
                }
                entry.glbRoot.traverse(ch => {
                    if (ch.isMesh && ch.material && "emissive" in ch.material) {
                        ch.material.emissive.setHex(tintHex);
                        ch.material.emissiveIntensity = tintStrength;
                    }
                });
            }

            // Fill level
            if (entry.fillMesh && m.fill) {
                let frac = eq ? Math.max(0.12, Math.min(0.95, eq.loadPct / 100)) : 0.6;
                if (m.id === "BN-101") frac = Math.min(0.98, frac + lp.binPulse);
                const fh = m.fill.maxH * frac;
                entry.fillMesh.scale.y = fh;
                entry.fillMesh.position.y = m.pos[1] + m.fill.baseY + fh * 0.5;
            }

            // Rotating top (MS-301 / TK-201) + submerged RAKE-201 truss
            if (entry.rotBar && m.rotTop && running && !state.paused) {
                entry.rotBar.rotation.y = t * m.rotTop.speed;
                if (m.id === "TK-201" && rakeGroup) {
                    rakeGroup.rotation.y = t * m.rotTop.speed;
                }
            }

            // JC-101 & DRC-101 mechanical sub-animations
            if (m.id === "JC-101" && entry.extras && running && !state.paused) {
                // Mechanical animations (skip if reduced motion preference)
                const animFactor = reducedMotion ? 0 : 1;
                
                // Flywheel rotation
                const flywheelAng = t * 8.2 * animFactor;
                entry.extras.wheels.forEach(w => { w.rotation.z = flywheelAng; });
                
                // Jaw reciprocating motion (eccentric shaft simulation)
                const swing = Math.sin(t * 28.27) * 0.06 * animFactor;
                entry.extras.jaw.position.x = -13.92 + swing;
                entry.extras.jaw.rotation.z = -0.20 + swing * 1.2;
                
                // Add subtle vibration to simulate crushing action
                entry.root.position.y = m.pos[1] + Math.sin(t * 12.0) * 0.002 * animFactor;
            }
            if (m.id === "DRC-101" && entry.extras && running && !state.paused) {
                // Counter-rotating rolls with slight speed variation
                const rollFactor = reducedMotion ? 0 : 1;
                entry.extras.rolls[0].rotation.z = t * 5.2 * rollFactor + Math.sin(t * 0.7) * 0.3 * rollFactor;
                entry.extras.rolls[1].rotation.z = -t * 5.2 * rollFactor + Math.sin(t * 0.7) * 0.3 * rollFactor;
            }
        });
        machineBeacons.instanceMatrix.needsUpdate = true;
        if (machineBeacons.instanceColor) machineBeacons.instanceColor.needsUpdate = true;

        // Update 11 conveyors + continuous troughed belt burden + InstancedMesh coal lumps
        for (const cd of conveyorData) {
            const flow = state.flowMap[cd.spec.id];
            const spd = (!state.paused && flow) ? flow.rate : 0;
            const isSelOrHov = state.selectedId === cd.spec.id || state.hoveredId === cd.spec.id;
            cd.selRing.visible = isSelOrHov;
            if (isSelOrHov) {
                cd.selRing.material.color.setHex(state.selectedId === cd.spec.id ? 0x38bdf8 : 0x93c5fd);
            }

            const activeFlow = flow && flow.rate > 0.02;
            cd.bedCoal.visible = !!activeFlow;
            if (activeFlow) {
                const bh = Math.min(0.16, Math.max(0.03, flow.rate * 0.14));
                cd.bedCoal.scale.y = bh;
                cd.bedCoal.position.y = 0.045 + bh * 0.5;
            }

            for (const p of cd.pulleys) {
                if (spd > 0) {
                    p.rotation.z -= dt * spd * 4.5;
                    // Move texture to simulate belt motion
                    if (p.material && p.material.map) {
                        p.material.map.offset.x += dt * spd * 0.1;
                        p.material.map.offset.y += dt * spd * 0.1;
                    }
                }
            }

            const lumpSize = cd.spec.lump;
            const right = cd.right;
            for (let i = 0; i < cd.parcelCount; i++) {
                if (!activeFlow) {
                    dummy.scale.set(0, 0, 0);
                    dummy.updateMatrix();
                    coalInstanced.setMatrixAt(cd.startIdx + i, dummy.matrix);
                    continue;
                }
                const ptFrac = ((t * 0.24 * Math.max(0.2, spd) + i / cd.parcelCount) % 1.0 + 1.0) % 1.0;
                const pos = sampleCoalTrajectory(cd, ptFrac);
                const jitterScale = ptFrac <= 0.82 ? 1.0 : Math.max(0.15, 1.0 - (ptFrac - 0.82) / 0.18);
                pos.addScaledVector(right, Math.sin(i * 3.1) * cd.spec.width * 0.16 * jitterScale);
                if (ptFrac <= 0.82) pos.y += 0.14;
                dummy.position.copy(pos);
                dummy.rotation.set(i * 0.4, i * 0.9, 0);
                dummy.scale.set(lumpSize * 1.35, lumpSize * 0.9, lumpSize * 1.15);
                dummy.updateMatrix();
                coalInstanced.setMatrixAt(cd.startIdx + i, dummy.matrix);
            }

            cd.arrows.forEach((cm, a) => {
                cm.visible = state.showArrows && flow && flow.rate > 0.02;
                if (cm.visible) {
                    const af = ((t * 0.35 * Math.max(0.25, spd) + a / cd.arrows.length) % 1.0 + 1.0) % 1.0;
                    cm.position.lerpVectors(cd.tail, cd.head, af);
                    cm.position.y += 0.65;
                }
            });
        }

        // FEL-101 coal dump boulders into BN-101
        for (let i = 0; i < dumpLumps; i++) {
            if (!lp.dumping) {
                dummy.scale.set(0, 0, 0);
                dummy.updateMatrix();
                coalInstanced.setMatrixAt(dumpStartIdx + i, dummy.matrix);
            } else {
                const f = (t * 2.6 + i / dumpLumps) % 1.0;
                const ox = lp.x, oy = lp.y + 2.35, oz = lp.z - 2.1;
                const tx = -13.8, ty = 6.50, tz = 8.8;
                dummy.position.set(
                    lerp(ox, tx, f) + Math.sin(i * 2.1) * 0.22,
                    lerp(oy, ty, f) - f * f * 0.35,
                    lerp(oz, tz, f) + Math.cos(i * 1.7) * 0.22
                );
                dummy.rotation.set(t * 2 + i, i * 0.8, 0);
                dummy.scale.setScalar(0.38);
                dummy.updateMatrix();
                coalInstanced.setMatrixAt(dumpStartIdx + i, dummy.matrix);
            }
        }
        coalInstanced.instanceMatrix.needsUpdate = true;

        // Soft radial billboarded dust plumes & pressurized desliming water spray curtains
        let dsIdx = 0;
        const emitSoft = (nodeId, ox, oy, oz, spread, riseH, baseS, isWater, count) => {
            const f = state.flowMap[nodeId];
            const active = (nodeId === "BN-101" && lp.dumping) || (f && f.running && f.rate > 0.04);
            for (let i = 0; i < count; i++) {
                if (!active) {
                    dummy.scale.set(0, 0, 0);
                    dummy.updateMatrix();
                    dustSprayInstanced.setMatrixAt(dsIdx++, dummy.matrix);
                    continue;
                }
                const age = (t * (isWater ? 1.55 : 0.42) + i / count) % 1.0;
                const ang = i * 2.39996 + t * (isWater ? 0.6 : 0.35);
                const rad = spread * (0.25 + age * 0.85);
                const py = isWater ? (oy - age * riseH + Math.sin(age * Math.PI) * 0.06) : (oy + age * riseH);
                const s = baseS * (isWater ? (0.45 + age * 0.65) : (0.65 + age * 1.65)) * Math.sin(age * Math.PI);
                dummy.position.set(ox + Math.cos(ang) * rad, py, oz + Math.sin(ang) * rad);
                dummy.quaternion.copy(camera.quaternion);
                dummy.scale.set(isWater ? s * 0.85 : s * 1.35, isWater ? s * 1.45 : s * 1.10, 1.0);
                dummy.updateMatrix();
                dustSprayInstanced.setMatrixAt(dsIdx, dummy.matrix);
                tmpColor.setRGB(isWater ? 0.72 : 0.36, isWater ? 0.90 : 0.31, isWater ? 1.0 : 0.26);
                dustSprayInstanced.setColorAt(dsIdx++, tmpColor);
            }
        };
        emitSoft("BN-101", -13.8, 6.70, 8.8, 0.85, 1.85, 0.56, false, 10);
        emitSoft("JC-101", -13.8, 3.15, -0.6, 0.72, 1.95, 0.52, false, 10);
        emitSoft("DRC-101", -7.2, 2.85, -0.6, 0.68, 1.75, 0.48, false, 9);
        emitSoft("SS-101", 0.2, 3.30, 0.5, 0.95, 1.45, 0.46, false, 8);
        emitSoft("DS-201", 8.8, 2.75, -9.8, 0.78, 1.05, 0.28, true, 14);
        emitSoft("WP-301", -2.3, 3.05, -6.8, 0.95, 0.75, 0.26, true, 10);
        emitSoft("WP-301", -2.3, 3.05, -8.4, 0.95, 0.75, 0.26, true, 10);
        dustSprayInstanced.instanceMatrix.needsUpdate = true;
        if (dustSprayInstanced.instanceColor) dustSprayInstanced.instanceColor.needsUpdate = true;

        // Individual sub-equipment & pipe selection/hover highlights
        for (const [id, hl] of Object.entries(subHighlights)) {
            const sel = state.selectedId === id;
            const hov = state.hoveredId === id;
            hl.box.material.opacity = sel ? 0.22 + 0.08 * Math.sin(t * 4.5) : (hov ? 0.14 : 0.0);
            hl.box.material.color.setHex(sel ? 0x38bdf8 : 0x93c5fd);
            hl.edges.visible = sel || hov;
            if (hl.edges.visible) hl.edges.material.color.setHex(sel ? 0x38bdf8 : 0x93c5fd);
        }
        for (const r of PIPE_ROUTES) {
            const sel = state.selectedId === r.id;
            const hov = state.hoveredId === r.id;
            r.mat.emissive.setHex(sel ? 0x38bdf8 : (hov ? 0x93c5fd : 0x000000));
            r.mat.emissiveIntensity = sel ? 0.85 : (hov ? 0.48 : 0.0);
        }

        // Pipe flow spheres
        for (const ps of pipeFlowSpheres) {
            const eq = eqMap[ps.route.src];
            const spd = eq && (eq.status === "Stopped" || eq.status === "Fault") ? 0 : 0.30;
            ps.mesh.visible = spd > 0;
            if (ps.mesh.visible) {
                const pf = (t * spd + ps.offset) % 1.0;
                const pts = ps.route.pts.map(x => new THREE.Vector3(...x));
                ps.mesh.position.copy(samplePolyline(pts, pf));
            }
        }

        // Project & declutter 2D HTML labels by camera distance/zoom
        if (state.showLabels) {
            const w = container.clientWidth, h = container.clientHeight;
            const camDist = camera.position.distanceTo(controls.target);
            for (const n of ALL_NODES) {
                const lbl = labelElems[n.id];
                const isSel = state.selectedId === n.id;
                const isHov = state.hoveredId === n.id;
                const pos = n.id === "FEL-101" ? [lp.x, lp.y, lp.z] : n.pos;
                labelWorldPos.set(pos[0], pos[1] + n.labelH, pos[2]);
                const nodeDist = camera.position.distanceTo(labelWorldPos);

                let allow = false;
                if (isSel || isHov) {
                    allow = true;
                } else if (n.isSub || n.isPipe) {
                    allow = camDist < 13.5 && nodeDist < 12.5;
                } else if (n.isConveyor) {
                    allow = camDist < 36.0 || nodeDist < 24.0;
                } else {
                    allow = camDist < 58.0;
                }

                if (!allow) {
                    lbl.style.display = "none";
                    continue;
                }
                projVec.copy(labelWorldPos).project(camera);
                const sx = (projVec.x * 0.5 + 0.5) * w;
                const sy = (-projVec.y * 0.5 + 0.5) * h;
                if (projVec.z > 1 || projVec.z < -1 || sx < -20 || sx > w + 20 || sy < -10 || sy > h + 20) {
                    lbl.style.display = "none";
                } else {
                    lbl.style.display = "block";
                    lbl.style.left = `${sx}px`;
                    lbl.style.top = `${sy}px`;
                    lbl.classList.toggle("selected", isSel);
                    lbl.classList.toggle("hovered", isHov && !isSel);
                }
            }
        }

        controls.update();
        if (state.postFx && composer) {
            composer.render();
        } else {
            renderer.render(scene, camera);
        }
    }

    requestAnimationFrame(animate);
} catch (err) {
    startOfflineFallback(err?.message || err);
}

// Post-processing toggles
const ppBars = document.querySelectorAll('[data-toggles]');
if (ppBars.length > 0) {
    ppBars.forEach(btn => {
        btn.addEventListener('click', () => {
            const toggle = btn.dataset.toggles;
            const isActive = btn.classList.toggle('active');
            
            if (toggle === 'bloom' && composer && bloomPass) {
                bloomPass.enabled = isActive;
            }
            if (toggle === 'n8ao' && composer && n8aoPass) {
                n8aoPass.enabled = isActive;
                if (n8aoPass.configuration) {
                    n8aoPass.configuration.halfRes = !isActive;
                }
            }
        });
    });
}
</script>
</body>
</html>
