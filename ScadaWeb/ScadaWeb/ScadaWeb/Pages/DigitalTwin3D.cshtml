            g.rotation.z = cd.pitch;
            g.userData.nodeId = nodeId;
            const hw = cd.spec.width * 0.52;
            for (const side of [-hw, hw]) {
                const post = new THREE.Mesh(new THREE.BoxGeometry(0.10, 0.48, 0.08), darkSteelMat);
                post.position.set(0, 0.18, side);
                post.userData.nodeId = nodeId;
                g.add(post);
            }
            const bridge = new THREE.Mesh(new THREE.BoxGeometry(0.14, 0.10, cd.spec.width * 1.18), railMat);
            bridge.position.set(0, 0.40, 0);
            bridge.userData.nodeId = nodeId;
            g.add(bridge);
            const box = new THREE.Mesh(new THREE.BoxGeometry(0.24, 0.22, 0.14), railMat);
            box.position.set(0, 0.20, hw + 0.10);
            box.userData.nodeId = nodeId;
            g.add(box);
            scene.add(g);
            pickTargets.push(g);
        };
        addBeltWeigher("BW-101", "CV-101", 0.40);
        addBeltWeigher("BW-102", "CV-102", 0.38);
        addBeltWeigher("BW-201", "CV-201", 0.45);

        // RC-101, RC-102: belt rip-chord & pull-wire emergency switches
        const addRipChord = (nodeId, convId, frac) => {
            const cd = conveyorData.find(x => x.spec.id === convId);
            if (!cd) return;
            const p = new THREE.Vector3().lerpVectors(cd.tail, cd.head, frac);
