    }
    const cycle = 12.0;
    const t = ((simTime % cycle) + cycle) % cycle / cycle;
    const zStock = 14.3, zTop = 11.75, zToe = 13.1, yTop = 0.88;
    let z, y, yaw, pitch, boom, dump = 0, dumping = false, dumpInt = 0;

    if (t < 0.14) {
        const u = smooth01(t / 0.14);
        z = zStock + Math.sin(u * Math.PI) * 0.25;
        y = 0; yaw = -90; pitch = 0; boom = 4 + u * 6; dump = 12 * (1 - u);
    } else if (t < 0.32) {
        const u = smooth01((t - 0.14) / 0.18);
        const turnU = smooth01(Math.min(1, (t - 0.14) / 0.08));
        z = lerp(zStock, zTop, u);
        const rf = Math.max(0, Math.min(1, (zToe - z) / (zToe - zTop)));
        y = rf * yTop; yaw = lerp(-90, 90, turnU); pitch = rf * 14; boom = lerp(10, 38, u);
    } else if (t <= 0.48) {
        const u = (t - 0.32) / 0.16;
        z = zTop; y = yTop; yaw = 90; pitch = 14; boom = 38;
        const dc = Math.sin(u * Math.PI);
        dump = (u >= 0.18 && u <= 0.78) ? -58 : -58 * smooth01(Math.min(u * 2.2, 1) * (u < 0.85 ? 1 : (1 - (u - 0.85) / 0.15)));
        dumping = true; dumpInt = dc;
    } else if (t < 0.74) {
        const u = smooth01((t - 0.48) / 0.26);
        z = lerp(zTop, zStock, u);
        const rf = Math.max(0, Math.min(1, (zToe - z) / (zToe - zTop)));
        y = rf * yTop; yaw = 90; pitch = rf * 14; boom = lerp(38, 6, u);
        dump = lerp(-58, 0, Math.min(1, u * 1.6));
    } else {
        const u = smooth01((t - 0.74) / 0.26);
        z = zStock; y = 0; yaw = lerp(90, -90, u); pitch = 0; boom = lerp(6, 4, u); dump = lerp(0, 12, u);
    }
    return { x: -13.8, y, z, yaw, pitch, boom, dump, dumping, dumpInt, binPulse: dumping ? 0.14 * dumpInt : 0 };
}

function getEqSpeedFactor(eq) {
    if (!eq) return 0.78;
    if (eq.status === "Stopped" || eq.status === "Fault" || eq.status === "Offline") return 0.0;
    return Math.max(0.35, Math.min(1.30, 0.35 + (eq.loadPct / 100.0) * 0.95));
}

function evaluateProcessFlows(simTime) {
    const eqMap = state.telemetry?.equipment || {};
    const rates = {};
    const localSpeeds = {};
    for (const n of ALL_NODES) {
        const s = getEqSpeedFactor(eqMap[n.scada]);
        localSpeeds[n.id] = s;
        rates[n.id] = s;
    }
    const lp = computeLoaderPose(simTime, (localSpeeds["FEL-101"] || 0) > 0);
    const binWave = 0.92 + 0.16 * lp.dumpInt;

    for (let pass = 0; pass < 16; pass++) {
        let maxDelta = 0;
        for (const n of ALL_NODES) {
            const local = localSpeeds[n.id];
            if (local <= 0) {
                maxDelta = Math.max(maxDelta, Math.abs(rates[n.id]));
                rates[n.id] = 0;
                continue;
            }
            if (n.up.length === 0) {
                maxDelta = Math.max(maxDelta, Math.abs(rates[n.id] - local));
                rates[n.id] = local;
                continue;
            }
            let upFactor = 0;
            if (n.id === "SS-101") upFactor = 0.45 * (rates["CV-102"] || 0) + 0.55 * (rates["CV-104"] || 0);
            else if (n.id === "DRC-101") upFactor = rates["CV-106"] || 0;
            else if (n.id === "CV-104") upFactor = 0.72 * (rates["CV-103"] || 0) + 0.28 * (rates["DRC-101"] || 0);
            else if (n.id === "WP-301") upFactor = (rates["CV-203"] || 0) * ((rates["TK-301"] || 0) > 0.05 ? 1.0 : 0.25);
            else if (n.id === "BN-101") upFactor = (rates["FEL-101"] || 0) * binWave;
            else {
                for (const u of n.up) upFactor = Math.max(upFactor, rates[u] || 0);
            }
            const nextRate = Math.max(0, Math.min(1.35, local * Math.max(0, Math.min(1.25, upFactor))));
            maxDelta = Math.max(maxDelta, Math.abs(nextRate - rates[n.id]));
            rates[n.id] = nextRate;
        }
        if (maxDelta < 1e-4) break;
    }

    const out = {};
    for (const n of ALL_NODES) {
        const local = localSpeeds[n.id];
        const eff = rates[n.id];
        out[n.id] = {
            rate: eff,
            running: local > 0,
            starved: local > 0 && n.up.length > 0 && eff < 0.05,
            tph: Math.round(n.nomTph * eff * 10) / 10
        };
    }
    state.flowMap = out;
}

