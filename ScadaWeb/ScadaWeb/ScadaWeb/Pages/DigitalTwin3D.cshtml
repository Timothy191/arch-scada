@page
@model DigitalTwin3DModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>CHPP 3D Digital Twin (Read-Only) - Arch SCADA</title>
    <link rel="icon" href="~/favicon.ico" type="image/x-icon" />
    <style>
        :root {
            --bg-canvas: #070d1a;
            --bg-panel: rgba(12, 20, 36, 0.90);
            --bg-card: rgba(19, 30, 52, 0.86);
            --bg-chip: rgba(30, 41, 59, 0.85);
            --border: rgba(56, 189, 248, 0.22);
            --border-strong: rgba(56, 189, 248, 0.45);
            --text-primary: #e2e8f0;
            --text-secondary: #94a3b8;
            --text-muted: #64748b;
            --accent: #38bdf8;
            --accent-strong: #0284c7;
            --emerald: #22c55e;
            --amber: #f59e0b;
            --red: #ef4444;
            --teal: #14b8a6;
            --shadow: 0 12px 32px rgba(2, 6, 23, 0.55);
        }

        html[data-theme="light"] {
            --bg-canvas: #e2e8f0;
            --bg-panel: rgba(248, 250, 252, 0.94);
            --bg-card: rgba(255, 255, 255, 0.94);
            --bg-chip: rgba(226, 232, 240, 0.92);
            --border: rgba(15, 23, 42, 0.14);
            --border-strong: rgba(2, 132, 199, 0.45);
            --text-primary: #0f172a;
            --text-secondary: #334155;
            --text-muted: #64748b;
            --accent: #0284c7;
            --accent-strong: #0369a1;
            --shadow: 0 10px 26px rgba(15, 23, 42, 0.14);
        }

        * { box-sizing: border-box; }
        html, body {
            margin: 0;
            padding: 0;
            width: 100%;
            height: 100%;
            overflow: hidden;
            background: var(--bg-canvas);
            color: var(--text-primary);
            font-family: "Inter", "Segoe UI", system-ui, -apple-system, sans-serif;
            font-size: 12.5px;
        }

        #app-shell {
            display: grid;
            grid-template-rows: auto 1fr;
            grid-template-columns: 1fr 370px;
            width: 100%;
            height: 100%;
        }

        /* Top HUD Bar */
        #top-bar {
            grid-column: 1 / -1;
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            padding: 8px 14px;
            background: var(--bg-panel);
            border-bottom: 1px solid var(--border);
            backdrop-filter: blur(10px);
            z-index: 30;
        }

        .brand-group {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
        }

        .brand-title {
            font-weight: 700;
            letter-spacing: 0.05em;
            font-size: 13.5px;
            color: var(--text-primary);
        }

        .badge {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 3px 8px;
            border-radius: 999px;
            font-size: 10.5px;
            font-weight: 700;
            letter-spacing: 0.04em;
            border: 1px solid transparent;
            white-space: nowrap;
        }

        .badge-ro {
            background: rgba(2, 132, 199, 0.18);
            border-color: rgba(56, 189, 248, 0.45);
            color: var(--accent);
        }

        .badge-demo {
            background: rgba(245, 158, 11, 0.16);
            border-color: rgba(245, 158, 11, 0.45);
            color: var(--amber);
        }

        .badge-live {
            background: rgba(34, 197, 94, 0.16);
            border-color: rgba(34, 197, 94, 0.45);
            color: var(--emerald);
        }

        .kpi-strip {
            display: flex;
            align-items: center;
            gap: 8px;
            flex-wrap: wrap;
        }

        .kpi-chip {
            background: var(--bg-chip);
            border: 1px solid var(--border);
            border-radius: 6px;
            padding: 3px 8px;
            display: flex;
            align-items: baseline;
            gap: 5px;
        }

        .kpi-chip .k { color: var(--text-muted); font-size: 10.5px; }
        .kpi-chip .v { color: var(--text-primary); font-weight: 700; font-variant-numeric: tabular-nums; }

        .toolbar-actions {
            display: flex;
            align-items: center;
            gap: 6px;
            flex-wrap: wrap;
        }

        .btn-hud {
            background: var(--bg-chip);
            color: var(--text-primary);
            border: 1px solid var(--border);
            border-radius: 6px;
            padding: 4px 9px;
            font-size: 11px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.15s ease;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 4px;
        }

        .btn-hud:hover {
            border-color: var(--border-strong);
            color: var(--accent);
        }

        .btn-hud.active {
            background: rgba(56, 189, 248, 0.20);
            border-color: var(--accent);
            color: var(--accent);
        }

        /* 3D Viewport */
        #viewport-wrap {
            position: relative;
            overflow: hidden;
            background: radial-gradient(circle at 50% 35%, #0f1b33 0%, var(--bg-canvas) 75%);
        }

        html[data-theme="light"] #viewport-wrap {
            background: radial-gradient(circle at 50% 35%, #f1f5f9 0%, #cbd5e1 85%);
        }

        #gl-container, #fallback-canvas {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            display: block;
        }

        #labels-overlay {
            position: absolute;
            inset: 0;
            pointer-events: none;
            overflow: hidden;
            z-index: 10;
        }

        .node-label {
            position: absolute;
            transform: translate(-50%, -100%);
            background: var(--bg-panel);
            border: 1px solid var(--border);
            border-radius: 5px;
            padding: 2px 6px;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 0.03em;
            color: var(--text-primary);
            white-space: nowrap;
            box-shadow: 0 2px 8px rgba(0,0,0,0.35);
            pointer-events: auto;
            cursor: pointer;
            transition: border-color 0.15s;
        }

        .node-label.selected {
            border-color: var(--accent);
            background: rgba(2, 132, 199, 0.88);
            color: #fff;
        }

        .node-label .dot {
            display: inline-block;
            width: 6px;
            height: 6px;
            border-radius: 50%;
            margin-right: 4px;
            vertical-align: middle;
        }

        /* Camera Preset Dock */
        #camera-bar {
            position: absolute;
            left: 12px;
            bottom: 12px;
            right: 12px;
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
            padding: 8px 10px;
            background: var(--bg-panel);
            border: 1px solid var(--border);
            border-radius: 10px;
            backdrop-filter: blur(10px);
            box-shadow: var(--shadow);
            z-index: 20;
        }

        .preset-btn {
            background: var(--bg-chip);
            color: var(--text-secondary);
            border: 1px solid var(--border);
            border-radius: 6px;
            padding: 5px 9px;
            font-size: 11px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.15s;
        }

        .preset-btn:hover {
            color: var(--text-primary);
            border-color: var(--border-strong);
        }

        .preset-btn.active {
            background: var(--accent-strong);
            border-color: var(--accent);
            color: #fff;
        }

        #offline-banner {
            position: absolute;
            top: 12px;
            left: 12px;
            max-width: 520px;
            padding: 8px 12px;
            background: rgba(245, 158, 11, 0.16);
            border: 1px solid rgba(245, 158, 11, 0.5);
            border-radius: 8px;
            color: var(--text-primary);
            font-size: 11.5px;
            z-index: 25;
            display: none;
            backdrop-filter: blur(8px);
        }

        #status-pill {
            position: absolute;
            top: 12px;
            right: 12px;
            padding: 5px 10px;
            background: var(--bg-panel);
            border: 1px solid var(--border);
            border-radius: 8px;
            font-size: 11px;
            color: var(--text-secondary);
            z-index: 20;
            pointer-events: none;
        }

        /* Inspector Sidebar */
        #inspector {
            background: var(--bg-panel);
            border-left: 1px solid var(--border);
            display: flex;
            flex-direction: column;
            overflow: hidden;
            z-index: 25;
        }

        .insp-header {
            padding: 8px 12px;
            border-bottom: 1px solid var(--border);
            background: var(--bg-card);
        }

        .insp-title-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 8px;
        }

        .insp-id {
            font-size: 15px;
            font-weight: 800;
            color: var(--accent);
            letter-spacing: 0.03em;
        }

        .insp-stage {
            font-size: 10px;
            font-weight: 700;
            color: var(--accent);
            text-transform: uppercase;
            letter-spacing: 0.05em;
            margin-top: 1px;
        }

        .insp-ga {
            font-size: 12.5px;
            font-weight: 700;
            margin-top: 2px;
        }

        .insp-body {
            padding: 8px 10px;
            overflow: hidden;
            flex: 1;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            gap: 6px;
        }

        .insp-card {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: 7px;
            padding: 7px 9px;
        }

        .insp-card h4 {
            margin: 0 0 4px 0;
            font-size: 10px;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            color: var(--text-muted);
        }

        .kv-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 4px 8px;
        }

        .kv-item .k { font-size: 9.5px; color: var(--text-muted); }
        .kv-item .v { font-size: 12px; font-weight: 700; font-variant-numeric: tabular-nums; }

        .flow-links {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 4px;
        }

        .node-pill {
            background: var(--bg-chip);
            border: 1px solid var(--border);
            border-radius: 5px;
            padding: 2px 6px;
            font-size: 10.5px;
            font-weight: 700;
            color: var(--text-primary);
            cursor: pointer;
        }

        .node-pill:hover { border-color: var(--accent); color: var(--accent); }
        .node-pill.current { background: var(--accent-strong); border-color: var(--accent); color: #fff; }

        .node-directory {
            display: grid;
            grid-template-columns: repeat(6, 1fr);
            gap: 3px;
            overflow: hidden;
        }

        .dir-btn {
            background: var(--bg-chip);
            border: 1px solid var(--border);
            border-radius: 4px;
            padding: 2px 3px;
            font-size: 10px;
            font-weight: 600;
            color: var(--text-secondary);
            text-align: center;
            cursor: pointer;
        }

        .dir-btn:hover { color: var(--text-primary); border-color: var(--border-strong); }
        .dir-btn.active { background: var(--accent-strong); border-color: var(--accent); color: #fff; }

        .status-tag {
            padding: 2px 8px;
            border-radius: 999px;
            font-size: 10.5px;
            font-weight: 700;
        }
        .st-Running { background: rgba(34, 197, 94, 0.18); color: var(--emerald); border: 1px solid rgba(34, 197, 94, 0.45); }
        .st-Warning { background: rgba(245, 158, 11, 0.18); color: var(--amber); border: 1px solid rgba(245, 158, 11, 0.45); }
        .st-Fault { background: rgba(239, 68, 68, 0.22); color: var(--red); border: 1px solid rgba(239, 68, 68, 0.55); }
        .st-Stopped { background: rgba(100, 116, 139, 0.22); color: var(--text-secondary); border: 1px solid rgba(100, 116, 139, 0.45); }

        @@media (max-width: 1024px) {
            #app-shell {
                grid-template-columns: 1fr;
                grid-template-rows: auto 58vh 1fr;
            }
            #inspector {
                border-left: none;
                border-top: 1px solid var(--border);
            }
        }
    </style>
    <script type="importmap">
    {
        "imports": {
            "three": "https://cdn.jsdelivr.net/npm/three@0.170.0/build/three.module.js",
            "three/addons/": "https://cdn.jsdelivr.net/npm/three@0.170.0/examples/jsm/"
        }
    }
    </script>
</head>
<body>
<div id="app-shell">
    <!-- Top HUD -->
    <header id="top-bar">
        <div class="brand-group">
            <span class="brand-title">ARCH SCADA · CHPP 3D DIGITAL TWIN</span>
            <span class="badge badge-ro" title="Zero PLC Write Path · HTTP GET Only">READ-ONLY · NO PLC WRITE</span>
            <span id="provenance-badge" class="badge badge-demo">SIMULATED DEMO TELEMETRY · READ-ONLY</span>
            <span class="badge badge-ro" style="opacity:0.85;">SITE CONFIRMED GA · 29 NODES</span>
        </div>

        <div class="kpi-strip">
            <div class="kpi-chip"><span class="k">ROM</span><span class="v" id="kpi-rom">640.0 t/h</span></div>
            <div class="kpi-chip"><span class="k">Clean</span><span class="v" id="kpi-clean">408.0 t/h</span></div>
            <div class="kpi-chip"><span class="k">Med SG</span><span class="v" id="kpi-sg">1.52</span></div>
            <div class="kpi-chip"><span class="k">Water</span><span class="v" id="kpi-water">87.4%</span></div>
            <div class="kpi-chip"><span class="k">Ash</span><span class="v" id="kpi-ash">9.40%</span></div>
            <div class="kpi-chip"><span class="k">GLB</span><span class="v" id="kpi-glb">0/16</span></div>
            <div class="kpi-chip"><span class="k">FPS</span><span class="v" id="kpi-fps">--</span></div>
        </div>

        <div class="toolbar-actions">
            <button type="button" class="btn-hud active" id="btn-labels">Labels</button>
            <button type="button" class="btn-hud active" id="btn-arrows">Flow Chevrons</button>
            <button type="button" class="btn-hud" id="btn-thermal">Thermal Heatmap</button>
            <button type="button" class="btn-hud" id="btn-pause">Pause</button>
            <button type="button" class="btn-hud" id="btn-theme">Light HUD</button>
            <a class="btn-hud" href="~/About" title="ScadaWeb About">ScadaWeb</a>
        </div>
    </header>

    <!-- 3D Viewport -->
    <main id="viewport-wrap">
        <div id="gl-container"></div>
        <canvas id="fallback-canvas" style="display:none;"></canvas>
        <div id="labels-overlay"></div>

        <div id="offline-banner">
            <strong>Offline Procedural Fallback Active:</strong> Three.js CDN could not be reached from this browser session. Displaying offline interactive GA schematic twin (read-only telemetry &amp; 29-node flow simulation remain active).
        </div>

        <div id="status-pill">PBR · ACES · 2048² PCF Shadows · Orbit: Drag | Pan: Right-Drag | Zoom: Wheel | Select: Click</div>

        <div id="camera-bar" role="toolbar" aria-label="GA Camera Presets"></div>
    </main>

    <!-- Equipment Identification & Process Flow Inspector -->
    <aside id="inspector" aria-label="Equipment Identification and Process Flow Inspector">
        <div class="insp-header">
            <div class="insp-title-row">
                <span class="insp-id" id="insp-id">JC-101</span>
                <span class="status-tag st-Running" id="insp-status">Running</span>
            </div>
            <div class="insp-stage" id="insp-stage">Stage 3 — Jaw Crushing</div>
            <div class="insp-ga" id="insp-ga">Primary Jaw Crusher</div>
        </div>

        <div class="insp-body">
            <div class="insp-card">
                <h4>Live / Coupled Process Telemetry (Read-Only)</h4>
                <div class="kv-grid">
                    <div class="kv-item"><div class="k">Load / Rate</div><div class="v" id="insp-load">78.4%</div></div>
                    <div class="kv-item"><div class="k">Throughput</div><div class="v" id="insp-tph">418.0 t/h</div></div>
                    <div class="kv-item"><div class="k">Motor Power</div><div class="v" id="insp-kw">266.0 kW</div></div>
                    <div class="kv-item"><div class="k">SCADA Group</div><div class="v" id="insp-scada">CR-101</div></div>
                </div>
                <div style="margin-top:8px; font-size:11px; color:var(--text-secondary);" id="insp-plc">
                    Direct PLC: CR101 (Modbus 10.10.1.11:502 · Cnl 101–103)
                </div>
                <div style="margin-top:4px; font-size:11px; color:var(--emerald); font-weight:600;" id="insp-prov-note">
                    [READ-ONLY] [SITE CONFIRMED]
                </div>
            </div>

            <div class="insp-card">
                <h4>Process Flow Topology</h4>
                <div style="font-size:10.5px; color:var(--text-muted); margin-bottom:5px;">Upstream → Selected → Downstream (click node to inspect)</div>
                <div class="flow-links" id="insp-topology"></div>
            </div>

            <div class="insp-card">
                <h4>Mechanical &amp; GA Specification</h4>
                <div style="font-size:11px; font-weight:700; margin-bottom:4px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;" id="insp-spec">3.1 m × 2.6 m × 3.0 m · CSS 110 mm · 315 kW</div>
                <div style="font-size:10.5px; color:var(--text-secondary); line-height:1.35; margin-bottom:4px; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden;" id="insp-principle"></div>
                <div style="font-size:10.5px; color:var(--text-muted); line-height:1.3; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden;" id="insp-desc"></div>
            </div>

            <div class="insp-card">
                <h4>All 29 GA Plant Nodes (18 Machines + 11 Conveyors)</h4>
                <div class="node-directory" id="node-directory"></div>
            </div>
        </div>
    </aside>
</div>

<script type="module">
// =============================================================================
// Authoritative 29-Node CHPP GA Scene Definition (100% synced with Desktop & Unity)
// =============================================================================
const MACHINE_NODES = [
    { id: "SP-001", ga: "ROM Raw Coal Stockpile", stage: "Stage 1 — ROM Reception", type: "Stockpile", glb: "stockpile_cone.glb", pos: [-13.8, 0, 16.4], yaw: 0, scale: [1.1, 0.9, 1.1], half: [2.1, 1.35, 2.1], labelH: 2.9, color: "#475569", spec: "Ø 16 m × 5.2 m cone (0–300 mm ROM)", principle: "Bulk run-of-mine coal stockpile reclaimed via front-end wheel loader bucket cycles.", desc: "Unscreened ROM raw coal reserve (0–300 mm) feeding Stage 1 primary hopper loading.", up: [], down: ["FEL-101"], scada: "AF-001", nomTph: 650, plc: "Derived Process Model (coupled to AF-001)" },
    { id: "FEL-101", ga: "Front-End Wheel Loader", stage: "Stage 1 — ROM Reception", type: "Mobile Wheel Loader", glb: "wheel_loader_chassis.glb", pos: [-13.8, 0, 13.4], yaw: 90, scale: [1, 1, 1], half: [1.1, 1.1, 1.4], labelH: 2.6, color: "#EAB308", spec: "3.4 m × 1.9 m × 2.4 m · 4.5 m³ rock bucket · 260 kW", principle: "4-stage shuttle cycle: scoop ROM at SP-001, climb BN-101 earthen ramp, raise boom (38°), tilt bucket (-58°) to dump, reverse.", desc: "Articulated diesel wheel loader with hydraulic lift arms and high-dump coal bucket.", up: ["SP-001"], down: ["BN-101"], scada: "AF-001", nomTph: 650, plc: "Derived Process Model (coupled to AF-001)" },
    { id: "BN-101", ga: "Feeder Bin / Receiving Hopper", stage: "Stage 1 — ROM Reception", type: "Receiving Hopper", glb: "feeder_bin_bn101.glb", pos: [-13.8, 0, 8.8], yaw: 90, scale: [1, 1, 1], half: [1.7, 1.55, 1.9], labelH: 3.35, color: "#B45309", spec: "4.0 m × 3.6 m × 3.2 m · 45 t surge capacity", principle: "Gravity surge hopper with inclined steel dump ramp and wear-lined discharge throat onto grizzly feeder.", desc: "Heavy-plate ROM receiving bin with loader ramp (-X rotated South toward FEL-101) and surge level monitoring.", up: ["FEL-101"], down: ["VF-101"], scada: "AF-001", nomTph: 650, fill: { r: 0.95, baseY: 1.45, maxH: 1.35, color: "#F59E0B" }, plc: "Derived Process Model (coupled to AF-001)" },
    { id: "VF-101", ga: "Primary Vibro Grizzly Feeder", stage: "Stage 2 — Initial Separation", type: "Vibrating Grizzly Feeder", glb: "vibro_feeder_vf101.glb", pos: [-13.8, 0.2, 6.2], yaw: 90, scale: [1, 1, 1], half: [1.1, 0.95, 1.4], labelH: 2.35, color: "#0284C7", spec: "3.2 m × 1.8 m × 1.7 m · 75 mm grizzly bar aperture · 30 kW", principle: "Dual eccentric unbalanced motors impart linear throw, scalping <75 mm fines onto CV-102 while advancing +75 mm oversize onto CV-101.", desc: "Heavy-duty tapered-bar grizzly feeder splitting ROM coal into Path A (Jaw Feed) and Path B (Undersize Bypass).", up: ["BN-101"], down: ["CV-101", "CV-102"], scada: "AF-001", nomTph: 650, vibrates: true, plc: "Derived Process Model (coupled to AF-001)" },
