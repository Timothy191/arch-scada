function buildUiChrome() {
    const camBar = document.getElementById("camera-bar");
    CAMERA_PRESETS.forEach((p, idx) => {
        const btn = document.createElement("button");
        btn.type = "button";
        btn.className = "preset-btn" + (p.name === state.activePreset ? " active" : "");
        btn.textContent = `${idx + 1}. ${p.name}`;
        btn.dataset.preset = p.name;
        btn.addEventListener("click", () => applyCameraPreset(p.name));
        camBar.appendChild(btn);
    });

    const dir = document.getElementById("node-directory");
    ALL_NODES.forEach(n => {
        const b = document.createElement("button");
        b.type = "button";
        b.className = "dir-btn" + (n.id === state.selectedId ? " active" : "");
        b.textContent = n.id;
        b.dataset.nodeId = n.id;
        b.title = `${n.id} — ${n.ga}`;
        b.addEventListener("click", () => selectNode(n.id, true));
        dir.appendChild(b);
    });

    document.getElementById("btn-labels").addEventListener("click", e => {
        state.showLabels = !state.showLabels;
        e.currentTarget.classList.toggle("active", state.showLabels);
        document.getElementById("labels-overlay").style.display = state.showLabels ? "block" : "none";
    });
    document.getElementById("btn-arrows").addEventListener("click", e => {
        state.showArrows = !state.showArrows;
        e.currentTarget.classList.toggle("active", state.showArrows);
    });
    document.getElementById("btn-thermal").addEventListener("click", e => {
        state.thermalHeatmap = !state.thermalHeatmap;
        e.currentTarget.classList.toggle("active", state.thermalHeatmap);
    });
    document.getElementById("btn-pause").addEventListener("click", e => {
        state.paused = !state.paused;
        e.currentTarget.textContent = state.paused ? "Resume" : "Pause";
        e.currentTarget.classList.toggle("active", state.paused);
    });
    document.getElementById("btn-theme").addEventListener("click", e => {
        const root = document.documentElement;
        const next = root.getAttribute("data-theme") === "dark" ? "light" : "dark";
        root.setAttribute("data-theme", next);
        e.currentTarget.textContent = next === "dark" ? "Light HUD" : "Dark HUD";
        if (window.__updateThreeTheme) window.__updateThreeTheme(next);
    });

    window.addEventListener("keydown", ev => {
        if (ev.target && ["INPUT", "TEXTAREA", "SELECT"].includes(ev.target.tagName)) return;
        if (ev.key >= "1" && ev.key <= "9") {
            const p = CAMERA_PRESETS[Number(ev.key) - 1];
            if (p) applyCameraPreset(p.name);
        } else if (ev.key === "r" || ev.key === "R") {
            applyCameraPreset("Plant Overview");
        } else if (ev.key === "f" || ev.key === "F") {
            focusNode(state.selectedId);
        } else if (ev.key === " ") {
            ev.preventDefault();
            document.getElementById("btn-pause").click();
        }
    });
}

function selectNode(id, shouldFocus = false) {
    if (!NODE_BY_ID[id]) return;
    state.selectedId = id;
    document.querySelectorAll(".dir-btn").forEach(b => b.classList.toggle("active", b.dataset.nodeId === id));
    updateInspector();
    if (shouldFocus) focusNode(id);
}

function focusNode(id) {
    const n = NODE_BY_ID[id];
    if (!n) return;
    if (window.__focusTarget) window.__focusTarget(n.pos[0], n.pos[1] + 1.0, n.pos[2]);
}

function applyCameraPreset(name) {
    state.activePreset = name;
    document.querySelectorAll(".preset-btn").forEach(b => b.classList.toggle("active", b.dataset.preset === name));
    const p = CAMERA_PRESETS.find(x => x.name === name) || CAMERA_PRESETS[0];
    if (window.__applyPreset) window.__applyPreset(p);
}

function updateInspector() {
    const n = NODE_BY_ID[state.selectedId] || ALL_NODES[0];
    const eq = state.telemetry?.equipment?.[n.scada];
    const flow = state.flowMap[n.id];
    const statusText = flow?.starved ? "Warning" : (eq?.status || "Running");

    document.getElementById("insp-id").textContent = n.id;
    document.getElementById("insp-stage").textContent = n.stage;
    document.getElementById("insp-ga").textContent = n.ga;
    const stEl = document.getElementById("insp-status");
    stEl.textContent = flow?.starved ? "Starved" : statusText;
    stEl.className = "status-tag st-" + (statusText === "Offline" ? "Stopped" : statusText);

    document.getElementById("insp-load").textContent = eq ? `${eq.loadPct.toFixed(1)}%` : "78.0%";
    document.getElementById("insp-tph").textContent = flow ? `${flow.tph.toFixed(1)} t/h` : `${n.nomTph.toFixed(1)} t/h`;
    document.getElementById("insp-kw").textContent = eq ? `${eq.powerKw.toFixed(1)} kW` : "--";
    document.getElementById("insp-scada").textContent = n.scada;
    document.getElementById("insp-plc").textContent = n.plc;
    const isLive = !!state.telemetry?.isLive;
    const provEl = document.getElementById("insp-prov-note");
    provEl.textContent = `[READ-ONLY] [SITE CONFIRMED] · ${isLive ? "LIVE SCADA" : "SIMULATED DEMO"}`;
    provEl.style.color = isLive ? "var(--emerald)" : "var(--amber)";

    document.getElementById("insp-spec").textContent = n.spec;
    document.getElementById("insp-principle").textContent = n.principle;
    document.getElementById("insp-desc").textContent = n.desc;

    const topo = document.getElementById("insp-topology");
    topo.innerHTML = "";
    const addPill = (label, targetId, isCurrent = false) => {
        const el = document.createElement(targetId ? "button" : "span");
        if (targetId) el.type = "button";
        el.className = "node-pill" + (isCurrent ? " current" : "");
        el.textContent = label;
        if (targetId && !isCurrent) {
            el.addEventListener("click", () => selectNode(targetId, true));
        }
        topo.appendChild(el);
    };
    if (n.up.length === 0) addPill("ROM Source", null);
    else n.up.forEach(u => addPill(u, u));
    const arr1 = document.createElement("span"); arr1.textContent = "→"; arr1.style.color = "var(--text-muted)"; topo.appendChild(arr1);
    addPill(n.id, n.id, true);
    const arr2 = document.createElement("span"); arr2.textContent = "→"; arr2.style.color = "var(--text-muted)"; topo.appendChild(arr2);
    if (n.down.length === 0) addPill("Stockpile / Output", null);
    else n.down.forEach(d => addPill(d, d));
}

// =============================================================================
// Read-Only Telemetry Polling (GET /DigitalTwin3D?handler=Telemetry)
// =============================================================================
async function pollTelemetry() {
    try {
        const resp = await fetch("/DigitalTwin3D?handler=Telemetry", { method: "GET", cache: "no-store" });
        if (!resp.ok) return;
        const data = await resp.json();
        state.telemetry = data;

        const badge = document.getElementById("provenance-badge");
        badge.textContent = data.source || "SIMULATED DEMO TELEMETRY · READ-ONLY";
        badge.className = "badge " + (data.isLive ? "badge-live" : "badge-demo");

        if (data.plantTotals) {
            document.getElementById("kpi-rom").textContent = `${Number(data.plantTotals.romFeedTph).toFixed(1)} t/h`;
            document.getElementById("kpi-clean").textContent = `${Number(data.plantTotals.cleanProductTph).toFixed(1)} t/h`;
            document.getElementById("kpi-sg").textContent = Number(data.plantTotals.mediumSg).toFixed(2);
            document.getElementById("kpi-water").textContent = `${Number(data.plantTotals.waterRecoveryPct).toFixed(1)}%`;
            document.getElementById("kpi-ash").textContent = `${Number(data.plantTotals.ashPct).toFixed(2)}%`;
        }
        updateInspector();
    } catch {
        // Keep last known demo state if poll temporarily interrupted
    }
}

