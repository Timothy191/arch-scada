function startOfflineFallback(reason) {
    console.warn("[DigitalTwin3D] Falling back to offline 2D GA canvas:", reason);
    document.getElementById("offline-banner").style.display = "block";
    document.getElementById("status-pill").textContent = "Offline GA Twin Fallback · Read-Only";
    const canvas = document.getElementById("fallback-canvas");
    canvas.style.display = "block";
    const ctx = canvas.getContext("2d");

    const draw = (now) => {
        const rect = canvas.parentElement.getBoundingClientRect();
        if (canvas.width !== Math.floor(rect.width) || canvas.height !== Math.floor(rect.height)) {
            canvas.width = Math.max(1, Math.floor(rect.width));
            canvas.height = Math.max(1, Math.floor(rect.height));
        }
        if (!state.paused) state.simTime += 0.016;
        evaluateProcessFlows(state.simTime);

        const isDark = document.documentElement.getAttribute("data-theme") === "dark";
        ctx.fillStyle = isDark ? "#070d1a" : "#e2e8f0";
        ctx.fillRect(0, 0, canvas.width, canvas.height);

        const scale = Math.min(canvas.width / 34, canvas.height / 38);
        const ox = canvas.width * 0.5 + 1.5 * scale;
        const oz = canvas.height * 0.5;
        const toPx = (x, z) => [ox + x * scale, oz + z * scale];

        // Foundation pads
        for (const pad of FOUNDATION_PADS) {
            const [cx, cz] = toPx(pad.center[0], pad.center[2]);
            ctx.fillStyle = isDark ? "rgba(30,41,59,0.65)" : "rgba(255,255,255,0.85)";
            ctx.strokeStyle = pad.accent;
            ctx.lineWidth = 1.2;
            const w = pad.size[0] * scale, h = pad.size[2] * scale;
            ctx.fillRect(cx - w * 0.5, cz - h * 0.5, w, h);
            ctx.strokeRect(cx - w * 0.5, cz - h * 0.5, w, h);
        }

        // Conveyors
        for (const c of CONVEYORS) {
            const [x1, z1] = toPx(c.tail[0], c.tail[2]);
            const [x2, z2] = toPx(c.head[0], c.head[2]);
            ctx.strokeStyle = c.id === state.selectedId ? "#38bdf8" : c.matCol;
            ctx.lineWidth = c.id === state.selectedId ? 6 : 4;
            ctx.beginPath(); ctx.moveTo(x1, z1); ctx.lineTo(x2, z2); ctx.stroke();
        }

        // Machines
        const lp = computeLoaderPose(state.simTime, (state.flowMap["FEL-101"]?.rate || 0) > 0);
        for (const m of MACHINE_NODES) {
            const pos = m.id === "FEL-101" ? [lp.x, lp.y, lp.z] : m.pos;
            const [px, pz] = toPx(pos[0], pos[2]);
            const w = m.half[0] * 1.6 * scale, h = m.half[2] * 1.6 * scale;
            ctx.fillStyle = m.id === state.selectedId ? "#38bdf8" : m.color;
            ctx.fillRect(px - w * 0.5, pz - h * 0.5, w, h);
            ctx.fillStyle = isDark ? "#f8fafc" : "#0f172a";
            ctx.font = "bold 10px sans-serif";
            ctx.textAlign = "center";
            ctx.fillText(m.id, px, pz - h * 0.5 - 4);
        }
        requestAnimationFrame(draw);
    };
    canvas.addEventListener("click", ev => {
        const rect = canvas.getBoundingClientRect();
        const scale = Math.min(canvas.width / 34, canvas.height / 38);
        const ox = canvas.width * 0.5 + 1.5 * scale;
        const oz = canvas.height * 0.5;
        const wx = (ev.clientX - rect.left - ox) / scale;
        const wz = (ev.clientY - rect.top - oz) / scale;
        let best = null, bestD = 3.0;
        for (const n of ALL_NODES) {
            const d = Math.hypot(n.pos[0] - wx, n.pos[2] - wz);
            if (d < bestD) { bestD = d; best = n.id; }
        }
        if (best) selectNode(best, false);
    });
    requestAnimationFrame(draw);
}

try {
    const THREE = await import("three");
    const { OrbitControls } = await import("three/addons/controls/OrbitControls.js");
    const { GLTFLoader } = await import("three/addons/loaders/GLTFLoader.js");
    const { RoomEnvironment } = await import("three/addons/environments/RoomEnvironment.js");
    const { MeshoptDecoder } = await import("three/addons/libs/meshopt_decoder.module.js");
    const { EffectComposer } = await import("three/addons/postprocessing/EffectComposer.js");
    const { RenderPass } = await import("three/addons/postprocessing/RenderPass.js");
    const { UnrealBloomPass } = await import("three/addons/postprocessing/UnrealBloomPass.js");
    const { OutputPass } = await import("three/addons/postprocessing/OutputPass.js");

    const bvhMod = await import("three-mesh-bvh").catch(() => null);
    if (bvhMod && bvhMod.computeBoundsTree && bvhMod.disposeBoundsTree && bvhMod.acceleratedRaycast) {
        THREE.BufferGeometry.prototype.computeBoundsTree = bvhMod.computeBoundsTree;
        THREE.BufferGeometry.prototype.disposeBoundsTree = bvhMod.disposeBoundsTree;
        THREE.Mesh.prototype.raycast = bvhMod.acceleratedRaycast;
    }
    const n8aoMod = await import("n8ao").catch(() => null);

    const container = document.getElementById("gl-container");
    const renderer = new THREE.WebGLRenderer({ antialias: true, powerPreference: "high-performance" });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
    renderer.setSize(container.clientWidth, container.clientHeight);
    renderer.shadowMap.enabled = true;
    renderer.shadowMap.type = THREE.PCFSoftShadowMap;
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.08;
    container.appendChild(renderer.domElement);

    const scene = new THREE.Scene();
    scene.background = new THREE.Color(0x070d1a);
    scene.fog = new THREE.FogExp2(0x070d1a, 0.011);

    const pmrem = new THREE.PMREMGenerator(renderer);
    scene.environment = pmrem.fromScene(new RoomEnvironment(), 0.04).texture;

    const camera = new THREE.PerspectiveCamera(42, container.clientWidth / Math.max(1, container.clientHeight), 0.2, 160);
    const controls = new OrbitControls(camera, renderer.domElement);

    let composer = null;
    let n8aoPass = null;
    let bloomPass = null;
    try {
        const cw = Math.max(1, container.clientWidth);
        const ch = Math.max(1, container.clientHeight);
        composer = new EffectComposer(renderer);
        composer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
        composer.setSize(cw, ch);
        composer.addPass(new RenderPass(scene, camera));
        if (n8aoMod && n8aoMod.N8AOPass) {
            n8aoPass = new n8aoMod.N8AOPass(scene, camera, cw, ch);
            n8aoPass.setQualityMode("Medium");
            if (n8aoPass.configuration) {
                n8aoPass.configuration.aoRadius = 1.4;
                n8aoPass.configuration.distanceFalloff = 1.0;
                n8aoPass.configuration.intensity = 1.5;
                n8aoPass.configuration.halfRes = false;
            }
            composer.addPass(n8aoPass);
        }
        bloomPass = new UnrealBloomPass(new THREE.Vector2(cw, ch), 0.22, 0.35, 1.05);
        composer.addPass(bloomPass);
        composer.addPass(new OutputPass());
    } catch {
        composer = null;
        n8aoPass = null;
        bloomPass = null;
    }
    controls.enableDamping = true;
    controls.dampingFactor = 0.08;
    controls.maxPolarAngle = Math.PI * 0.485;
    controls.minDistance = 4;
    controls.maxDistance = 65;

    // Lighting: Hemisphere + 2048² PCFSoftShadowMap Sun + Cool Industrial Rim
    const hemi = new THREE.HemisphereLight(0xbcd8ff, 0x1a2436, 0.72);
    scene.add(hemi);

    const sun = new THREE.DirectionalLight(0xfff4e0, 2.35);
    sun.position.set(16, 28, 14);
    sun.castShadow = true;
    sun.shadow.mapSize.set(2048, 2048);
    sun.shadow.camera.near = 2;
    sun.shadow.camera.far = 80;
    sun.shadow.camera.left = -22;
    sun.shadow.camera.right = 22;
    sun.shadow.camera.top = 24;
    sun.shadow.camera.bottom = -24;
    sun.shadow.bias = -0.00045;
    sun.shadow.radius = 4; // Soft shadow radius
    scene.add(sun);

    const rimLight = new THREE.DirectionalLight(0x38bdf8, 0.55);
    rimLight.position.set(-18, 12, -18);
    scene.add(rimLight);

    // Ground Plane & Landscape
    // Black ground the plant stands on
    const groundMat = new THREE.MeshStandardMaterial({ color: 0x000000, roughness: 1.0, metalness: 0.0 });
    const ground = new THREE.Mesh(new THREE.PlaneGeometry(100, 100), groundMat);
    ground.rotation.x = -Math.PI / 2;
    ground.position.set(-1, -0.02, -1);
    ground.receiveShadow = true;
    scene.add(ground);

    const grid = new THREE.GridHelper(52, 26, 0x1e3a5f, 0x11223a);
    grid.position.set(-2, -0.005, -1);
    scene.add(grid);

// Coal spill piles under conveyors - small black piles
    const coalPileMat = new THREE.MeshStandardMaterial({ color: 0x232323, roughness: 0.6, metalness: 0.1 });
    const pilePositions = [
        // Under conveyors - small black coal spill piles
        { x: -13.8, y: 0.05, z: 5.4, width: 1.5, depth: 1.5, height: 0.5 },     // under CV-101
        { x: -1.9, y: 0.05, z: 1.15, width: 1.2, depth: 1.2, height: 0.4 },     // under CV-102
        { x: -8.3, y: 0.05, z: -0.6, width: 1.0, depth: 1.0, height: 0.3 },     // under CV-103
        { x: -7.2, y: 0.05, z: -0.6, width: 1.2, depth: 1.2, height: 0.4 },     // under DRC-101
        { x: 0.2, y: 0.05, z: 0.5, width: 1.0, depth: 1.0, height: 0.3 },      // under SS-101
        { x: 10.6, y: 0.05, z: -0.8, width: 1.0, depth: 1.0, height: 0.3 },    // under BN-201
        { x: 8.8, y: 0.05, z: -9.8, width: 1.0, depth: 1.0, height: 0.3 },     // under DS-201
        { x: -0.8, y: 0.05, z: -7.8, width: 1.5, depth: 1.5, height: 0.5 },    // under WP-301
    ];
    for (const pos of pilePositions) {
        const pile = new THREE.Mesh(
            new THREE.BoxGeometry(pos.width, pos.height, pos.depth),
            coalPileMat
        );
        pile.position.set(pos.x, pos.y, pos.z);
        pile.castShadow = true;
        pile.receiveShadow = true;
        scene.add(pile);
    }

    // 6 Concrete Foundation Pads
    const padMat = new THREE.MeshStandardMaterial({ color: 0x1e293b, roughness: 0.85, metalness: 0.12 });
    for (const pad of FOUNDATION_PADS) {
        const mesh = new THREE.Mesh(new THREE.BoxGeometry(...pad.size), padMat);
        mesh.position.set(...pad.center);
        mesh.receiveShadow = true;
        scene.add(mesh);

        const trim = new THREE.Mesh(
            new THREE.BoxGeometry(pad.size[0], 0.04, 0.14),
            new THREE.MeshStandardMaterial({ color: pad.accent, roughness: 0.4, metalness: 0.3 })
        );
        trim.position.set(pad.center[0], 0.02, pad.center[2] + pad.size[2] * 0.5 - 0.07);
        scene.add(trim);
    }

    // Elevated Stage 1 ROM Hill Terraces, North Retaining Wall & VF-101 Structural Tower
    const hillMat1 = new THREE.MeshStandardMaterial({ color: 0x383026, roughness: 0.92, metalness: 0.04 });
    const hillMat2 = new THREE.MeshStandardMaterial({ color: 0x40362b, roughness: 0.90, metalness: 0.04 });
    const wallMat = new THREE.MeshStandardMaterial({ color: 0x525c6b, roughness: 0.80, metalness: 0.10 });
    [
        { pos: [-13.8, 1.10, 13.8], size: [7.8, 2.20, 13.0], mat: hillMat1 },
        { pos: [-13.8, 2.80, 13.4], size: [6.8, 1.20, 12.2], mat: hillMat2 },
        { pos: [-13.8, 3.875, 13.0], size: [5.8, 0.95, 11.4], mat: padMat },
        { pos: [-13.8, 2.19, 7.25], size: [6.2, 4.38, 0.36], mat: wallMat }
    ].forEach(h => {
        const m = new THREE.Mesh(new THREE.BoxGeometry(...h.size), h.mat);
        m.position.set(...h.pos);
        m.castShadow = true; m.receiveShadow = true;
        scene.add(m);
    });
    const vfTowerMat = new THREE.MeshStandardMaterial({ color: 0x475569, roughness: 0.42, metalness: 0.72 });
    for (const xc of [-14.85, -12.75]) {
        for (const zc of [5.25, 7.05]) {
            const col = new THREE.Mesh(new THREE.BoxGeometry(0.18, 4.55, 0.18), vfTowerMat);
            col.position.set(xc, 2.275, zc);
            col.castShadow = true; col.receiveShadow = true;
            scene.add(col);
        }
    }
    const vfDeck = new THREE.Mesh(new THREE.BoxGeometry(2.28, 0.16, 1.98), vfTowerMat);
    vfDeck.position.set(-13.8, 4.47, 6.15);
    vfDeck.castShadow = true; vfDeck.receiveShadow = true;
    scene.add(vfDeck);

    const pickTargets = [];

    // 11 Orthogonal Slurry / Magnetite / Water Pipes (14 radial segs) + Instanced Flanges/Elbows & Valves
    const pipeFlowSpheres = [];
    const sphereGeo = new THREE.SphereGeometry(0.11, 10, 10);
    const flangeTransforms = [];
    for (const route of PIPE_ROUTES) {
        const pipeMat = new THREE.MeshStandardMaterial({ color: route.color, roughness: 0.34, metalness: 0.72 });
        route.mat = pipeMat;
        for (let i = 0; i < route.pts.length - 1; i++) {
            const a = new THREE.Vector3(...route.pts[i]);
            const b = new THREE.Vector3(...route.pts[i + 1]);
            const dir = new THREE.Vector3().subVectors(b, a);
            const len = dir.length();
            if (len < 0.01) continue;
            const dirN = dir.clone().normalize();
            const q = new THREE.Quaternion().setFromUnitVectors(new THREE.Vector3(0, 1, 0), dirN);
            const cyl = new THREE.Mesh(new THREE.CylinderGeometry(route.r, route.r, len, 14), pipeMat);
            cyl.position.addVectors(a, b).multiplyScalar(0.5);
            cyl.quaternion.copy(q);
            cyl.castShadow = true;
            cyl.receiveShadow = true;
            cyl.userData.nodeId = route.id;
            scene.add(cyl);
            pickTargets.push(cyl);

            // Bolted flanges at segment ends
            const fR = route.r * 1.55;
            flangeTransforms.push({ pos: a.clone().addScaledVector(dirN, Math.min(0.05, len * 0.2)), q, scale: [fR, 0.055, fR] });
            flangeTransforms.push({ pos: b.clone().addScaledVector(dirN, -Math.min(0.05, len * 0.2)), q, scale: [fR, 0.055, fR] });
            if (i > 0) {
                const eR = route.r * 1.32;
                flangeTransforms.push({ pos: a.clone(), q, scale: [eR, route.r * 2.1, eR] });
            }

            // Wider invisible pick sleeve so thin pipes are easy to click & hover individually
            const pick = new THREE.Mesh(new THREE.CylinderGeometry(route.r + 0.16, route.r + 0.16, len, 8),
                new THREE.MeshBasicMaterial({ transparent: true, opacity: 0.0, depthWrite: false }));
            pick.position.copy(cyl.position);
            pick.quaternion.copy(cyl.quaternion);
            pick.userData.nodeId = route.id;
            scene.add(pick);
            pickTargets.push(pick);
        }
        const pMat = new THREE.MeshBasicMaterial({ color: route.color });
        for (let k = 0; k < 5; k++) {
            const sp = new THREE.Mesh(sphereGeo, pMat);
            scene.add(sp);
            pipeFlowSpheres.push({ mesh: sp, route, offset: k / 5 });
        }
    }

    // 1 InstancedMesh for all pipe elbows & bolted flanges
    {
        const flangeMat = new THREE.MeshStandardMaterial({ color: 0x64748b, roughness: 0.36, metalness: 0.78 });
        const flangeInstanced = new THREE.InstancedMesh(new THREE.CylinderGeometry(1, 1, 1, 14), flangeMat, Math.max(1, flangeTransforms.length));
        flangeInstanced.castShadow = true;
        flangeInstanced.receiveShadow = true;
        const fd = new THREE.Object3D();
        flangeTransforms.forEach((ft, idx) => {
            fd.position.copy(ft.pos);
            fd.quaternion.copy(ft.q);
            fd.scale.set(...ft.scale);
            fd.updateMatrix();
            flangeInstanced.setMatrixAt(idx, fd.matrix);
        });
        flangeInstanced.instanceMatrix.needsUpdate = true;
        scene.add(flangeInstanced);
    }

    // 1 InstancedMesh for valve bodies, stems & handwheels (VALVE-201..204, VALVE-301..303, VALVE-305)
    {
        const valveNodes = SUB_EQUIPMENT_NODES.filter(sn => sn.id.startsWith("VALVE-"));
        const valveMat = new THREE.MeshStandardMaterial({ color: 0xffffff, roughness: 0.36, metalness: 0.68 });
        const valveInstanced = new THREE.InstancedMesh(new THREE.CylinderGeometry(1, 1, 1, 14), valveMat, Math.max(1, valveNodes.length * 3));
        valveInstanced.castShadow = true;
        valveInstanced.receiveShadow = true;
        const vd = new THREE.Object3D();
        const vc = new THREE.Color();
        valveNodes.forEach((vn, idx) => {
            const cx = vn.pos[0], cy = vn.pos[1] + vn.half[1], cz = vn.pos[2];
            const base = idx * 3;
            // Valve body
            vd.position.set(cx, cy, cz);
            vd.rotation.set(0, 0, Math.PI * 0.5);
            vd.scale.set(0.13, 0.24, 0.13);
            vd.updateMatrix();
            valveInstanced.setMatrixAt(base, vd.matrix);
            valveInstanced.setColorAt(base, vc.setHex(0x334155));
            // Valve stem
            vd.position.set(cx, cy + 0.17, cz);
            vd.rotation.set(0, 0, 0);
            vd.scale.set(0.035, 0.24, 0.035);
            vd.updateMatrix();
            valveInstanced.setMatrixAt(base + 1, vd.matrix);
            valveInstanced.setColorAt(base + 1, vc.setHex(0xcbd5e1));
            // Handwheel
            vd.position.set(cx, cy + 0.30, cz);
            vd.rotation.set(0, 0, 0);
            vd.scale.set(0.18, 0.042, 0.18);
            vd.updateMatrix();
            valveInstanced.setMatrixAt(base + 2, vd.matrix);
            valveInstanced.setColorAt(base + 2, vc.setHex(vn.id === "VALVE-202" ? 0xf59e0b : 0xef4444));
        });
        valveInstanced.instanceMatrix.needsUpdate = true;
        if (valveInstanced.instanceColor) valveInstanced.instanceColor.needsUpdate = true;
        scene.add(valveInstanced);
    }

    // Procedural Grounded Industrial Conveyors + InstancedMesh Coal Lumps
    const conveyorData = [];
    const handrailPostMatrices = [];
    const steelMat = new THREE.MeshStandardMaterial({ color: 0x475569, roughness: 0.45, metalness: 0.72 });
    const beltMat = new THREE.MeshStandardMaterial({ color: 0x3e4756, roughness: 0.88, metalness: 0.1 });
    const railMat = new THREE.MeshStandardMaterial({ color: 0xfacc15, roughness: 0.42, metalness: 0.3 });
    const motorMat = new THREE.MeshStandardMaterial({ color: 0x0284c7, roughness: 0.38, metalness: 0.65 });
    const pulleyMat = new THREE.MeshStandardMaterial({ color: 0xd97706, roughness: 0.4, metalness: 0.7 });
    const chevronMat = new THREE.MeshBasicMaterial({ color: 0x38bdf8 });
    const chevronGeo = new THREE.ConeGeometry(0.18, 0.42, 8);
    chevronGeo.rotateZ(-Math.PI / 2);

    let totalCoalInstances = 0;
    const samplePolyline = (pts, t) => {
        if (pts.length === 1) return pts[0].clone();
        let total = 0;
        const segs = [];
        for (let i = 0; i < pts.length - 1; i++) {
            const d = pts[i].distanceTo(pts[i + 1]);
            segs.push(d);
            total += d;
        }
        let target = Math.max(0, Math.min(1, t)) * total;
        for (let i = 0; i < segs.length; i++) {
            if (target <= segs[i] || i === segs.length - 1) {
                const f = segs[i] > 1e-5 ? target / segs[i] : 0;
                return new THREE.Vector3().lerpVectors(pts[i], pts[i + 1], Math.max(0, Math.min(1, f)));
            }
            target -= segs[i];
        }
        return pts[pts.length - 1].clone();
    };

    for (const c of CONVEYORS) {
        const grp = new THREE.Group();
        grp.userData.nodeId = c.id;
        scene.add(grp);
        pickTargets.push(grp);

        const tail = new THREE.Vector3(...c.tail);
        const head = new THREE.Vector3(...c.head);
        const delta = new THREE.Vector3().subVectors(head, tail);
        const len = delta.length();
        const dir = delta.clone().normalize();
        const yaw = Math.atan2(-dir.z, dir.x);
        const pitch = Math.asin(Math.max(-1, Math.min(1, dir.y)));
        const mid = new THREE.Vector3().addVectors(tail, head).multiplyScalar(0.5);
        const halfW = c.width * 0.5;

        const beltGrp = new THREE.Group();
        beltGrp.position.copy(mid);
        beltGrp.rotation.order = "YXZ";
        beltGrp.rotation.y = yaw;
        beltGrp.rotation.z = pitch;
        beltGrp.userData.nodeId = c.id;
        grp.add(beltGrp);

        // Belt bed + continuous troughed coal burden ribbon
        const bed = new THREE.Mesh(new THREE.BoxGeometry(len, 0.08, c.width * 0.90), beltMat);
        bed.castShadow = true; bed.receiveShadow = true; bed.userData.nodeId = c.id;
        beltGrp.add(bed);

        const isWetBelt = c.id === "CV-203" || c.id === "CV-301" || c.id === "CV-302";
        const bedCoal = new THREE.Mesh(
            new THREE.BoxGeometry(len * 0.96, 1.0, c.width * 0.56),
            new THREE.MeshPhysicalMaterial({
                color: c.matCol,
                roughness: isWetBelt ? 0.34 : 0.78,
                metalness: 0.08,
                clearcoat: isWetBelt ? 0.85 : 0.0,
                clearcoatRoughness: 0.16
            })
        );
        bedCoal.position.set(0, 0.08, 0);
        bedCoal.scale.y = 0.08;
        bedCoal.castShadow = true; bedCoal.receiveShadow = true; bedCoal.userData.nodeId = c.id;
        beltGrp.add(bedCoal);

        // Side stringers
        for (const side of [-halfW, halfW]) {
            const str = new THREE.Mesh(new THREE.BoxGeometry(len + 0.35, 0.22, 0.08), steelMat);
            str.position.set(0, -0.04, side);
            str.castShadow = true; str.receiveShadow = true; str.userData.nodeId = c.id;
            beltGrp.add(str);
        }

        // Tail loading skirtboards
        const skirtLen = Math.min(1.65, len * 0.28);
        const skirtX = -len * 0.5 + skirtLen * 0.5 + 0.05;
        for (const side of [-halfW * 0.88, halfW * 0.88]) {
            const sk = new THREE.Mesh(new THREE.BoxGeometry(skirtLen, 0.24, 0.05), steelMat);
            sk.position.set(skirtX, 0.14, side);
            sk.castShadow = true; sk.userData.nodeId = c.id;
            beltGrp.add(sk);
        }
        const skBack = new THREE.Mesh(new THREE.BoxGeometry(0.05, 0.24, c.width * 0.88), steelMat);
        skBack.position.set(-len * 0.5 + 0.05, 0.14, 0);
        skBack.castShadow = true; skBack.userData.nodeId = c.id;
        beltGrp.add(skBack);

        // Support trestles grounded at Y=0
        const bentCount = Math.max(2, Math.ceil(len / 3.5) + 1);
        for (let i = 0; i < bentCount; i++) {
            const frac = Math.max(0.08, Math.min(0.92, 0.10 + 0.80 * i / Math.max(1, bentCount - 1)));
            const bp = new THREE.Vector3().lerpVectors(tail, head, frac);
            const h = bp.y - 0.12;
            if (h <= 0.18) continue;
            const bent = new THREE.Group();
            bent.position.set(bp.x, 0, bp.z);
            bent.rotation.y = yaw;
            for (const side of [-halfW - 0.06, halfW + 0.06]) {
                const leg = new THREE.Mesh(new THREE.BoxGeometry(0.11, h, 0.11), steelMat);
                leg.position.set(0, h * 0.5, side);
                leg.castShadow = true; leg.receiveShadow = true;
                bent.add(leg);
            }
            if (h > 1.2) {
                const brace = new THREE.Mesh(new THREE.BoxGeometry(0.08, 0.08, c.width + 0.18), steelMat);
                brace.position.set(0, h * 0.52, 0);
                bent.add(brace);
            }
            grp.add(bent);
        }

        // Walkway, safety-yellow top/mid handrail & instanced handrail posts on elevated belts
        if (len > 4.2 || Math.abs(head.y - tail.y) > 0.6) {
            const walkLen = len * 0.92;
            const walk = new THREE.Mesh(new THREE.BoxGeometry(walkLen, 0.05, 0.52), steelMat);
            walk.position.set(0, -0.05, halfW + 0.34);
            walk.receiveShadow = true;
            beltGrp.add(walk);

            const rail = new THREE.Mesh(new THREE.BoxGeometry(walkLen, 0.05, 0.05), railMat);
            rail.position.set(0, 0.78, halfW + 0.58);
            beltGrp.add(rail);

            const midRail = new THREE.Mesh(new THREE.BoxGeometry(walkLen, 0.035, 0.035), railMat);
            midRail.position.set(0, 0.40, halfW + 0.58);
            beltGrp.add(midRail);

            beltGrp.updateMatrixWorld(true);
            const postCount = Math.max(2, Math.floor(walkLen / 1.75) + 1);
            for (let pi = 0; pi < postCount; pi++) {
                const px = -walkLen * 0.5 + (walkLen * pi) / Math.max(1, postCount - 1);
                const pm = new THREE.Matrix4().compose(
                    new THREE.Vector3(px, 0.38, halfW + 0.58),
                    new THREE.Quaternion(),
                    new THREE.Vector3(0.045, 0.84, 0.045)
                );
                handrailPostMatrices.push(new THREE.Matrix4().multiplyMatrices(beltGrp.matrixWorld, pm));
            }
        }

        // Head motor gearbox & enclosed transfer chute
        const motor = new THREE.Mesh(new THREE.BoxGeometry(0.65, 0.42, 0.44), motorMat);
        motor.position.set(len * 0.5 - 0.25, -0.05, -halfW - 0.32);
        motor.castShadow = true;
        beltGrp.add(motor);

        const chuteBot = new THREE.Vector3(head.x + c.dropOff[0], c.dropY, head.z + c.dropOff[2]);
        const chuteTop = new THREE.Vector3(head.x, head.y + 0.10, head.z);
        const chuteDir = new THREE.Vector3().subVectors(chuteTop, chuteBot);
        const chuteH = Math.max(0.4, chuteDir.length());
        const chute = new THREE.Mesh(new THREE.BoxGeometry(0.68, chuteH, c.width * 0.86), steelMat);
        chute.position.addVectors(chuteTop, chuteBot).multiplyScalar(0.5);
        chute.quaternion.setFromUnitVectors(new THREE.Vector3(0, 1, 0), chuteDir.normalize());
        chute.castShadow = true; chute.userData.nodeId = c.id;
        grp.add(chute);

        if (c.feedChute) {
            for (let w = 0; w < c.feedChute.length - 1; w++) {
                const a = new THREE.Vector3(...c.feedChute[w]);
                const b = new THREE.Vector3(...c.feedChute[w + 1]);
                const sd = new THREE.Vector3().subVectors(b, a);
                const sl = sd.length();
                const seg = new THREE.Mesh(new THREE.BoxGeometry(sl + 0.15, 0.38, 0.62), steelMat);
                seg.position.addVectors(a, b).multiplyScalar(0.5);
                seg.quaternion.setFromUnitVectors(new THREE.Vector3(1, 0, 0), sd.normalize());
                seg.castShadow = true;
                grp.add(seg);
            }
        }

        // Rotating tail & head pulleys
        const pulleys = [];
        for (const pPos of [tail, head]) {
            const p = new THREE.Mesh(new THREE.CylinderGeometry(0.14, 0.14, c.width * 1.12, 12), pulleyMat);
            p.position.set(pPos.x, pPos.y - 0.04, pPos.z);
            p.rotation.order = "YXZ";
            p.rotation.y = yaw;
            p.rotation.x = Math.PI * 0.5;
            p.castShadow = true;
            grp.add(p);
            pulleys.push(p);
        }

        // Full flow waypoints & chevrons
        const flowPts = [
            ...(c.feedChute ? c.feedChute.map(x => new THREE.Vector3(...x)) : []),
            tail, head, chuteBot
        ];
        let flowLen = 0;
        for (let i = 0; i < flowPts.length - 1; i++) flowLen += flowPts[i].distanceTo(flowPts[i + 1]);
        const parcelCount = Math.max(8, Math.floor(flowLen / 0.55));
        totalCoalInstances += parcelCount;

        const arrows = [];
        const arrowCount = Math.max(2, Math.floor(len / 2.8));
        for (let a = 0; a < arrowCount; a++) {
            const cm = new THREE.Mesh(chevronGeo, chevronMat);
            cm.rotation.order = "YXZ";
            cm.rotation.y = yaw;
            cm.rotation.z = pitch;
            scene.add(cm);
            arrows.push(cm);
        }

        // Selection ring on conveyor midpoint
        const selRing = new THREE.Mesh(
            new THREE.RingGeometry(0.95, 1.15, 28),
            new THREE.MeshBasicMaterial({ color: 0x38bdf8, side: THREE.DoubleSide, transparent: true, opacity: 0.85 })
        );
        selRing.rotation.x = -Math.PI / 2;
        selRing.position.set(mid.x, mid.y + 0.18, mid.z);
        selRing.visible = false;
        scene.add(selRing);

        const right = new THREE.Vector3().crossVectors(dir, new THREE.Vector3(0, 1, 0)).normalize();
        conveyorData.push({ spec: c, tail, head, dir, right, yaw, pitch, len, chuteBot, flowPts, parcelCount, pulleys, arrows, selRing, bedCoal });
    }

    // 1 InstancedMesh for all conveyor handrail posts
    if (handrailPostMatrices.length > 0) {
        const postInstanced = new THREE.InstancedMesh(new THREE.BoxGeometry(1, 1, 1), railMat, handrailPostMatrices.length);
        postInstanced.castShadow = true;
        handrailPostMatrices.forEach((m4, idx) => postInstanced.setMatrixAt(idx, m4));
        postInstanced.instanceMatrix.needsUpdate = true;
        scene.add(postInstanced);
    }

    // GPU InstancedMesh for ALL coal lumps across all 11 conveyors + loader dump
    const lumpGeo = new THREE.DodecahedronGeometry(0.5, 0);
    const lumpMat = new THREE.MeshPhysicalMaterial({ roughness: 0.55, metalness: 0.08, clearcoat: 0.45, clearcoatRoughness: 0.18 });
    const dumpLumps = 10;
    const coalInstanced = new THREE.InstancedMesh(lumpGeo, lumpMat, totalCoalInstances + dumpLumps);
    coalInstanced.castShadow = true;
    coalInstanced.receiveShadow = true;
    coalInstanced.instanceMatrix.setUsage(THREE.DynamicDrawUsage);
    scene.add(coalInstanced);

    // Procedural radial-gradient soft CanvasTexture for fugitive dust plumes & desliming water sprays (no hard cubes)
    const softCanvas = document.createElement("canvas");
    softCanvas.width = 64; softCanvas.height = 64;
    const sctx = softCanvas.getContext("2d");
    const softGrad = sctx.createRadialGradient(32, 32, 2, 32, 32, 32);
    softGrad.addColorStop(0.0, "rgba(255,255,255,1.0)");
    softGrad.addColorStop(0.45, "rgba(255,255,255,0.52)");
    softGrad.addColorStop(1.0, "rgba(255,255,255,0.0)");
    sctx.fillStyle = softGrad;
    sctx.fillRect(0, 0, 64, 64);
    const softSpriteTex = new THREE.CanvasTexture(softCanvas);

    const dustSprayCount = 71;
    const dustSprayInstanced = new THREE.InstancedMesh(
        new THREE.PlaneGeometry(1, 1),
        new THREE.MeshBasicMaterial({ map: softSpriteTex, transparent: true, opacity: 0.52, depthWrite: false, side: THREE.DoubleSide }),
        dustSprayCount
    );
    dustSprayInstanced.instanceMatrix.setUsage(THREE.DynamicDrawUsage);
    scene.add(dustSprayInstanced);

    const sampleCoalTrajectory = (cd, u) => {
        const beltEnd = 0.82;
        if (u <= beltEnd) {
            return new THREE.Vector3().lerpVectors(cd.tail, cd.head, u / beltEnd);
        }
        const tau = (u - beltEnd) / (1.0 - beltEnd);
        const g = 9.81;
        const vBelt = cd.dir.clone().multiplyScalar(2.6);
        const v0y = Math.max(0.25, vBelt.y * 0.45);
        const dropH = Math.max(0, cd.head.y - cd.chuteBot.y);
        const fallTime = (v0y + Math.sqrt(v0y * v0y + 2 * g * dropH)) / g;
        const ts = tau * fallTime;
        const y = cd.head.y + v0y * ts - 0.5 * g * ts * ts;
        let dx = (cd.head.x + vBelt.x * ts) - lerp(cd.head.x, cd.chuteBot.x, tau);
        let dz = (cd.head.z + vBelt.z * ts) - lerp(cd.head.z, cd.chuteBot.z, tau);
        if (tau > 0.58) {
            const s = (tau - 0.58) / 0.42;
            const bounce = Math.sin(s * Math.PI) * 0.18;
            const isWet = cd.spec.id === "CV-203" || cd.spec.id === "CV-301" || cd.spec.id === "CV-302";
            const damp = Math.exp(-(isWet ? 0.22 : 0.38) * 4.5 * s) * (1 - s) * (1 - bounce);
            dx *= damp; dz *= damp;
        }
        const dev = Math.hypot(dx, dz);
        const maxD = Math.min(0.26, cd.spec.width * 0.30) * (1 - tau);
        if (dev > maxD && dev > 1e-5) { dx *= maxD / dev; dz *= maxD / dev; }
        return new THREE.Vector3(lerp(cd.head.x, cd.chuteBot.x, tau) + dx, y, lerp(cd.head.z, cd.chuteBot.z, tau) + dz);
    };

    // Tag per-instance color by conveyor CoalMaterialClass
    let instIdx = 0;
    const tmpColor = new THREE.Color();
    for (const cd of conveyorData) {
        cd.startIdx = instIdx;
        tmpColor.set(cd.spec.matCol);
        for (let i = 0; i < cd.parcelCount; i++) {
            coalInstanced.setColorAt(instIdx++, tmpColor);
        }
    }
    const dumpStartIdx = instIdx;
    tmpColor.set("#1C1E22");
    for (let i = 0; i < dumpLumps; i++) coalInstanced.setColorAt(instIdx++, tmpColor);
    if (coalInstanced.instanceColor) coalInstanced.instanceColor.needsUpdate = true;

    // =========================================================================
    // Machine Groups, Mechanical Sub-Animations, Live Fill Levels & GLB Loader
    // =========================================================================
    const machineObjects = {};
    const labelElems = {};
    const overlay = document.getElementById("labels-overlay");
    const raycastTargets = [];

    const ringGeo = new THREE.RingGeometry(0.86, 1.0, 32);
    const fillCylGeo = new THREE.CylinderGeometry(1, 1, 1, 20);

    for (const m of MACHINE_NODES) {
        const root = new THREE.Group();
        root.position.set(...m.pos);
        root.rotation.y = THREE.MathUtils.degToRad(m.yaw);
        root.scale.set(...m.scale);
