        e.currentTarget.classList.toggle("active", state.postFx);
    });
    document.getElementById("btn-thermal").addEventListener("click", e => {
        state.thermalHeatmap = !state.thermalHeatmap;
        e.currentTarget.classList.toggle("active", state.thermalHeatmap);
    });
    document.getElementById("btn-pause").addEventListener("click", e => {
        state.paused = !state.paused;
        e.currentTarget.textContent = state.paused ? "Resume" : "Pause";
        e.currentTarget.classList.toggle("active", state.paused);
    });
    document.getElementById("btn-theme").addEventListener("click", e => {
        const root = document.documentElement;
        const next = root.getAttribute("data-theme") === "dark" ? "light" : "dark";
        root.setAttribute("data-theme", next);
        e.currentTarget.textContent = next === "dark" ? "Light HUD" : "Dark HUD";
        if (window.__updateThreeTheme) window.__updateThreeTheme(next);
    });

    window.addEventListener("keydown", ev => {
        if (ev.target && ["INPUT", "TEXTAREA", "SELECT"].includes(ev.target.tagName)) return;
        if (ev.key >= "1" && ev.key <= "9") {
            const p = CAMERA_PRESETS[Number(ev.key) - 1];
            if (p) applyCameraPreset(p.name);
        } else if (ev.key === "r" || ev.key === "R") {
            applyCameraPreset("Plant Overview");
        } else if (ev.key === "f" || ev.key === "F") {
            focusNode(state.selectedId);
        } else if (ev.key === " ") {
            ev.preventDefault();
            document.getElementById("btn-pause").click();
        }
    });
}

