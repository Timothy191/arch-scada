function startOfflineFallback(reason) {
    console.warn("[DigitalTwin3D] Falling back to offline 2D GA canvas:", reason);
    document.getElementById("offline-banner").style.display = "block";
    document.getElementById("status-pill").textContent = "Offline GA Twin Fallback · Read-Only";
    const canvas = document.getElementById("fallback-canvas");
    canvas.style.display = "block";
    const ctx = canvas.getContext("2d");

    const draw = (now) => {
        const rect = canvas.parentElement.getBoundingClientRect();
        if (canvas.width !== Math.floor(rect.width) || canvas.height !== Math.floor(rect.height)) {
            canvas.width = Math.max(1, Math.floor(rect.width));
            canvas.height = Math.max(1, Math.floor(rect.height));
        }
        if (!state.paused) state.simTime += 0.016;
        evaluateProcessFlows(state.simTime);

        const isDark = document.documentElement.getAttribute("data-theme") === "dark";
        ctx.fillStyle = isDark ? "#070d1a" : "#e2e8f0";
        ctx.fillRect(0, 0, canvas.width, canvas.height);

        const scale = Math.min(canvas.width / 34, canvas.height / 38);
        const ox = canvas.width * 0.5 + 1.5 * scale;
        const oz = canvas.height * 0.5;
        const toPx = (x, z) => [ox + x * scale, oz + z * scale];

        // Foundation pads
        for (const pad of FOUNDATION_PADS) {
            const [cx, cz] = toPx(pad.center[0], pad.center[2]);
            ctx.fillStyle = isDark ? "rgba(30,41,59,0.65)" : "rgba(255,255,255,0.85)";
            ctx.strokeStyle = pad.accent;
            ctx.lineWidth = 1.2;
            const w = pad.size[0] * scale, h = pad.size[2] * scale;
            ctx.fillRect(cx - w * 0.5, cz - h * 0.5, w, h);
            ctx.strokeRect(cx - w * 0.5, cz - h * 0.5, w, h);
        }

        // Conveyors
        for (const c of CONVEYORS) {
            const [x1, z1] = toPx(c.tail[0], c.tail[2]);
            const [x2, z2] = toPx(c.head[0], c.head[2]);
            ctx.strokeStyle = c.id === state.selectedId ? "#38bdf8" : c.matCol;
            ctx.lineWidth = c.id === state.selectedId ? 6 : 4;
            ctx.beginPath(); ctx.moveTo(x1, z1); ctx.lineTo(x2, z2); ctx.stroke();
        }

        // Machines
        const lp = computeLoaderPose(state.simTime, (state.flowMap["FEL-101"]?.rate || 0) > 0);
        for (const m of MACHINE_NODES) {
            const pos = m.id === "FEL-101" ? [lp.x, lp.y, lp.z] : m.pos;
            const [px, pz] = toPx(pos[0], pos[2]);
            const w = m.half[0] * 1.6 * scale, h = m.half[2] * 1.6 * scale;
            ctx.fillStyle = m.id === state.selectedId ? "#38bdf8" : m.color;
            ctx.fillRect(px - w * 0.5, pz - h * 0.5, w, h);
            ctx.fillStyle = isDark ? "#f8fafc" : "#0f172a";
            ctx.font = "bold 10px sans-serif";
            ctx.textAlign = "center";
            ctx.fillText(m.id, px, pz - h * 0.5 - 4);
        }
        requestAnimationFrame(draw);
    };
    canvas.addEventListener("click", ev => {
        const rect = canvas.getBoundingClientRect();
        const scale = Math.min(canvas.width / 34, canvas.height / 38);
        const ox = canvas.width * 0.5 + 1.5 * scale;
        const oz = canvas.height * 0.5;
        const wx = (ev.clientX - rect.left - ox) / scale;
        const wz = (ev.clientY - rect.top - oz) / scale;
        let best = null, bestD = 3.0;
        for (const n of ALL_NODES) {
            const d = Math.hypot(n.pos[0] - wx, n.pos[2] - wz);
            if (d < bestD) { bestD = d; best = n.id; }
        }
        if (best) selectNode(best, false);
    });
    requestAnimationFrame(draw);
}

try {
    const THREE = await import("three");
    const { OrbitControls } = await import("three/addons/controls/OrbitControls.js");
    const { GLTFLoader } = await import("three/addons/loaders/GLTFLoader.js");
    const { RoomEnvironment } = await import("three/addons/environments/RoomEnvironment.js");

    const container = document.getElementById("gl-container");
    const renderer = new THREE.WebGLRenderer({ antialias: true, powerPreference: "high-performance" });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
    renderer.setSize(container.clientWidth, container.clientHeight);
    renderer.shadowMap.enabled = true;
    renderer.shadowMap.type = THREE.PCFSoftShadowMap;
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.08;
    container.appendChild(renderer.domElement);

    const scene = new THREE.Scene();
    scene.background = new THREE.Color(0x070d1a);
    scene.fog = new THREE.FogExp2(0x070d1a, 0.011);

    const pmrem = new THREE.PMREMGenerator(renderer);
    scene.environment = pmrem.fromScene(new RoomEnvironment(), 0.04).texture;

    const camera = new THREE.PerspectiveCamera(42, container.clientWidth / Math.max(1, container.clientHeight), 0.2, 160);
    const controls = new OrbitControls(camera, renderer.domElement);
    controls.enableDamping = true;
    controls.dampingFactor = 0.08;
    controls.maxPolarAngle = Math.PI * 0.485;
    controls.minDistance = 4;
    controls.maxDistance = 65;

    // Lighting: Hemisphere + 2048² PCFSoftShadowMap Sun + Cool Industrial Rim
    const hemi = new THREE.HemisphereLight(0xbcd8ff, 0x1a2436, 0.72);
    scene.add(hemi);

    const sun = new THREE.DirectionalLight(0xfff4e0, 2.35);
    sun.position.set(16, 28, 14);
    sun.castShadow = true;
    sun.shadow.mapSize.set(2048, 2048);
    sun.shadow.camera.near = 2;
    sun.shadow.camera.far = 80;
    sun.shadow.camera.left = -22;
    sun.shadow.camera.right = 22;
    sun.shadow.camera.top = 24;
    sun.shadow.camera.bottom = -24;
    sun.shadow.bias = -0.00045;
    scene.add(sun);

    const rimLight = new THREE.DirectionalLight(0x38bdf8, 0.55);
    rimLight.position.set(-18, 12, -18);
    scene.add(rimLight);

    // Ground Plane & Grid
    const groundMat = new THREE.MeshStandardMaterial({ color: 0x0b1324, roughness: 0.92, metalness: 0.08 });
    const ground = new THREE.Mesh(new THREE.PlaneGeometry(76, 76), groundMat);
    ground.rotation.x = -Math.PI / 2;
    ground.position.set(-1, -0.02, -1);
    ground.receiveShadow = true;
    scene.add(ground);

    const grid = new THREE.GridHelper(52, 26, 0x1e3a5f, 0x11223a);
    grid.position.set(-2, -0.005, -1);
    scene.add(grid);

    // 6 Concrete Foundation Pads
    const padMat = new THREE.MeshStandardMaterial({ color: 0x1e293b, roughness: 0.85, metalness: 0.12 });
    for (const pad of FOUNDATION_PADS) {
        const mesh = new THREE.Mesh(new THREE.BoxGeometry(...pad.size), padMat);
        mesh.position.set(...pad.center);
        mesh.receiveShadow = true;
        scene.add(mesh);

        const trim = new THREE.Mesh(
            new THREE.BoxGeometry(pad.size[0], 0.04, 0.14),
            new THREE.MeshStandardMaterial({ color: pad.accent, roughness: 0.4, metalness: 0.3 })
        );
        trim.position.set(pad.center[0], 0.02, pad.center[2] + pad.size[2] * 0.5 - 0.07);
        scene.add(trim);
    }

    // 6 Orthogonal Slurry / Magnetite / Water Pipes + Flow Spheres
    const pipeFlowSpheres = [];
    const sphereGeo = new THREE.SphereGeometry(0.11, 10, 10);
    for (const route of PIPE_ROUTES) {
        const pipeMat = new THREE.MeshStandardMaterial({ color: route.color, roughness: 0.34, metalness: 0.72 });
        for (let i = 0; i < route.pts.length - 1; i++) {
            const a = new THREE.Vector3(...route.pts[i]);
            const b = new THREE.Vector3(...route.pts[i + 1]);
            const dir = new THREE.Vector3().subVectors(b, a);
            const len = dir.length();
            if (len < 0.01) continue;
            const cyl = new THREE.Mesh(new THREE.CylinderGeometry(route.r, route.r, len, 10), pipeMat);
            cyl.position.addVectors(a, b).multiplyScalar(0.5);
            cyl.quaternion.setFromUnitVectors(new THREE.Vector3(0, 1, 0), dir.normalize());
            cyl.castShadow = true;
            cyl.receiveShadow = true;
            scene.add(cyl);
        }
        const pMat = new THREE.MeshBasicMaterial({ color: route.color });
        for (let k = 0; k < 5; k++) {
            const sp = new THREE.Mesh(sphereGeo, pMat);
            scene.add(sp);
            pipeFlowSpheres.push({ mesh: sp, route, offset: k / 5 });
        }
    }

    // Procedural Grounded Industrial Conveyors + InstancedMesh Coal Lumps
    const conveyorData = [];
    const steelMat = new THREE.MeshStandardMaterial({ color: 0x475569, roughness: 0.45, metalness: 0.72 });
    const beltMat = new THREE.MeshStandardMaterial({ color: 0x181c24, roughness: 0.88, metalness: 0.1 });
    const railMat = new THREE.MeshStandardMaterial({ color: 0xfacc15, roughness: 0.42, metalness: 0.3 });
    const motorMat = new THREE.MeshStandardMaterial({ color: 0x0284c7, roughness: 0.38, metalness: 0.65 });
    const pulleyMat = new THREE.MeshStandardMaterial({ color: 0xd97706, roughness: 0.4, metalness: 0.7 });
    const chevronMat = new THREE.MeshBasicMaterial({ color: 0x38bdf8 });
    const chevronGeo = new THREE.ConeGeometry(0.18, 0.42, 8);
    chevronGeo.rotateZ(-Math.PI / 2);

    let totalCoalInstances = 0;
    const samplePolyline = (pts, t) => {
        if (pts.length === 1) return pts[0].clone();
        let total = 0;
        const segs = [];
        for (let i = 0; i < pts.length - 1; i++) {
            const d = pts[i].distanceTo(pts[i + 1]);
            segs.push(d);
            total += d;
        }
        let target = Math.max(0, Math.min(1, t)) * total;
        for (let i = 0; i < segs.length; i++) {
            if (target <= segs[i] || i === segs.length - 1) {
                const f = segs[i] > 1e-5 ? target / segs[i] : 0;
                return new THREE.Vector3().lerpVectors(pts[i], pts[i + 1], Math.max(0, Math.min(1, f)));
            }
            target -= segs[i];
        }
        return pts[pts.length - 1].clone();
    };

    for (const c of CONVEYORS) {
        const grp = new THREE.Group();
        grp.userData.nodeId = c.id;
        scene.add(grp);

        const tail = new THREE.Vector3(...c.tail);
        const head = new THREE.Vector3(...c.head);
        const delta = new THREE.Vector3().subVectors(head, tail);
        const len = delta.length();
        const dir = delta.clone().normalize();
        const yaw = Math.atan2(-dir.z, dir.x);
        const pitch = Math.asin(Math.max(-1, Math.min(1, dir.y)));
        const mid = new THREE.Vector3().addVectors(tail, head).multiplyScalar(0.5);
        const halfW = c.width * 0.5;

        const beltGrp = new THREE.Group();
        beltGrp.position.copy(mid);
        beltGrp.rotation.order = "YXZ";
        beltGrp.rotation.y = yaw;
        beltGrp.rotation.z = pitch;
        beltGrp.userData.nodeId = c.id;
        grp.add(beltGrp);

        // Belt bed + continuous troughed coal burden ribbon
        const bed = new THREE.Mesh(new THREE.BoxGeometry(len, 0.08, c.width * 0.90), beltMat);
        bed.castShadow = true; bed.receiveShadow = true; bed.userData.nodeId = c.id;
        beltGrp.add(bed);

        const isWetBelt = c.id === "CV-203" || c.id === "CV-301" || c.id === "CV-302";
        const bedCoal = new THREE.Mesh(
            new THREE.BoxGeometry(len * 0.96, 1.0, c.width * 0.56),
            new THREE.MeshPhysicalMaterial({
                color: c.matCol,
                roughness: isWetBelt ? 0.34 : 0.78,
                metalness: 0.08,
                clearcoat: isWetBelt ? 0.85 : 0.0,
                clearcoatRoughness: 0.16
            })
        );
        bedCoal.position.set(0, 0.08, 0);
        bedCoal.scale.y = 0.08;
        bedCoal.castShadow = true; bedCoal.receiveShadow = true; bedCoal.userData.nodeId = c.id;
        beltGrp.add(bedCoal);

        // Side stringers
        for (const side of [-halfW, halfW]) {
            const str = new THREE.Mesh(new THREE.BoxGeometry(len + 0.35, 0.22, 0.08), steelMat);
            str.position.set(0, -0.04, side);
            str.castShadow = true; str.receiveShadow = true; str.userData.nodeId = c.id;
            beltGrp.add(str);
        }

        // Support trestles grounded at Y=0
        const bentCount = Math.max(2, Math.ceil(len / 3.5) + 1);
        for (let i = 0; i < bentCount; i++) {
            const frac = Math.max(0.08, Math.min(0.92, 0.10 + 0.80 * i / Math.max(1, bentCount - 1)));
            const bp = new THREE.Vector3().lerpVectors(tail, head, frac);
            const h = bp.y - 0.12;
            if (h <= 0.18) continue;
            const bent = new THREE.Group();
            bent.position.set(bp.x, 0, bp.z);
            bent.rotation.y = yaw;
            for (const side of [-halfW - 0.06, halfW + 0.06]) {
                const leg = new THREE.Mesh(new THREE.BoxGeometry(0.11, h, 0.11), steelMat);
                leg.position.set(0, h * 0.5, side);
                leg.castShadow = true; leg.receiveShadow = true;
                bent.add(leg);
            }
            if (h > 1.2) {
                const brace = new THREE.Mesh(new THREE.BoxGeometry(0.08, 0.08, c.width + 0.18), steelMat);
                brace.position.set(0, h * 0.52, 0);
                bent.add(brace);
            }
            grp.add(bent);
        }

        // Walkway & safety-yellow handrail on elevated belts
        if (len > 4.2 || Math.abs(head.y - tail.y) > 0.6) {
            const walk = new THREE.Mesh(new THREE.BoxGeometry(len * 0.92, 0.05, 0.52), steelMat);
            walk.position.set(0, -0.05, halfW + 0.34);
            walk.receiveShadow = true;
            beltGrp.add(walk);

            const rail = new THREE.Mesh(new THREE.BoxGeometry(len * 0.92, 0.05, 0.05), railMat);
            rail.position.set(0, 0.78, halfW + 0.58);
            beltGrp.add(rail);
        }

        // Head motor gearbox & enclosed transfer chute
        const motor = new THREE.Mesh(new THREE.BoxGeometry(0.65, 0.42, 0.44), motorMat);
        motor.position.set(len * 0.5 - 0.25, -0.05, -halfW - 0.32);
        motor.castShadow = true;
        beltGrp.add(motor);

        const chuteBot = new THREE.Vector3(head.x + c.dropOff[0], c.dropY, head.z + c.dropOff[2]);
        const chuteTop = new THREE.Vector3(head.x, head.y + 0.10, head.z);
        const chuteDir = new THREE.Vector3().subVectors(chuteTop, chuteBot);
        const chuteH = Math.max(0.4, chuteDir.length());
        const chute = new THREE.Mesh(new THREE.BoxGeometry(0.68, chuteH, c.width * 0.86), steelMat);
        chute.position.addVectors(chuteTop, chuteBot).multiplyScalar(0.5);
        chute.quaternion.setFromUnitVectors(new THREE.Vector3(0, 1, 0), chuteDir.normalize());
        chute.castShadow = true; chute.userData.nodeId = c.id;
        grp.add(chute);

        if (c.feedChute) {
            for (let w = 0; w < c.feedChute.length - 1; w++) {
                const a = new THREE.Vector3(...c.feedChute[w]);
                const b = new THREE.Vector3(...c.feedChute[w + 1]);
                const sd = new THREE.Vector3().subVectors(b, a);
                const sl = sd.length();
                const seg = new THREE.Mesh(new THREE.BoxGeometry(sl + 0.15, 0.38, 0.62), steelMat);
                seg.position.addVectors(a, b).multiplyScalar(0.5);
                seg.quaternion.setFromUnitVectors(new THREE.Vector3(1, 0, 0), sd.normalize());
                seg.castShadow = true;
                grp.add(seg);
            }
        }

        // Rotating tail & head pulleys
        const pulleys = [];
        for (const pPos of [tail, head]) {
            const p = new THREE.Mesh(new THREE.CylinderGeometry(0.14, 0.14, c.width * 1.12, 12), pulleyMat);
            p.position.set(pPos.x, pPos.y - 0.04, pPos.z);
            p.rotation.order = "YXZ";
            p.rotation.y = yaw;
            p.rotation.x = Math.PI * 0.5;
            p.castShadow = true;
            grp.add(p);
            pulleys.push(p);
        }

        // Full flow waypoints & chevrons
        const flowPts = [
            ...(c.feedChute ? c.feedChute.map(x => new THREE.Vector3(...x)) : []),
            tail, head, chuteBot
        ];
        let flowLen = 0;
        for (let i = 0; i < flowPts.length - 1; i++) flowLen += flowPts[i].distanceTo(flowPts[i + 1]);
        const parcelCount = Math.max(8, Math.floor(flowLen / 0.55));
        totalCoalInstances += parcelCount;

        const arrows = [];
        const arrowCount = Math.max(2, Math.floor(len / 2.8));
        for (let a = 0; a < arrowCount; a++) {
            const cm = new THREE.Mesh(chevronGeo, chevronMat);
            cm.rotation.order = "YXZ";
            cm.rotation.y = yaw;
            cm.rotation.z = pitch;
            scene.add(cm);
            arrows.push(cm);
        }

        // Selection ring on conveyor midpoint
        const selRing = new THREE.Mesh(
            new THREE.RingGeometry(0.95, 1.15, 28),
            new THREE.MeshBasicMaterial({ color: 0x38bdf8, side: THREE.DoubleSide, transparent: true, opacity: 0.85 })
        );
        selRing.rotation.x = -Math.PI / 2;
        selRing.position.set(mid.x, mid.y + 0.18, mid.z);
        selRing.visible = false;
        scene.add(selRing);

        const right = new THREE.Vector3().crossVectors(dir, new THREE.Vector3(0, 1, 0)).normalize();
        conveyorData.push({ spec: c, tail, head, dir, right, len, chuteBot, flowPts, parcelCount, pulleys, arrows, selRing, bedCoal });
    }

    // GPU InstancedMesh for ALL coal lumps across all 11 conveyors + loader dump
    const lumpGeo = new THREE.DodecahedronGeometry(0.5, 0);
    const lumpMat = new THREE.MeshPhysicalMaterial({ roughness: 0.55, metalness: 0.08, clearcoat: 0.45, clearcoatRoughness: 0.18 });
    const dumpLumps = 10;
    const coalInstanced = new THREE.InstancedMesh(lumpGeo, lumpMat, totalCoalInstances + dumpLumps);
    coalInstanced.castShadow = true;
    coalInstanced.receiveShadow = true;
    coalInstanced.instanceMatrix.setUsage(THREE.DynamicDrawUsage);
    scene.add(coalInstanced);

    // GPU InstancedMesh for fugitive coal dust plumes & desliming water spray curtains
    const dustSprayCount = 61;
    const dustSprayInstanced = new THREE.InstancedMesh(
        new THREE.BoxGeometry(1, 1, 1),
        new THREE.MeshBasicMaterial({ transparent: true, opacity: 0.32, depthWrite: false }),
        dustSprayCount
    );
    dustSprayInstanced.instanceMatrix.setUsage(THREE.DynamicDrawUsage);
    scene.add(dustSprayInstanced);

    const sampleCoalTrajectory = (cd, u) => {
        const beltEnd = 0.82;
        if (u <= beltEnd) {
            return new THREE.Vector3().lerpVectors(cd.tail, cd.head, u / beltEnd);
        }
        const tau = (u - beltEnd) / (1.0 - beltEnd);
        const g = 9.81;
        const vBelt = cd.dir.clone().multiplyScalar(2.6);
        const v0y = Math.max(0.25, vBelt.y * 0.45);
        const dropH = Math.max(0, cd.head.y - cd.chuteBot.y);
        const fallTime = (v0y + Math.sqrt(v0y * v0y + 2 * g * dropH)) / g;
        const ts = tau * fallTime;
        const y = cd.head.y + v0y * ts - 0.5 * g * ts * ts;
        let dx = (cd.head.x + vBelt.x * ts) - lerp(cd.head.x, cd.chuteBot.x, tau);
        let dz = (cd.head.z + vBelt.z * ts) - lerp(cd.head.z, cd.chuteBot.z, tau);
        if (tau > 0.58) {
            const s = (tau - 0.58) / 0.42;
            const bounce = Math.sin(s * Math.PI) * 0.18;
            const isWet = cd.spec.id === "CV-203" || cd.spec.id === "CV-301" || cd.spec.id === "CV-302";
            const damp = Math.exp(-(isWet ? 0.22 : 0.38) * 4.5 * s) * (1 - s) * (1 - bounce);
            dx *= damp; dz *= damp;
        }
        const dev = Math.hypot(dx, dz);
        const maxD = Math.min(0.26, cd.spec.width * 0.30) * (1 - tau);
        if (dev > maxD && dev > 1e-5) { dx *= maxD / dev; dz *= maxD / dev; }
        return new THREE.Vector3(lerp(cd.head.x, cd.chuteBot.x, tau) + dx, y, lerp(cd.head.z, cd.chuteBot.z, tau) + dz);
    };

    // Tag per-instance color by conveyor CoalMaterialClass
    let instIdx = 0;
    const tmpColor = new THREE.Color();
    for (const cd of conveyorData) {
        cd.startIdx = instIdx;
        tmpColor.set(cd.spec.matCol);
        for (let i = 0; i < cd.parcelCount; i++) {
            coalInstanced.setColorAt(instIdx++, tmpColor);
        }
    }
    const dumpStartIdx = instIdx;
    tmpColor.set("#A16207");
    for (let i = 0; i < dumpLumps; i++) coalInstanced.setColorAt(instIdx++, tmpColor);
    if (coalInstanced.instanceColor) coalInstanced.instanceColor.needsUpdate = true;

    // =========================================================================
    // Machine Groups, Mechanical Sub-Animations, Live Fill Levels & GLB Loader
    // =========================================================================
    const machineObjects = {};
    const labelElems = {};
    const overlay = document.getElementById("labels-overlay");
    const raycastTargets = [];

    const ringGeo = new THREE.RingGeometry(0.86, 1.0, 32);
    const fillCylGeo = new THREE.CylinderGeometry(1, 1, 1, 20);

    for (const m of MACHINE_NODES) {
        const root = new THREE.Group();
        root.position.set(...m.pos);
        root.rotation.y = THREE.MathUtils.degToRad(m.yaw);
        root.scale.set(...m.scale);
        root.userData.nodeId = m.id;
        scene.add(root);

        // Fallback proxy box while GLB streams in (replaced once GLB loads)
        const proxy = new THREE.Mesh(
            new THREE.BoxGeometry(m.half[0] * 1.6, m.half[1] * 1.6, m.half[2] * 1.6),
            new THREE.MeshStandardMaterial({ color: m.color, roughness: 0.55, metalness: 0.45 })
        );
        proxy.position.y = m.half[1] * 0.8;
        proxy.castShadow = true; proxy.receiveShadow = true;
        proxy.userData.nodeId = m.id;
        root.add(proxy);
        raycastTargets.push(proxy);

        // Selection / Alarm Ring
        const ringR = Math.max(m.half[0], m.half[2]) + 0.35;
        const ring = new THREE.Mesh(ringGeo, new THREE.MeshBasicMaterial({ color: 0x38bdf8, side: THREE.DoubleSide, transparent: true, opacity: 0.85 }));
        ring.rotation.x = -Math.PI / 2;
        ring.position.set(m.pos[0], 0.08, m.pos[2]);
        ring.scale.set(ringR, ringR, 1);
        ring.visible = false;
        scene.add(ring);

        // Optional live fill-level cylinder
        let fillMesh = null;
        if (m.fill) {
            fillMesh = new THREE.Mesh(fillCylGeo, new THREE.MeshStandardMaterial({
                color: m.fill.color, roughness: 0.4, metalness: 0.1, transparent: true, opacity: 0.55
            }));
            fillMesh.position.set(m.pos[0], m.fill.baseY + m.fill.maxH * 0.3, m.pos[2]);
            fillMesh.scale.set(m.fill.r, m.fill.maxH * 0.6, m.fill.r);
            scene.add(fillMesh);
        }

        // Optional rotating top (MS-301 wet drum / TK-201 thickener rake)
        let rotBar = null;
        if (m.rotTop) {
            rotBar = new THREE.Mesh(
                new THREE.BoxGeometry(m.rotTop.len, 0.14, 0.24),
                new THREE.MeshStandardMaterial({ color: 0x38bdf8, roughness: 0.3, metalness: 0.6 })
            );
            rotBar.position.set(m.pos[0], m.pos[1] + m.rotTop.y, m.pos[2]);
            rotBar.castShadow = true;
            scene.add(rotBar);
        }

        machineObjects[m.id] = { spec: m, root, proxy, ring, fillMesh, rotBar, glbRoot: null, bucketPivot: null, extras: null };

        // Label badge
        const lbl = document.createElement("div");
        lbl.className = "node-label";
        lbl.innerHTML = `<span class="dot" style="background:${m.color}"></span>${m.id}`;
        lbl.addEventListener("click", () => selectNode(m.id, false));
        overlay.appendChild(lbl);
        labelElems[m.id] = lbl;
    }

    // Conveyor labels too
    for (const c of CONVEYORS) {
        const lbl = document.createElement("div");
        lbl.className = "node-label";
        lbl.innerHTML = `<span class="dot" style="background:${c.matCol}"></span>${c.id}`;
        lbl.addEventListener("click", () => selectNode(c.id, false));
        overlay.appendChild(lbl);
        labelElems[c.id] = lbl;
    }

    // JC-101 dual flywheels + reciprocating swing jaw
    {
        const jc = machineObjects["JC-101"];
        const wheelGeo = new THREE.CylinderGeometry(0.56, 0.56, 0.18, 20);
        wheelGeo.rotateX(Math.PI * 0.5);
        const wheelMat = new THREE.MeshStandardMaterial({ color: 0xd97706, roughness: 0.35, metalness: 0.72 });
        const spokeMat = new THREE.MeshStandardMaterial({ color: 0x1e293b, roughness: 0.5, metalness: 0.7 });
        const wheels = [];
        for (const zOff of [-1.06, 1.06]) {
            const wg = new THREE.Group();
            wg.position.set(-13.8, 2.50, -0.6 + zOff);
            const w = new THREE.Mesh(wheelGeo, wheelMat); w.castShadow = true; wg.add(w);
            const sp = new THREE.Mesh(new THREE.BoxGeometry(1.06, 0.12, 0.20), spokeMat); wg.add(sp);
            scene.add(wg);
            wheels.push(wg);
        }
        const jaw = new THREE.Mesh(
            new THREE.BoxGeometry(0.16, 1.05, 1.16),
            new THREE.MeshStandardMaterial({ color: 0xf59e0b, roughness: 0.45, metalness: 0.65 })
        );
        jaw.position.set(-13.92, 2.48, -0.6);
        jaw.rotation.z = -0.20;
        jaw.castShadow = true;
        scene.add(jaw);
        jc.extras = { wheels, jaw };
    }

    // DRC-101 counter-rotating toothed rolls
    {
        const drc = machineObjects["DRC-101"];
        const drumGeo = new THREE.CylinderGeometry(0.32, 0.32, 1.32, 16);
        drumGeo.rotateX(Math.PI * 0.5);
        const drumMat = new THREE.MeshStandardMaterial({ color: 0x475569, roughness: 0.4, metalness: 0.75 });
        const toothMat = new THREE.MeshStandardMaterial({ color: 0xf59e0b, roughness: 0.35, metalness: 0.7 });
        const rolls = [];
        for (let r = 0; r < 2; r++) {
            const xOff = r === 0 ? -0.36 : 0.36;
            const rg = new THREE.Group();
            rg.position.set(-7.2 + xOff, 2.02, -0.6);
            rg.add(new THREE.Mesh(drumGeo, drumMat));
            for (let t = 0; t < 4; t++) {
                const rib = new THREE.Mesh(new THREE.BoxGeometry(0.72, 0.09, 1.28), toothMat);
                rib.rotation.z = t * Math.PI * 0.25;
                rg.add(rib);
            }
            scene.add(rg);
            rolls.push(rg);
        }
        drc.extras = { rolls };
    }

    // Load all 16 .glb models from /models3d/{fileName}
    const gltfLoader = new GLTFLoader();
    const glbCache = new Map();
    const loadGlb = (fileName) => {
        if (glbCache.has(fileName)) return glbCache.get(fileName);
        const p = new Promise((resolve, reject) => {
            gltfLoader.load(`/models3d/${encodeURIComponent(fileName)}`, gltf => {
                state.loadedGlbSet.add(fileName);
                document.getElementById("kpi-glb").textContent = `${state.loadedGlbSet.size}/16`;
                resolve(gltf.scene);
            }, undefined, reject);
        });
        glbCache.set(fileName, p);
        return p;
    };

    const tagNodeHierarchy = (obj, nodeId) => {
        obj.traverse(ch => {
            ch.userData.nodeId = nodeId;
            if (ch.isMesh) {
                ch.castShadow = true;
                ch.receiveShadow = true;
                if (ch.material) ch.material = ch.material.clone();
                raycastTargets.push(ch);
            }
        });
    };

    for (const m of MACHINE_NODES) {
        loadGlb(m.glb).then(template => {
            const entry = machineObjects[m.id];
            const clone = template.clone(true);
            tagNodeHierarchy(clone, m.id);
            entry.root.remove(entry.proxy);
            entry.root.add(clone);
            entry.glbRoot = clone;

            if (m.id === "FEL-101") {
                loadGlb("wheel_loader_bucket.glb").then(bTemplate => {
                    const pivot = new THREE.Group();
                    pivot.position.set(1.30, 1.38, 0);
                    const bClone = bTemplate.clone(true);
                    tagNodeHierarchy(bClone, "FEL-101");
                    pivot.add(bClone);
                    entry.root.add(pivot);
                    entry.bucketPivot = pivot;
                }).catch(() => {});
            }
        }).catch(() => {});
    }

    // Preload conveyor_segment.glb so all 16 GLB assets are counted & available
    loadGlb("conveyor_segment.glb").catch(() => {});

    // Camera Rig Bridge
    window.__applyPreset = (p) => {
        const dist = 19.0 / Math.max(0.35, Math.min(3.2, p.zoom));
        const cp = Math.cos(p.pitch), sp = Math.sin(p.pitch);
        const cy = Math.cos(p.yaw), sy = Math.sin(p.yaw);
        controls.target.set(p.tx, 0.9, p.tz);
        camera.position.set(p.tx + dist * cp * sy, 0.9 + dist * sp, p.tz + dist * cp * cy);
        controls.update();
    };
    window.__focusTarget = (x, y, z) => {
        const offset = new THREE.Vector3().subVectors(camera.position, controls.target);
        if (offset.length() > 14) offset.setLength(12);
        controls.target.set(x, y, z);
        camera.position.copy(controls.target).add(offset);
        controls.update();
    };
    window.__updateThreeTheme = (theme) => {
        const dark = theme === "dark";
        scene.background.setHex(dark ? 0x070d1a : 0xdbe5f0);
        scene.fog.color.setHex(dark ? 0x070d1a : 0xdbe5f0);
        groundMat.color.setHex(dark ? 0x0b1324 : 0xcbd5e1);
    };
    applyCameraPreset("Plant Overview");

    // Raycast Click Selection
    const raycaster = new THREE.Raycaster();
    const pointer = new THREE.Vector2();
    let downPt = null;
    renderer.domElement.addEventListener("pointerdown", e => { downPt = { x: e.clientX, y: e.clientY }; });
    renderer.domElement.addEventListener("pointerup", e => {
        if (!downPt || Math.hypot(e.clientX - downPt.x, e.clientY - downPt.y) > 5) return;
        const rect = renderer.domElement.getBoundingClientRect();
        pointer.x = ((e.clientX - rect.left) / rect.width) * 2 - 1;
        pointer.y = -((e.clientY - rect.top) / rect.height) * 2 + 1;
        raycaster.setFromCamera(pointer, camera);
        const hits = raycaster.intersectObjects(scene.children, true);
        for (const h of hits) {
            let cur = h.object;
            while (cur) {
                if (cur.userData && cur.userData.nodeId) {
                    selectNode(cur.userData.nodeId, false);
                    return;
                }
                cur = cur.parent;
            }
        }
    });

    window.addEventListener("resize", () => {
        const w = container.clientWidth, h = Math.max(1, container.clientHeight);
        camera.aspect = w / h;
        camera.updateProjectionMatrix();
        renderer.setSize(w, h);
    });

    // Main Render Loop
    const dummy = new THREE.Object3D();
    const projVec = new THREE.Vector3();
    let lastTime = performance.now(), fpsFrames = 0, fpsTimer = 0;

    function animate(now) {
        requestAnimationFrame(animate);
        const dt = Math.min(0.1, (now - lastTime) / 1000);
        lastTime = now;

        fpsFrames++;
        fpsTimer += dt;
        if (fpsTimer >= 0.5) {
            document.getElementById("kpi-fps").textContent = Math.round(fpsFrames / fpsTimer).toString();
            fpsFrames = 0; fpsTimer = 0;
        }

        if (!state.paused) state.simTime += dt;
        const t = state.simTime;
        evaluateProcessFlows(t);

        const eqMap = state.telemetry?.equipment || {};
        const loaderFlow = state.flowMap["FEL-101"];
        const lp = computeLoaderPose(t, !state.paused && (loaderFlow?.running ?? true));

        // Update 18 machines
        for (const m of MACHINE_NODES) {
            const entry = machineObjects[m.id];
            const flow = state.flowMap[m.id];
            const eq = eqMap[m.scada];
            const running = flow ? flow.running : true;
            const isSel = state.selectedId === m.id;

            if (m.id === "FEL-101") {
                entry.root.position.set(lp.x, lp.y, lp.z);
                entry.root.rotation.order = "YXZ";
                entry.root.rotation.y = THREE.MathUtils.degToRad(lp.yaw);
                entry.root.rotation.z = THREE.MathUtils.degToRad(lp.pitch);
                entry.ring.position.set(lp.x, 0.08, lp.z);
                if (entry.bucketPivot) {
                    entry.bucketPivot.rotation.z = THREE.MathUtils.degToRad(lp.boom + lp.dump * 0.45);
                }
            } else if (m.vibrates && running && !state.paused) {
                const load = eq ? Math.max(0.15, Math.min(1.15, eq.loadPct / 100)) : 0.7;
                if (m.id === "VF-101") {
                    entry.root.position.set(m.pos[0] + Math.sin(t * 15.5) * 0.004 * load, m.pos[1] + Math.sin(t * 31.0) * (0.015 + 0.018 * load), m.pos[2] - Math.cos(t * 31.0) * (0.014 + 0.014 * load));
                } else if (m.id === "DS-201") {
                    entry.root.position.set(m.pos[0] - Math.cos(t * 34.0) * (0.012 + 0.015 * load), m.pos[1] + Math.sin(t * 34.0) * (0.016 + 0.022 * load), m.pos[2] + Math.sin(t * 17.0) * 0.004 * load);
                } else {
                    entry.root.position.set(m.pos[0] + Math.cos(t * 28.0) * (0.014 + 0.016 * load), m.pos[1] + Math.sin(t * 28.0) * (0.018 + 0.024 * load), m.pos[2] + Math.sin(t * 14.0) * 0.006 * load);
                }
            } else {
                entry.root.position.set(m.pos[0], m.pos[1], m.pos[2]);
            }

            // Selection / Alarm Ring
            const isWarnOrFault = eq && (eq.status === "Warning" || eq.status === "Fault");
            entry.ring.visible = isSel || isWarnOrFault;
            if (entry.ring.visible) {
                entry.ring.material.color.setHex(isSel ? 0x38bdf8 : (eq.status === "Fault" ? 0xef4444 : 0xf59e0b));
                entry.ring.material.opacity = isSel ? 0.9 : 0.45 + 0.35 * Math.sin(t * 4.5);
            }

            // Optional thermal heatmap emissive tint
            if (entry.glbRoot) {
                let tintHex = 0x000000;
                let tintStrength = 0.0;
                if (state.thermalHeatmap && eq) {
                    tintStrength = 0.45;
                    tintHex = eq.loadPct >= 85 ? 0xef4444 : (eq.loadPct >= 70 ? 0xf59e0b : (eq.loadPct >= 40 ? 0x22c55e : 0x38bdf8));
                } else if (isSel) {
                    tintHex = 0x0284c7; tintStrength = 0.25;
                } else if (eq && eq.status === "Fault") {
                    tintHex = 0xef4444; tintStrength = 0.45;
                }
                entry.glbRoot.traverse(ch => {
                    if (ch.isMesh && ch.material && "emissive" in ch.material) {
                        ch.material.emissive.setHex(tintHex);
                        ch.material.emissiveIntensity = tintStrength;
                    }
                });
            }

            // Fill level
            if (entry.fillMesh && m.fill) {
                let frac = eq ? Math.max(0.12, Math.min(0.95, eq.loadPct / 100)) : 0.6;
                if (m.id === "BN-101") frac = Math.min(0.98, frac + lp.binPulse);
                const fh = m.fill.maxH * frac;
                entry.fillMesh.scale.y = fh;
                entry.fillMesh.position.y = m.fill.baseY + fh * 0.5;
            }

            // Rotating top (MS-301 / TK-201)
            if (entry.rotBar && m.rotTop && running && !state.paused) {
                entry.rotBar.rotation.y = t * m.rotTop.speed;
            }

            // JC-101 & DRC-101 mechanical sub-animations
            if (m.id === "JC-101" && entry.extras && running && !state.paused) {
                const ang = t * 6.5;
                entry.extras.wheels.forEach(w => { w.rotation.z = ang; });
                const swing = Math.sin(t * 28.27) * 0.08;
                entry.extras.jaw.position.x = -13.92 + swing;
                entry.extras.jaw.rotation.z = -0.20 + swing * 1.4;
            }
            if (m.id === "DRC-101" && entry.extras && running && !state.paused) {
                entry.extras.rolls[0].rotation.z = t * 5.2;
                entry.extras.rolls[1].rotation.z = -t * 5.2;
            }
        }

        // Update 11 conveyors + continuous troughed belt burden + InstancedMesh coal lumps
        for (const cd of conveyorData) {
            const flow = state.flowMap[cd.spec.id];
            const spd = (!state.paused && flow) ? flow.rate : 0;
            cd.selRing.visible = state.selectedId === cd.spec.id;

            const activeFlow = flow && flow.rate > 0.02;
            cd.bedCoal.visible = !!activeFlow;
            if (activeFlow) {
                const bh = Math.min(0.16, Math.max(0.03, flow.rate * 0.14));
                cd.bedCoal.scale.y = bh;
                cd.bedCoal.position.y = 0.045 + bh * 0.5;
            }

            for (const p of cd.pulleys) {
                if (spd > 0) p.rotation.z -= dt * spd * 4.5;
            }

            const lumpSize = cd.spec.lump;
            const right = cd.right;
            for (let i = 0; i < cd.parcelCount; i++) {
                if (!activeFlow) {
                    dummy.scale.set(0, 0, 0);
                    dummy.updateMatrix();
                    coalInstanced.setMatrixAt(cd.startIdx + i, dummy.matrix);
                    continue;
                }
                const ptFrac = ((t * 0.24 * Math.max(0.2, spd) + i / cd.parcelCount) % 1.0 + 1.0) % 1.0;
                const pos = sampleCoalTrajectory(cd, ptFrac);
                const jitterScale = ptFrac <= 0.82 ? 1.0 : Math.max(0.15, 1.0 - (ptFrac - 0.82) / 0.18);
                pos.addScaledVector(right, Math.sin(i * 3.1) * cd.spec.width * 0.16 * jitterScale);
                if (ptFrac <= 0.82) pos.y += 0.14;
                dummy.position.copy(pos);
                dummy.rotation.set(i * 0.4, i * 0.9, 0);
                dummy.scale.set(lumpSize * 1.35, lumpSize * 0.9, lumpSize * 1.15);
                dummy.updateMatrix();
                coalInstanced.setMatrixAt(cd.startIdx + i, dummy.matrix);
            }

            cd.arrows.forEach((cm, a) => {
                cm.visible = state.showArrows && flow && flow.rate > 0.02;
                if (cm.visible) {
                    const af = ((t * 0.35 * Math.max(0.25, spd) + a / cd.arrows.length) % 1.0 + 1.0) % 1.0;
                    cm.position.lerpVectors(cd.tail, cd.head, af);
                    cm.position.y += 0.65;
                }
            });
        }

        // FEL-101 coal dump boulders into BN-101
        for (let i = 0; i < dumpLumps; i++) {
            if (!lp.dumping) {
                dummy.scale.set(0, 0, 0);
                dummy.updateMatrix();
                coalInstanced.setMatrixAt(dumpStartIdx + i, dummy.matrix);
            } else {
                const f = (t * 2.6 + i / dumpLumps) % 1.0;
                const ox = lp.x, oy = lp.y + 2.35, oz = lp.z - 2.1;
                const tx = -13.8, ty = 2.15, tz = 8.8;
                dummy.position.set(
                    lerp(ox, tx, f) + Math.sin(i * 2.1) * 0.22,
                    lerp(oy, ty, f) - f * f * 0.35,
                    lerp(oz, tz, f) + Math.cos(i * 1.7) * 0.22
                );
                dummy.rotation.set(t * 2 + i, i * 0.8, 0);
                dummy.scale.setScalar(0.24);
                dummy.updateMatrix();
                coalInstanced.setMatrixAt(dumpStartIdx + i, dummy.matrix);
            }
        }
        coalInstanced.instanceMatrix.needsUpdate = true;

        // Fugitive dust plumes & pressurized desliming water spray curtains
        let dsIdx = 0;
        const emitSoft = (nodeId, ox, oy, oz, spread, riseH, baseS, isWater, count) => {
            const f = state.flowMap[nodeId];
            const active = (nodeId === "BN-101" && lp.dumping) || (f && f.running && f.rate > 0.04);
            for (let i = 0; i < count; i++) {
                if (!active) {
                    dummy.scale.set(0, 0, 0);
                    dummy.updateMatrix();
                    dustSprayInstanced.setMatrixAt(dsIdx++, dummy.matrix);
                    continue;
                }
                const age = (t * (isWater ? 1.55 : 0.42) + i / count) % 1.0;
                const ang = i * 2.39996 + t * (isWater ? 0.6 : 0.35);
                const rad = spread * (0.25 + age * 0.85);
                const py = isWater ? (oy - age * riseH + Math.sin(age * Math.PI) * 0.06) : (oy + age * riseH);
                const s = baseS * (isWater ? (0.45 + age * 0.65) : (0.55 + age * 1.45)) * Math.sin(age * Math.PI);
                dummy.position.set(ox + Math.cos(ang) * rad, py, oz + Math.sin(ang) * rad);
                dummy.rotation.set(0, ang, 0);
                dummy.scale.set(isWater ? s * 0.7 : s, isWater ? s * 1.35 : s * 0.72, isWater ? s * 0.7 : s);
                dummy.updateMatrix();
                dustSprayInstanced.setMatrixAt(dsIdx, dummy.matrix);
                tmpColor.setRGB(isWater ? 0.72 : 0.34, isWater ? 0.90 : 0.29, isWater ? 1.0 : 0.24);
                dustSprayInstanced.setColorAt(dsIdx++, tmpColor);
            }
        };
        emitSoft("BN-101", -13.8, 2.35, 8.8, 0.85, 1.85, 0.48, false, 10);
        emitSoft("JC-101", -13.8, 3.15, -0.6, 0.72, 1.95, 0.44, false, 10);
        emitSoft("DRC-101", -7.2, 2.85, -0.6, 0.68, 1.75, 0.42, false, 9);
        emitSoft("SS-101", 0.2, 3.30, 0.5, 0.95, 1.45, 0.40, false, 8);
        emitSoft("DS-201", 8.8, 2.75, -9.8, 0.78, 1.05, 0.22, true, 14);
        emitSoft("WP-301", -0.8, 3.25, -7.8, 0.75, 0.95, 0.20, true, 10);
        dustSprayInstanced.instanceMatrix.needsUpdate = true;
        if (dustSprayInstanced.instanceColor) dustSprayInstanced.instanceColor.needsUpdate = true;

        // Pipe flow spheres
        for (const ps of pipeFlowSpheres) {
            const eq = eqMap[ps.route.src];
            const spd = eq && (eq.status === "Stopped" || eq.status === "Fault") ? 0 : 0.30;
            ps.mesh.visible = spd > 0;
            if (ps.mesh.visible) {
                const pf = (t * spd + ps.offset) % 1.0;
                const pts = ps.route.pts.map(x => new THREE.Vector3(...x));
                ps.mesh.position.copy(samplePolyline(pts, pf));
            }
        }

        // Project 2D HTML labels
        if (state.showLabels) {
            const w = container.clientWidth, h = container.clientHeight;
            for (const n of ALL_NODES) {
                const lbl = labelElems[n.id];
                const pos = n.id === "FEL-101" ? [lp.x, lp.y, lp.z] : n.pos;
                projVec.set(pos[0], pos[1] + n.labelH, pos[2]).project(camera);
                if (projVec.z > 1 || projVec.z < -1) {
                    lbl.style.display = "none";
                } else {
                    lbl.style.display = "block";
                    lbl.style.left = `${(projVec.x * 0.5 + 0.5) * w}px`;
                    lbl.style.top = `${(-projVec.y * 0.5 + 0.5) * h}px`;
                    lbl.classList.toggle("selected", state.selectedId === n.id);
                }
            }
        }

        controls.update();
        renderer.render(scene, camera);
    }

    requestAnimationFrame(animate);
} catch (err) {
    startOfflineFallback(err?.message || err);
}
</script>
</body>
</html>
