function updateInspector() {
    const n = NODE_BY_ID[state.selectedId] || ALL_NODES[0];
    const eq = state.telemetry?.equipment?.[n.scada];
    const directFlow = state.flowMap[n.id];
    const flow = directFlow || state.flowMap[n.scada] || (n.parentId && state.flowMap[n.parentId]) || state.flowMap["WP-301"];
    const statusText = flow?.starved ? "Warning" : (eq?.status || "Running");
    const displayTph = directFlow ? directFlow.tph : (flow ? Math.round(n.nomTph * flow.rate * 10) / 10 : n.nomTph);
    const loadPct = eq ? Number(eq.loadPct) : 78.0;

    document.getElementById("insp-id").textContent = n.id;
    document.getElementById("insp-stage").textContent = n.stage;
    document.getElementById("insp-ga").textContent = n.ga;
    const stEl = document.getElementById("insp-status");
    stEl.textContent = flow?.starved ? "Starved" : statusText;
    stEl.className = "status-tag st-" + (statusText === "Offline" ? "Stopped" : statusText);

    document.getElementById("insp-load").textContent = `${loadPct.toFixed(1)}%`;
    document.getElementById("insp-tph").textContent = `${displayTph.toFixed(1)} t/h`;
    document.getElementById("insp-kw").textContent = eq ? `${eq.powerKw.toFixed(1)} kW` : "--";
    document.getElementById("insp-scada").textContent = n.scada;
    document.getElementById("insp-plc").textContent = n.plc;
    const isLive = !!state.telemetry?.isLive;
    const provEl = document.getElementById("insp-prov-note");
    provEl.textContent = `[READ-ONLY] [SITE CONFIRMED] · ${isLive ? "LIVE SCADA" : "SIMULATED DEMO"}`;
    provEl.style.color = isLive ? "var(--emerald)" : "var(--amber)";
    renderInspectorSparkline(n, loadPct);
    renderWebCircuitsAndHistorian();

    document.getElementById("insp-spec").textContent = n.spec;
    document.getElementById("insp-principle").textContent = n.principle;
    document.getElementById("insp-desc").textContent = n.desc;

    const topo = document.getElementById("insp-topology");
    topo.innerHTML = "";
    const addPill = (label, targetId, isCurrent = false) => {
        const el = document.createElement(targetId ? "button" : "span");
        if (targetId) el.type = "button";
        el.className = "node-pill" + (isCurrent ? " current" : "");
        el.textContent = label;
        if (targetId && !isCurrent) {
            el.addEventListener("click", () => selectNode(targetId, true));
        }
        topo.appendChild(el);
    };
    if (n.up.length === 0) addPill("ROM Source", null);
    else n.up.forEach(u => addPill(u, u));
    const arr1 = document.createElement("span"); arr1.textContent = "→"; arr1.style.color = "var(--text-muted)"; topo.appendChild(arr1);
    addPill(n.id, n.id, true);
    const arr2 = document.createElement("span"); arr2.textContent = "→"; arr2.style.color = "var(--text-muted)"; topo.appendChild(arr2);
    if (n.down.length === 0) addPill("Stockpile / Output", null);
    else n.down.forEach(d => addPill(d, d));
}

