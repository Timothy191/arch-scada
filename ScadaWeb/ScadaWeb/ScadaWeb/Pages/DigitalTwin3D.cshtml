async function pollTelemetry() {
    try {
        const resp = await fetch("/DigitalTwin3D?handler=Telemetry", { method: "GET", cache: "no-store" });
        if (!resp.ok) return;
        const data = await resp.json();
        state.telemetry = data;
        recordTrendSamples(data);

        const badge = document.getElementById("provenance-badge");
        badge.textContent = data.source || "SIMULATED DEMO TELEMETRY · READ-ONLY";
        badge.className = "badge " + (data.isLive ? "badge-live" : "badge-demo");

        if (data.plantTotals) {
            document.getElementById("kpi-rom").textContent = `${Number(data.plantTotals.romFeedTph).toFixed(1)} t/h`;
            document.getElementById("kpi-clean").textContent = `${Number(data.plantTotals.cleanProductTph).toFixed(1)} t/h`;
            document.getElementById("kpi-sg").textContent = Number(data.plantTotals.mediumSg).toFixed(2);
            document.getElementById("kpi-water").textContent = `${Number(data.plantTotals.waterRecoveryPct).toFixed(1)}%`;
            document.getElementById("kpi-ash").textContent = `${Number(data.plantTotals.ashPct).toFixed(2)}%`;
        }
        updateInspector();
    } catch {
        // Keep last known demo state if poll temporarily interrupted
    }
}

