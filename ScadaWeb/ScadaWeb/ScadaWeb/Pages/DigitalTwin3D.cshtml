    // All 62 sub-equipment: individually selectable highlight volumes + labels
    const subHighlights = {};
    for (const sn of SUB_EQUIPMENT_NODES) {
        const box = new THREE.Mesh(
            new THREE.BoxGeometry(sn.half[0] * 2 + 0.1, sn.half[1] * 2 + 0.1, sn.half[2] * 2 + 0.1),
