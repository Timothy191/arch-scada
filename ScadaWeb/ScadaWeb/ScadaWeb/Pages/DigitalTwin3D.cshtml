function renderWebCircuitsAndHistorian() {
    const drawer = document.getElementById("circuits-drawer");
    if (!drawer || drawer.style.display === "none") return;

    const presetSel = document.getElementById("web-hist-preset");
    const presetKey = presetSel?.value || "dmc";
    const preset = WEB_LOOP_PRESETS[presetKey] || WEB_LOOP_PRESETS.dmc;

    const legendEl = document.getElementById("web-hist-legend");
    if (legendEl) {
        legendEl.textContent = preset.ids.map(id => {
            const load = state.telemetry?.equipment?.[id]?.loadPct ?? 78.0;
            return `${id}: ${Number(load).toFixed(1)}%`;
        }).join("  ·  ");
    }

    const canvas = document.getElementById("web-historian-canvas");
    if (canvas) {
        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        const cssW = Math.max(320, Math.floor(canvas.clientWidth || 760));
        const cssH = 145;
        if (canvas.width !== Math.floor(cssW * dpr) || canvas.height !== Math.floor(cssH * dpr)) {
            canvas.width = Math.floor(cssW * dpr);
            canvas.height = Math.floor(cssH * dpr);
        }
        const ctx = canvas.getContext("2d");
        ctx.save();
        ctx.scale(dpr, dpr);
        const isDark = document.documentElement.getAttribute("data-theme") !== "light";
        ctx.fillStyle = isDark ? "#0b1220" : "#f8fafc";
        ctx.fillRect(0, 0, cssW, cssH);

        const padX = 10, padY = 10;
        const plotW = cssW - padX * 2, plotH = cssH - padY * 2;
        ctx.strokeStyle = isDark ? "rgba(148,163,184,0.14)" : "rgba(15,23,42,0.10)";
        ctx.lineWidth = 1;
        for (const pct of [25, 50, 75]) {
            const y = padY + plotH * (1 - pct / 100);
            ctx.beginPath(); ctx.moveTo(padX, y); ctx.lineTo(cssW - padX, y); ctx.stroke();
        }

        preset.ids.forEach((scadaId, idx) => {
            const cur = Number(state.telemetry?.equipment?.[scadaId]?.loadPct ?? (76 - idx * 4));
            const samples = getOrSeedTrend(scadaId, cur);
            if (samples.length < 2) return;
            const stepX = plotW / (samples.length - 1);
            ctx.beginPath();
            samples.forEach((v, i) => {
                const x = padX + i * stepX;
                const y = padY + plotH * (1 - Math.max(0, Math.min(100, v)) / 100);
                if (i === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
            });
            ctx.strokeStyle = preset.colors[idx % preset.colors.length];
            ctx.lineWidth = 2.0;
            ctx.stroke();
        });
        ctx.restore();
    }

    const grid = document.getElementById("web-circuits-grid");
    if (grid) {
        grid.innerHTML = "";
        for (const card of WEB_CIRCUIT_CARDS) {
            const eq = state.telemetry?.equipment?.[card.scada];
            const status = eq?.status || "Running";
            const load = Number(eq?.loadPct ?? 78.0).toFixed(1);
            const kw = eq ? `${Number(eq.powerKw).toFixed(1)} kW` : "--";
            const div = document.createElement("div");
            div.className = "insp-card";
            div.innerHTML = `
                <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:4px;">
                    <span style="font-size:10px;font-weight:700;color:var(--accent);">${card.circuit}</span>
                    <span class="status-tag st-${status === "Offline" ? "Stopped" : status}">${status}</span>
                </div>
                <div style="font-size:12px;font-weight:700;margin-bottom:6px;">${card.title}</div>
                <div style="display:flex;justify-content:space-between;align-items:center;font-size:11px;color:var(--text-secondary);">
                    <span>Load: <strong style="color:var(--text-primary);">${load}%</strong> · ${kw}</span>
                    <button type="button" class="node-pill" data-focus-node="${card.nodeId}">Locate in 3D ↗</button>
                </div>`;
            div.querySelector("button").addEventListener("click", () => {
                drawer.style.display = "none";
                document.getElementById("btn-circuits")?.classList.remove("active");
                selectNode(card.nodeId, true);
            });
            grid.appendChild(div);
        }
    }
}

function wireWebCircuitsDrawer() {
    const btn = document.getElementById("btn-circuits");
    const closeBtn = document.getElementById("btn-close-circuits");
    const presetSel = document.getElementById("web-hist-preset");
    const exportBtn = document.getElementById("btn-web-export-csv");
    const drawer = document.getElementById("circuits-drawer");
    if (!btn || !drawer) return;

    btn.addEventListener("click", () => {
        const open = drawer.style.display === "none";
        drawer.style.display = open ? "block" : "none";
        btn.classList.toggle("active", open);
        if (open) renderWebCircuitsAndHistorian();
    });
    closeBtn?.addEventListener("click", () => {
        drawer.style.display = "none";
        btn.classList.remove("active");
    });
    presetSel?.addEventListener("change", renderWebCircuitsAndHistorian);
    exportBtn?.addEventListener("click", () => {
        const presetKey = presetSel?.value || "dmc";
        const preset = WEB_LOOP_PRESETS[presetKey] || WEB_LOOP_PRESETS.dmc;
        const rows = ["SampleIndex," + preset.ids.join(",")];
        const maxLen = Math.max(...preset.ids.map(id => getOrSeedTrend(id, 75).length));
        for (let i = 0; i < maxLen; i++) {
            const vals = preset.ids.map(id => {
                const arr = getOrSeedTrend(id, 75);
                return (arr[i] ?? arr[arr.length - 1] ?? 0).toFixed(2);
            });
            rows.push(`${i},${vals.join(",")}`);
        }
        const blob = new Blob([rows.join("\n")], { type: "text/csv;charset=utf-8" });
        const url = URL.createObjectURL(blob);
        const a = document.createElement("a");
        a.href = url;
        a.download = `archscada_historian_${presetKey}.csv`;
        a.click();
        URL.revokeObjectURL(url);
    });
}
